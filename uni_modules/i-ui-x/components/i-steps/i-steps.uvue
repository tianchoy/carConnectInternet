<template>
  <view class="i-steps" :class="direction == 'column' ? 'i-steps--column' : ''">
    <view
      v-for="(item, index) in stepItems"
      :key="index.toString() + '-' + getItemTitle(item)"
      :class="direction == 'column' ? 'i-step i-step--column' : 'i-step'"
      @click="select(item, index)"
    >
      <view class="i-step__head">
        <view
          :class="index <= currentIndex ? 'i-step__dot i-step__dot--active' : 'i-step__dot'"
          :style="getDotStyle(index)"
        >
          <text v-if="showIndex" class="i-step__index">{{ index + 1 }}</text>
        </view>
        <view
          v-if="index < stepItems.length - 1"
          :class="direction == 'column' ? 'i-step__line i-step__line--column' : 'i-step__line'"
          :style="getLineStyle(index)"
        ></view>
      </view>
      <view :class="stepContentClass">
        <text
          :class="index <= currentIndex ? 'i-step__title i-step__title--active' : 'i-step__title'"
          :style="getTitleStyle(index)"
        >
          {{ getItemTitle(item) }}
        </text>
        <text v-if="getItemDesc(item).length > 0" class="i-step__desc">
          {{ getItemDesc(item) }}
        </text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref, watch } from 'vue'

defineOptions({ name: 'i-steps' })

const props = defineProps({
  value: { type: Number, default: 1 },
  current: { type: Number, default: -1 },
  items: {
    type: Array,
    default() {
      return ['提交', '审核', '完成']
    },
  },
  direction: { type: String, default: 'row' },
  activeColor: { type: String, default: '#2979ff' },
  inactiveColor: { type: String, default: '#dcdfe6' },
  showIndex: { type: Boolean, default: false },
  disabled: { type: Boolean, default: false },
})

const emit = defineEmits(['click', 'change', 'update:value'])

const stepItems = computed((): Array<any> => {
  if (props.items == null) return [] as Array<any>
  return props.items as Array<any>
})

const currentIndex = ref(props.current >= 0 ? props.current : props.value)

const stepContentClass = computed((): string => {
  return props.direction == 'column'
    ? 'i-step__content i-step__content--column'
    : 'i-step__content'
})

watch(
  (): number => props.value,
  (): void => {
    currentIndex.value = props.current >= 0 ? props.current : props.value
  },
)

watch(
  (): number => props.current,
  (): void => {
    currentIndex.value = props.current >= 0 ? props.current : props.value
  },
)

function valueText(value: any): string {
  if (typeof value == 'string') return value
  if (typeof value == 'number' || typeof value == 'boolean') return value.toString()
  return ''
}

function getValue(item: any, keyName: string): string {
  if (item == null || typeof item != 'object') return ''
  const values = item as UTSJSONObject
  return valueText(values[keyName] as any)
}

function getItemTitle(item: any): string {
  const title = getValue(item, 'title')
  if (title.length > 0) return title
  const name = getValue(item, 'name')
  if (name.length > 0) return name
  const text = getValue(item, 'text')
  if (text.length > 0) return text
  return valueText(item)
}

function getItemDesc(item: any): string {
  const desc = getValue(item, 'description')
  if (desc.length > 0) return desc
  return getValue(item, 'desc')
}

function getDotStyle(index: number): string {
  const color = index <= currentIndex.value ? props.activeColor : props.inactiveColor
  return 'background-color:' + color + ';'
}

function getLineStyle(index: number): string {
  const color = index < currentIndex.value ? props.activeColor : props.inactiveColor
  return 'background-color:' + color + ';'
}

function getTitleStyle(index: number): string {
  const color = index <= currentIndex.value ? props.activeColor : '#606266'
  return 'color:' + color + ';'
}

function select(item: any, index: number): void {
  const payload: UTSJSONObject = {
    index,
    item,
    title: getItemTitle(item),
  }
  emit('click', payload)
  if (props.disabled || currentIndex.value == index) return
  currentIndex.value = index
  emit('change', payload)
  emit('update:value', index)
}
</script>

<style>
.i-steps {
  padding: 14px;
  border-radius: 8px;
  background-color: #ffffff;
  flex-direction: row;
}

.i-steps--column {
  flex-direction: column;
}

.i-step {
  flex: 1;
  align-items: center;
}

.i-step--column {
  flex-direction: row;
  align-items: flex-start;
  min-height: 62px;
}

.i-step__head {
  position: relative;
  align-items: center;
}

.i-step__dot {
  width: 24px;
  height: 24px;
  border-radius: 12px;
  align-items: center;
  justify-content: center;
}

.i-step__dot--active {
  background-color: #2979ff;
}

.i-step__index {
  color: #ffffff;
  font-size: 12px;
  line-height: 16px;
}

.i-step__line {
  position: absolute;
  left: 24px;
  top: 11px;
  width: 64px;
  height: 2px;
  color: #c5c5c6;
}

.i-step__line--column {
  left: 11px;
  top: 24px;
  width: 2px;
  height: 36px;
}

.i-step__content {
  margin-top: 8px;
  align-items: center;
}

.i-step__content--column {
  flex: 1;
  margin-top: 0;
  margin-left: 10px;
  align-items: flex-start;
}

.i-step__title {
  color: #606266;
  font-size: 13px;
  line-height: 18px;
}

.i-step__title--active {
  color: #2979ff;
  font-weight: 600;
}

.i-step__desc {
  margin-top: 3px;
  color: #909399;
  font-size: 12px;
  line-height: 18px;
}
</style>
