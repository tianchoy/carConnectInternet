<template>
  <view>
    <view class="i-action-sheet__trigger" @click="open"><slot name="trigger"><slot></slot></slot></view>
    <view v-if="innerShow" class="i-action-sheet__mask" @click="handleOverlayClick"></view>
    <view v-if="innerShow" class="i-action-sheet__panel" :style="panelStyle">
      <view v-if="closeable" class="i-action-sheet__close" @click="closeByUser"><text class="i-action-sheet__close-text">×</text></view>
      <view v-if="title.length > 0 || description.length > 0" class="i-action-sheet__header">
        <text v-if="title.length > 0" class="i-action-sheet__title" :style="titleStyleText">{{ title }}</text>
        <text v-if="description.length > 0" class="i-action-sheet__desc">{{ description }}</text>
      </view>
      <scroll-view scroll-y="true" class="i-action-sheet__scroll">
        <button
          v-for="(item, index) in actionItems"
          :key="index.toString() + '-' + getActionText(item)"
          :class="getItemClass(item)"
          :disabled="isDisabled(item) || isLoading(item)"
          :open-type="getActionOpenType(item)"
          :app-parameter="appParameter"
          :lang="lang"
          :session-from="sessionFrom"
          :send-message-title="sendMessageTitle"
          :send-message-path="sendMessagePath"
          :send-message-img="sendMessageImg"
          :show-message-card="showMessageCard"
          @click="handleSelect(item, index)"
          @getuserinfo="handleOpenEvent('getuserinfo', $event)"
          @contact="handleOpenEvent('contact', $event)"
          @getphonenumber="handleOpenEvent('getphonenumber', $event)"
          @chooseavatar="handleOpenEvent('chooseavatar', $event)"
          @error="handleOpenEvent('error', $event)"
          @launchapp="handleOpenEvent('launchapp', $event)"
          @opensetting="handleOpenEvent('opensetting', $event)"
        >
          <view class="i-action-sheet__item-inner">
            <view class="i-action-sheet__main">
              <i-icon v-if="getActionIcon(item).length > 0" class="i-action-sheet__icon" :name="getActionIcon(item)" fontSize="17" :color="getItemColor(item)"></i-icon>
              <text class="i-action-sheet__item-text" :style="'color:' + getItemColor(item)">{{ getActionText(item) }}</text>
            </view>
            <text v-if="getSubname(item).length > 0" class="i-action-sheet__subname">{{ getSubname(item) }}</text>
            <text v-if="isLoading(item)" class="i-action-sheet__loading">加载中</text>
          </view>
        </button>
      </scroll-view>
      <view v-if="cancelText.length > 0" class="i-action-sheet__cancel" @click="closeByUser"><text class="i-action-sheet__cancel-text">{{ cancelText }}</text></view>
      <view v-if="props.safeBottom" class="i-action-sheet__safe-bottom"></view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref, watch } from 'vue'

defineOptions({ name: 'i-action-sheet' })

const props = defineProps({
  show: { type: Boolean, default: false },
  title: { type: String, default: '' },
  titleStyle: { type: [String, Object], default: '' },
  closeable: { type: Boolean, default: false },
  description: { type: String, default: '' },
  actions: { type: Array, default() { return [] } },
  cancelText: { type: String, default: '' },
  closeOnClickAction: { type: Boolean, default: true },
  safeBottom: { type: Boolean, default: true },
  openType: { type: String, default: '' },
  closeOnMask: { type: Boolean, default: true },
  height: { type: [String, Number], default: '' },
  round: { type: [String, Number], default: 10 },
  lang: { type: String, default: 'en' },
  sessionFrom: { type: String, default: '' },
  sendMessageTitle: { type: String, default: '' },
  sendMessagePath: { type: String, default: '' },
  sendMessageImg: { type: String, default: '' },
  showMessageCard: { type: Boolean, default: false },
  appParameter: { type: String, default: '' },
  customStyle: { type: [String, Object], default: '' },
})

const emit = defineEmits(['select', 'close', 'getuserinfo', 'contact', 'getphonenumber', 'chooseavatar', 'error', 'launchapp', 'opensetting', 'update:show'])

type ActionPayload = { index: number, item: any, name: string, value: string }

function formatSize(value: string | number): string {
  const text = value.toString()
  if (text.length == 0) return '0px'
  if (text.indexOf('vh') >= 0 || text.indexOf('vw') >= 0) {
    const parsed = parseFloat(text.replace('vh', '').replace('vw', ''))
    return (isNaN(parsed) ? 0 : Number.from(parsed)).toString() + 'px'
  }
  if (text.indexOf('px') >= 0 || text.indexOf('rpx') >= 0 || text.indexOf('%') >= 0) return text
  return text + 'px'
}

function itemValue(item: any, keyName: string): string {
  if (item == null) return ''
  // #ifdef APP-ANDROID
  if (typeof item == 'object') {
    return (item as UTSJSONObject).getString(keyName, '')
  }
  // #endif
  // #ifndef APP-ANDROID
  if (typeof item == 'object') {
    const value = item[keyName]
    return value == null ? '' : value.toString()
  }
  // #endif
  if (keyName == 'name' || keyName == 'value') return item.toString()
  return ''
}

function itemBoolean(item: any, keyName: string): boolean {
  if (item == null || typeof item != 'object') return false
  // #ifdef APP-ANDROID
  return (item as UTSJSONObject).getBoolean(keyName, false)
  // #endif
  // #ifndef APP-ANDROID
  const value = item[keyName]
  return value === true || value === 1 || value === '1' || value === 'true'
  // #endif
}

function getActionText(item: any): string { return itemValue(item, 'name') }
function getActionValue(item: any): string {
  const value = itemValue(item, 'value')
  return value.length > 0 ? value : getActionText(item)
}
function getSubname(item: any): string { return itemValue(item, 'subname') }
function getActionIcon(item: any): string { return itemValue(item, 'icon') }
function getActionColor(item: any): string {
  const color = itemValue(item, 'color')
  return color.length > 0 ? color : '#303133'
}
function isDisabled(item: any): boolean {
  return itemBoolean(item, 'disabled')
}
function isLoading(item: any): boolean {
  return itemBoolean(item, 'loading')
}
function getItemColor(item: any): string { return isDisabled(item) ? '#b8b8b8' : getActionColor(item) }
function getActionOpenType(item: any): string {
  const itemOpenType = itemValue(item, 'openType')
  return itemOpenType.length > 0 ? itemOpenType : props.openType
}
function getItemClass(item: any): string {
  if (isDisabled(item)) return 'i-action-sheet__item i-action-sheet__item--disabled'
  return isLoading(item) ? 'i-action-sheet__item i-action-sheet__item--loading' : 'i-action-sheet__item'
}
function buildPayload(item: any, index: number): ActionPayload {
  return { index, item, name: getActionText(item), value: getActionValue(item) }
}

const actionItems = computed((): Array<any> => {
  const actions = props.actions
  if (actions == null) return [] as Array<any>
  return actions as Array<any>
})

const innerShow = ref<boolean>(props.show)

function open(): void {
  if (innerShow.value) return
  innerShow.value = true
  emit('update:show', true)
}
function closeSilently(): void {
  if (!innerShow.value) return
  innerShow.value = false
  emit('update:show', false)
}
function closeByUser(): void {
  if (!innerShow.value) return
  innerShow.value = false
  emit('close')
  emit('update:show', false)
}
function handleOverlayClick(): void { if (props.closeOnMask) closeByUser() }
function handleSelect(item: any, index: number): void {
  if (isDisabled(item) || isLoading(item)) return
  emit('select', buildPayload(item, index))
  if (props.closeOnClickAction) closeSilently()
}
function handleOpenEvent(name: string, event: any): void { emit(name, event) }

const titleStyleText = computed<string>(() : string => typeof props.titleStyle == 'string' ? props.titleStyle as string : '')
const panelStyle = computed<string>(() : string => {
  let style = 'border-top-left-radius:' + formatSize(props.round) + ';border-top-right-radius:' + formatSize(props.round) + ';'
  if (props.height.toString().length > 0) style += 'height:' + formatSize(props.height) + ';'
  if (typeof props.customStyle == 'string') style += props.customStyle as string
  return style
})

watch(() : boolean => props.show, (value: boolean) : void => { innerShow.value = value })
defineExpose({ open, close: closeByUser })
</script>

<style>
.i-action-sheet__trigger { flex-direction: column; }
.i-action-sheet__mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 99; background-color: rgba(0, 0, 0, 0.45); }
.i-action-sheet__panel { position: fixed; left: 0; right: 0; bottom: 0; z-index: 100; background-color: #f7f7f7; overflow: hidden; }
.i-action-sheet__close { position: absolute; top: 10px; right: 12px; z-index: 2; width: 32px; height: 32px; border-radius: 16px; align-items: center; justify-content: center; }
.i-action-sheet__close-text { color: #909193; font-size: 24px; line-height: 28px; }
.i-action-sheet__header { min-height: 38px; padding: 8px 48px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #eeeeee; background-color: #ffffff; align-items: center; justify-content: center; }
.i-action-sheet__title { color: #909193; font-size: 14px; font-weight: 400; line-height: 20px; text-align: center; }
.i-action-sheet__desc { margin-top: 4px; color: #909193; font-size: 13px; line-height: 20px; text-align: center; }
.i-action-sheet__scroll { max-height: 320px; background-color: #ffffff; }
.i-action-sheet__item { min-height: 51px; padding: 0; margin: 0; border-radius: 0; background-color: #ffffff; border-top-width: 1px; border-top-style: solid; border-top-color: #f2f3f5; }
.i-action-sheet__item--disabled { background-color: #fafafa; opacity: 1; }
.i-action-sheet__item--loading { opacity: 0.72; }
.i-action-sheet__item-inner { min-height: 51px; padding: 8px 16px; align-items: center; justify-content: center; }
.i-action-sheet__main { flex-direction: row; align-items: center; justify-content: center; }
.i-action-sheet__icon { margin-right: 6px; }
.i-action-sheet__item-text { font-size: 15px; line-height: 22px; text-align: center; }
.i-action-sheet__subname { margin-top: 2px; color: #909193; font-size: 12px; line-height: 18px; text-align: center; }
.i-action-sheet__loading { margin-top: 2px; color: #909193; font-size: 12px; line-height: 18px; }
.i-action-sheet__cancel { min-height: 52px; margin-top: 8px; background-color: #ffffff; align-items: center; justify-content: center; }
.i-action-sheet__cancel-text { color: #303133; font-size: 16px; line-height: 22px; }
.i-action-sheet__safe-bottom { height: 12px; background-color: #ffffff; }
</style>
