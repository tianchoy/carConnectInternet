<template>
  <view class="i-signature" :style="rootStyle">
    <view
      :id="boardId"
      class="i-signature__board"
      :style="boardStyle"
      @touchstart.stop.prevent="handleTouchStart"
      @touchmove.stop.prevent="handleTouchMove"
      @touchend.stop="handleTouchEnd"
      @touchcancel.stop="handleTouchEnd"
      @click="handleClick"
    >
      <view
        v-for="(point, index) in points"
        :key="point + '-' + (index).toString()"
        class="i-signature__point"
        :style="pointStyle(point)"
      ></view>
      <text v-if="points.length == 0" class="i-signature__placeholder">
        在这里签名
      </text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue'

defineOptions({ name: 'i-signature' })

const boardId = 'i-signature-' + (Math.round(Math.random() * 1000000)).toString()

/**
 * Props 说明：依据 DCloud uni-app x signature board 签名板。
 * - width: 签名板宽度，支持任意 CSS 单位；默认 100%。
 * - height: 签名板高度，支持任意 CSS 单位；默认 150px。
 * - bgColor: 签名板背景颜色；默认透明。
 * - strokeColor: 画笔颜色；支持 primary/success/warning/error/info 或具体颜色值。
 * - strokeWidth: 画笔粗细，单位 px；数值越大笔迹越粗。
 */
const props = defineProps({
  width: { type: String, default: '100%' },
  height: { type: String, default: '150' },
  bgColor: { type: String, default: 'rgba(0,0,0,0)' },
  strokeColor: { type: String, default: 'primary' },
  strokeWidth: { type: Number, default: 8 },
})

/**
 * Emits 说明：组件向外派发签名状态。
 * - change: 笔迹变化时触发，返回当前笔画数量。
 * - clear: 调用 clear 或点击清除后触发。
 * - confirm: 兼容旧版签名确认事件，返回 getImage 同结构数据。
 */
const emit = defineEmits<{
  (event: 'change', value: number): void
  (event: 'clear'): void
  (event: 'confirm', value: UTSJSONObject): void
}>()

function formatSize(value : any) : string {
  const text = value.toString()
  if (text.indexOf('px') >= 0 || text.indexOf('rpx') >= 0 || text.indexOf('%') >= 0) {
    return text
  }
  return text + 'px'
}

function normalizeColor(value : any) : string {
  if (value == 'primary') return '#2979ff'
  if (value == 'success') return '#19be6b'
  if (value == 'warning') return '#ff9900'
  if (value == 'error') return '#fa3534'
  if (value == 'info') return '#909399'
  return value.toString()
}

const signatureBgColor = computed(() : string => {
  return props.bgColor
})
const points = ref<string[]>([])
const lineCount = ref(0)
const drawing = ref(false)
const lastPoint = ref('')
const suppressClick = ref(false)
const rectLeft = ref(0)
const rectTop = ref(0)
const rectWidth = ref(0)
const rectHeight = ref(0)

function numericSize(value : any) : number {
  const text = value.toString()
  const numberValue = parseFloat(text.replace('px', '').replace('rpx', '').replace('%', '').toString())
  if (isNaN(numberValue)) return 0
  return numberValue
}

function usableWidth() : number {
  if (rectWidth.value > 0) return Math.round(rectWidth.value)
  const value = numericSize(props.width)
  if (value > 0 && props.width.indexOf('%') < 0) return Math.round(value)
  return 320
}

function usableHeight() : number {
  if (rectHeight.value > 0) return Math.round(rectHeight.value)
  const value = numericSize(props.height)
  if (value > 0) return Math.round(value)
  return 150
}

function buildPoint(x : any, y : any) : string {
  return Math.round(parseFloat(x.toString())).toString() + ',' + Math.round(parseFloat(y.toString())).toString()
}

function pointX(point : any) : number {
  return parseFloat(point.toString().split(',')[0].toString())
}

function pointY(point : any) : number {
  return parseFloat(point.toString().split(',')[1].toString())
}

function clamp(value : number, min : number, max : number) : number {
  if (value < min) return min
  if (value > max) return max
  return value
}

function readPointValue(point : any, keyName : string) : number {
  if (point == null) return NaN
  const value = (point as UTSJSONObject)[keyName]
  if (value == null) return NaN
  return parseFloat(value.toString())
}

function isLocalPoint(x : number, y : number, width : number, height : number) : boolean {
  if (isNaN(x) || isNaN(y)) return false
  return x >= 0 && y >= 0 && x <= width && y <= height
}

function isAbsolutePoint(x : number, y : number) : boolean {
  if (isNaN(x) || isNaN(y)) return false
  return x >= 0 && y >= 0
}

function hasUsableRect(rect : Array<number>) : boolean {
  if (isNaN(rect[0]) || isNaN(rect[1])) return false
  return rect[2] > 0 && rect[3] > 0
}

function normalizeRectPoint(first : any | null, fallback : any | null) : number {
  if (first != null) {
    const firstValue = parseFloat(first.toString())
    if (!isNaN(firstValue)) return firstValue
  }
  if (fallback != null) {
    const fallbackValue = parseFloat(fallback.toString())
    if (!isNaN(fallbackValue)) return fallbackValue
  }
  return 0
}

function setBoardRect(rect : any | null) : void {
  if (rect == null) return
  const object = rect as UTSJSONObject
  rectLeft.value = normalizeRectPoint(object['left'], object['x'])
  rectTop.value = normalizeRectPoint(object['top'], object['y'])
  const width = object['width']
  const height = object['height']
  rectWidth.value = width == null ? 0 : parseFloat(width.toString())
  rectHeight.value = height == null ? 0 : parseFloat(height.toString())
}

function getBoardRect() : Array<number> {
  return [rectLeft.value, rectTop.value, rectWidth.value, rectHeight.value]
}

function addInterpolatedPoints(nextX : number, nextY : number) : void {
  const prevX = pointX(lastPoint.value)
  const prevY = pointY(lastPoint.value)
  const dx = nextX - prevX
  const dy = nextY - prevY
  const distance = Math.sqrt(dx * dx + dy * dy)
  const step = Math.max(2, props.strokeWidth / 2)
  const count = Math.floor(distance / step)
  for (let i = 1; i < count; i++) {
    const ratio = i / count
    points.value.push(buildPoint(prevX + dx * ratio, prevY + dy * ratio))
  }
}

const rootStyle = computed(() : string => {
  return 'width:' + formatSize(props.width) + ';'
})

const boardStyle = computed(() : string => {
  return (
    'height:' +
    formatSize(props.height) +
    ';background-color:' +
    normalizeColor(signatureBgColor.value) +
    ';'
  )
})

function addPoint(x : any, y : any, isStart : any) {
  const boardWidth = usableWidth()
  const boardHeight = usableHeight()
  const nextX = clamp(parseFloat((x).toString()), 0, boardWidth)
  const nextY = clamp(parseFloat((y).toString()), 0, boardHeight)
  if (!isStart && lastPoint.value.length > 0) {
    addInterpolatedPoints(nextX, nextY)
  }
  const point = buildPoint(nextX, nextY)
  points.value.push(point)
  lastPoint.value = point
  emit('change', lineCount.value)
}

function firstTouch(event : UniTouchEvent) : any | null {
  if (event.touches.length > 0) return event.touches[0]
  if (event.changedTouches.length > 0) return event.changedTouches[0]
  return null
}

function localPoint(point : any) : string {
  const rect = getBoardRect()
  let width : number = rect[2]
  let height : number = rect[3]
  if (width <= 0) width = usableWidth()
  if (height <= 0) height = usableHeight()
  let x = readPointValue(point, 'offsetX')
  let y = readPointValue(point, 'offsetY')
  if (isLocalPoint(x, y, width, height)) return buildPoint(x, y)

  x = readPointValue(point, 'x')
  y = readPointValue(point, 'y')
  if (isLocalPoint(x, y, width, height)) return buildPoint(x, y)

  if (!hasUsableRect(rect)) return ''

  x = readPointValue(point, 'clientX')
  y = readPointValue(point, 'clientY')
  if (isAbsolutePoint(x, y)) return buildPoint(x - rect[0], y - rect[1])

  x = readPointValue(point, 'pageX')
  y = readPointValue(point, 'pageY')
  if (isAbsolutePoint(x, y)) return buildPoint(x - rect[0], y - rect[1])

  x = readPointValue(point, 'x')
  y = readPointValue(point, 'y')
  if (isAbsolutePoint(x, y)) return buildPoint(x - rect[0], y - rect[1])
  return ''
}

function refreshBoardRect() : void {
  uni
    .createSelectorQuery()
    .select('#' + boardId)
    .boundingClientRect((rect : any | null) : void => {
      setBoardRect(rect)
    })
    .exec()
}

function clear() {
  points.value = []
  lineCount.value = 0
  drawing.value = false
  lastPoint.value = ''
  emit('clear')
  emit('change', 0)
}

function resize() {
  rectWidth.value = 0
  rectHeight.value = 0
  refreshBoardRect()
}

function getLineCount(): number {
  return lineCount.value
}

function escapeSvg(value : any) : string {
  return value.toString().replace('&', '&amp;').replace('"', '&quot;').replace('<', '&lt;')
}

function buildSvgDataUrl() : string {
  const width = usableWidth()
  const height = usableHeight()
  let svg =
    '<svg xmlns="http://www.w3.org/2000/svg" width="' +
    width.toString() +
    '" height="' +
    height.toString() +
    '" viewBox="0 0 ' +
    width.toString() +
    ' ' +
    height.toString() +
    '">'
  const bg = normalizeColor(signatureBgColor.value)
  if (bg.length > 0 && bg != 'rgba(0,0,0,0)' && bg != 'transparent') {
    svg = svg + '<rect width="100%" height="100%" fill="' + escapeSvg(bg) + '"/>'
  }
  const color = escapeSvg(normalizeColor(props.strokeColor))
  const radius = Math.max(1, props.strokeWidth / 2)
  for (let i = 0; i < points.value.length; i++) {
    const point = points.value[i]
    svg =
      svg +
      '<circle cx="' +
      pointX(point).toString() +
      '" cy="' +
      pointY(point).toString() +
      '" r="' +
      radius.toString() +
      '" fill="' +
      color +
      '"/>'
  }
  svg = svg + '</svg>'
  return 'data:image/svg+xml;utf8,' + encodeURIComponent(svg)
}

function buildImagePayload(src : string) : UTSJSONObject {
  return {
    src,
    width: usableWidth(),
    height: usableHeight(),
    error: '',
  }
}

function getImage() {
  const payload = buildImagePayload('')
  if (points.value.length == 0) {
    payload.error = 'empty'
    return Promise.resolve(payload)
  }
  payload.src = buildSvgDataUrl()
  return Promise.resolve(payload)
}

function confirm() {
  const payload = buildImagePayload(points.value.length == 0 ? '' : buildSvgDataUrl())
  if (points.value.length == 0) payload.error = 'empty'
  emit('confirm', payload)
  return payload
}

function pointStyle(point : any): string {
  const size = Math.max(2, parseFloat((props.strokeWidth).toString()))
  const radius = size / 2
  return (
    'width:' +
    (size).toString() +
    'px;height:' +
    (size).toString() +
    'px;left:' +
    (pointX(point) - radius).toString() +
    'px;top:' +
    (pointY(point) - radius).toString() +
    'px;background-color:' +
    normalizeColor(props.strokeColor) +
    ';'
  )
}

function handleTouchStart(event : UniTouchEvent) : void {
  const touch = firstTouch(event)
  if (touch == null) return
  suppressClick.value = true
  refreshBoardRect()
  const point = localPoint(touch)
  drawing.value = true
  lineCount.value = lineCount.value + 1
  lastPoint.value = ''
  if (point.length == 0) return
  addPoint(pointX(point), pointY(point), true)
}

function handleTouchMove(event : UniTouchEvent) : void {
  if (!drawing.value) return
  const touch = firstTouch(event)
  if (touch == null) return
  const point = localPoint(touch)
  if (point.length == 0) return
  addPoint(pointX(point), pointY(point), lastPoint.value.length == 0)
}

function handleTouchEnd() : void {
  drawing.value = false
  lastPoint.value = ''
}

function handleClick(event : any) : void {
  if (suppressClick.value) {
    suppressClick.value = false
    return
  }
  refreshBoardRect()
  const point = localPoint(event)
  if (point.length == 0) return
  lineCount.value = lineCount.value + 1
  addPoint(pointX(point), pointY(point), true)
  lastPoint.value = ''
}

defineExpose({
  clear,
  resize,
  getLineCount,
  getImage,
  confirm,
})
</script>

<style>
.i-signature {
  overflow: hidden;
  border-radius: 10px;
}

.i-signature__board {
  position: relative;
  overflow: hidden;
  border-width: 1px;
  border-style: solid;
  border-color: #e5e7eb;
  border-radius: 10px;
}

.i-signature__point {
  position: absolute;
  border-radius: 999px;
}

.i-signature__placeholder {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  color: #c0c4cc;
  font-size: 14px;
  line-height: 22px;
  text-align: center;
  transform: translateY(-50%);
}
</style>
