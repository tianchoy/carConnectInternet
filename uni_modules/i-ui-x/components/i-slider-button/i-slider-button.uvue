<template>
  <view
    :id="buttonId"
    class="i-slider-button"
    :style="wrapStyle"
    @touchstart.stop.prevent="handleTouchStart"
    @touchmove.stop.prevent="handleTouchMove"
    @touchend.stop.prevent="handleTouchEnd"
    @touchcancel.stop.prevent="handleTouchEnd"
  >
    <view class="i-slider-button__rail" :style="railStyle"></view>
    <text class="i-slider-button__text" :style="textStyle">
      <slot>{{ currentText }}</slot>
    </text>
    <view class="i-slider-button__thumb" :style="thumbStyle">
      <slot name="thumb">
        <text class="i-slider-button__thumb-text" :style="thumbIconStyle">›</text>
      </slot>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref, watch } from 'vue'

defineOptions({ name: 'i-slider-button' })

/**
 * Props 说明：依据 DCloud uni-app x 官方规范 SliderButton，用于滑动验证/确认。
 * - text: 未完成时按钮文字。
 * - width/height: 按钮宽高。
 * - round: 外层圆角。
 * - bgColor: 背景颜色。
 * - railIndex: 滑道层级，保留 API。
 * - railColor/railRadius: 滑过区域颜色和圆角。
 * - textColor/activeTextColor/fontSize/textBold: 文案样式。
 * - disabled: 是否禁用。
 * - successText: 成功后的文字。
 * - autoReset/resetDelay: 成功后是否自动重置和延迟。
 * - threshold: 成功阈值，0-1。
 * - value/modelValue: 是否已成功，兼容旧版 doneText/value。
 */
const props = defineProps({
  text: {
    type: String,
    default: '滑动解锁',
  },
  width: {
    type: [String, Number],
    default: '100%',
  },
  height: {
    type: [String, Number],
    default: 45,
  },
  round: {
    type: [String, Number],
    default: 100,
  },
  bgColor: {
    type: String,
    default: '#e0e0e0',
  },
  railIndex: {
    type: [String, Number],
    default: 1,
  },
  railColor: {
    type: String,
    default: '#2979ff',
  },
  railRadius: {
    type: [String, Number],
    default: 100,
  },
  textColor: {
    type: String,
    default: '#c2c2c2',
  },
  activeTextColor: {
    type: String,
    default: '#ffffff',
  },
  fontSize: {
    type: [String, Number],
    default: 16,
  },
  textBold: {
    type: Boolean,
    default: false,
  },
  disabled: {
    type: Boolean,
    default: false,
  },
  successText: {
    type: String,
    default: '验证成功',
  },
  doneText: {
    type: String,
    default: '',
  },
  autoReset: {
    type: Boolean,
    default: false,
  },
  resetDelay: {
    type: Number,
    default: 2000,
  },
  threshold: {
    type: Number,
    default: 0.5,
  },
  modelValue: {
    type: Boolean,
    default: false,
  },
  value: {
    type: Boolean,
    default: false,
  },
})

/**
 * Emits 说明：滑动过程、成功和重置。
 * - change: 滑动过程中触发，参数为 0-1 的进度。
 * - success: 滑动超过阈值时触发。
 * - reset: 重置滑动按钮时触发。
 * - update:modelValue/update:value: 同步成功状态。
 */
const emit = defineEmits<{
  (event: 'change', value: number): void
  (event: 'success'): void
  (event: 'reset'): void
  (event: 'update:modelValue', value: boolean): void
  (event: 'update:value', value: boolean): void
  (event: 'confirm'): void
}>()

function formatSize(value : any) : string {
  const text = value.toString()
  if (text.indexOf('px') >= 0 || text.indexOf('rpx') >= 0 || text.indexOf('%') >= 0) return text
  return text + 'px'
}

function numericSize(value : any, fallback : number) : number {
  const text = value.toString()
  const numberValue = parseFloat(text.replace('px', '').replace('rpx', '').replace('%', '').toString())
  if (isNaN(numberValue)) return fallback
  return numberValue
}

const bgColor = computed(() : string => {
  return props.bgColor
})
const successed = ref(props.modelValue || props.value)
const progress = ref(successed.value ? 1 : 0)
const buttonId = 'i-slider-button-' + (Math.floor(Math.random() * 1000000)).toString()
const buttonRectLeft = ref(0)
const buttonRectWidth = ref(0)
const touching = ref(false)

function readTouchX(event : UniTouchEvent) : number {
  let point : any | null = null
  if (event.touches.length > 0) point = event.touches[0]
  else if (event.changedTouches.length > 0) point = event.changedTouches[0]
  if (point == null) return NaN
  const object = point as UTSJSONObject
  const clientX = object['clientX']
  if (clientX != null) {
    const value = parseFloat(clientX.toString())
    if (!isNaN(value)) return value
  }
  const pageX = object['pageX']
  if (pageX != null) {
    const value = parseFloat(pageX.toString())
    if (!isNaN(value)) return value
  }
  const x = object['x']
  return x == null ? NaN : parseFloat(x.toString())
}

function updateProgressByTouch(event : UniTouchEvent) : void {
  const x = readTouchX(event)
  if (isNaN(x) || buttonRectWidth.value <= 0) return
  let nextProgress = (x - buttonRectLeft.value) / buttonRectWidth.value
  if (nextProgress < 0) nextProgress = 0
  if (nextProgress > 1) nextProgress = 1
  progress.value = nextProgress
  emit('change', progress.value)
}

function setButtonRect(rect : any | null) : void {
  if (rect == null || typeof rect != 'object') return
  const object = rect as UTSJSONObject
  const left = object['left']
  const x = object['x']
  const leftValue = left == null ? NaN : parseFloat(left.toString())
  const xValue = x == null ? 0 : parseFloat(x.toString())
  buttonRectLeft.value = isNaN(leftValue) ? xValue : leftValue
  const width = object['width']
  buttonRectWidth.value = width == null ? 0 : parseFloat(width.toString())
}

function refreshButtonRect(event : UniTouchEvent, shouldUpdate : boolean) : void {
  uni
    .createSelectorQuery()
    .select('#' + buttonId)
    .boundingClientRect((rect : any | null) : void => {
      setButtonRect(rect)
      if (shouldUpdate) updateProgressByTouch(event)
    })
    .exec()
}

function reset() : void {
  successed.value = false
  progress.value = 0
  emit('reset')
  emit('update:modelValue', false)
  emit('update:value', false)
}

function markSuccess() : void {
  successed.value = true
  progress.value = 1
  emit('success')
  emit('confirm')
  emit('update:modelValue', true)
  emit('update:value', true)
  if (props.autoReset) {
    setTimeout(() : void => {
      reset()
    }, props.resetDelay)
  }
}

const wrapStyle = computed(() : string => {
  return (
    'width:' +
    formatSize(props.width) +
    ';height:' +
    formatSize(props.height) +
    ';border-radius:' +
    formatSize(props.round) +
    ';background-color:' +
    bgColor.value +
    ';'
  )
})

const railStyle = computed(() : string => {
  const thumbSize = numericSize(props.height, 45) - 8
  const percent = progress.value * 100
  const followOffset = thumbSize * (1 - progress.value)
  const width =
    progress.value <= 0
      ? '0%'
      : 'calc(' + (percent).toString() + '% + ' + formatSize(followOffset) + ')'
  return (
    'width:' +
    width +
    ';height:' +
    formatSize(props.height) +
    ';border-radius:' +
    formatSize(props.railRadius) +
    ';background-color:' +
    props.railColor +
    ';z-index:' +
    (props.railIndex).toString() +
    ';'
  )
})

const textStyle = computed(() : string => {
  return (
    'color:' +
    (successed.value ? props.activeTextColor : props.textColor) +
    ';font-size:' +
    formatSize(props.fontSize) +
    ';font-weight:' +
    (props.textBold ? '700' : '400') +
    ';line-height:' +
    formatSize(props.height) +
    ';'
  )
})

const currentText = computed(() : string => {
  if (!successed.value) return props.text
  return props.doneText.length > 0 ? props.doneText : props.successText
})

const thumbStyle = computed(() : string => {
  const size = numericSize(props.height, 45) - 8
  const offset = progress.value * 100
  const marginLeft = 0 - size * progress.value
  return (
    'width:' +
    formatSize(size) +
    ';height:' +
    formatSize(size) +
    ';border-radius:' +
    formatSize(size) +
    ';top:4px;left:' +
    (offset).toString() +
    '%;margin-left:' +
    formatSize(marginLeft) +
    ';'
  )
})

const thumbIconStyle = computed(() : string => {
  return (
    'color:' +
    props.railColor +
    ';font-size:' +
    formatSize(18) +
    ';line-height:' +
    formatSize(22) +
    ';'
  )
})

watch(
  () : boolean => props.modelValue,
  () : void => {
    successed.value = props.modelValue
    progress.value = successed.value ? 1 : 0
  },
)

watch(
  () : boolean => props.value,
  () : void => {
    successed.value = props.value
    progress.value = successed.value ? 1 : 0
  },
)

function handleTouchStart(event : UniTouchEvent) : void {
  if (props.disabled || successed.value) return
  touching.value = true
  refreshButtonRect(event, true)
}

function handleTouchMove(event : UniTouchEvent) : void {
  if (props.disabled || successed.value || !touching.value) return
  updateProgressByTouch(event)
}

function handleTouchEnd(event : UniTouchEvent) : void {
  if (!touching.value) return
  updateProgressByTouch(event)
  touching.value = false
  if (progress.value >= props.threshold) {
    markSuccess()
  } else {
    reset()
  }
}

defineExpose({ reset })
</script>

<style>
.i-slider-button {
  position: relative;
  overflow: hidden;
  justify-content: center;
  box-shadow: inset 0 0 0 1px rgba(31, 45, 61, 0.04);
}

.i-slider-button__rail {
  position: absolute;
  left: 0;
  top: 0;
}

.i-slider-button__text {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 3;
  text-align: center;
}

.i-slider-button__thumb {
  position: absolute;
  z-index: 4;
  background-color: #ffffff;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(31, 45, 61, 0.16);
}

.i-slider-button__thumb-text {
  color: #2979ff;
  font-size: 18px;
  line-height: 22px;
}
</style>
