<template>
  <view class="i-color-picker">
    <view class="i-color-picker__tabs">
      <view
        :class="
          activeMode == 'rgb'
            ? 'i-color-picker__tab i-color-picker__tab--active'
            : 'i-color-picker__tab'
        "
        @click="setActiveMode('rgb')"
      >
        <text
          :class="
            activeMode == 'rgb'
              ? 'i-color-picker__tab-text i-color-picker__tab-text--active'
              : 'i-color-picker__tab-text'
          "
          >RGB</text
        >
      </view>
      <view
        :class="
          activeMode == 'spectrum'
            ? 'i-color-picker__tab i-color-picker__tab--active'
            : 'i-color-picker__tab'
        "
        @click="setActiveMode('spectrum')"
      >
        <text
          :class="
            activeMode == 'spectrum'
              ? 'i-color-picker__tab-text i-color-picker__tab-text--active'
              : 'i-color-picker__tab-text'
          "
          >光谱</text
        >
      </view>
      <view
        :class="
          activeMode == 'card'
            ? 'i-color-picker__tab i-color-picker__tab--active'
            : 'i-color-picker__tab'
        "
        @click="setActiveMode('card')"
      >
        <text
          :class="
            activeMode == 'card'
              ? 'i-color-picker__tab-text i-color-picker__tab-text--active'
              : 'i-color-picker__tab-text'
          "
          >色卡</text
        >
      </view>
    </view>

    <view v-if="activeMode == 'rgb'" class="i-color-picker__rgb">
      <view class="i-color-picker__rgb-row">
        <text class="i-color-picker__rgb-label i-color-picker__rgb-label--red"
          >R</text
        >
        <slider
          class="i-color-picker__rgb-slider"
          :value="redValue"
          :min="0"
          :max="255"
          :step="1"
          :disabled="disabled"
          activeColor="#ff4d4f"
          backgroundColor="#eef0f4"
          @changing="handleRedChanging"
          @change="handleRedChange"
        />
        <text class="i-color-picker__rgb-value">{{ redValue }}</text>
      </view>
      <view class="i-color-picker__rgb-row">
        <text
          class="i-color-picker__rgb-label i-color-picker__rgb-label--green"
          >G</text
        >
        <slider
          class="i-color-picker__rgb-slider"
          :value="greenValue"
          :min="0"
          :max="255"
          :step="1"
          :disabled="disabled"
          activeColor="#19be6b"
          backgroundColor="#eef0f4"
          @changing="handleGreenChanging"
          @change="handleGreenChange"
        />
        <text class="i-color-picker__rgb-value">{{ greenValue }}</text>
      </view>
      <view class="i-color-picker__rgb-row">
        <text
          class="i-color-picker__rgb-label i-color-picker__rgb-label--blue"
          >B</text
        >
        <slider
          class="i-color-picker__rgb-slider"
          :value="blueValue"
          :min="0"
          :max="255"
          :step="1"
          :disabled="disabled"
          activeColor="#2979ff"
          backgroundColor="#eef0f4"
          @changing="handleBlueChanging"
          @change="handleBlueChange"
        />
        <text class="i-color-picker__rgb-value">{{ blueValue }}</text>
      </view>
    </view>

    <view v-if="activeMode == 'spectrum'" class="i-color-picker__spectrum">
      <view :id="panelId" class="i-color-picker__panel" :style="panelStyle">
        <view class="i-color-picker__panel-grid">
          <view
            v-for="row in panelRows"
            :key="row"
            class="i-color-picker__panel-row"
            :style="panelRowStyle"
          >
            <view
              v-for="column in panelColumns"
              :key="column"
              class="i-color-picker__panel-cell"
              :style="getPanelCellStyle(row, column)"
            ></view>
          </view>
        </view>
        <view
          class="i-color-picker__panel-touch"
          @touchstart.stop.prevent="handlePanelTouchStart"
          @touchmove.stop.prevent="handlePanelTouchMove"
          @touchend="handlePanelTouchEnd"
          @click="handlePanelClick"
        ></view>
        <view class="i-color-picker__indicator" :style="indicatorStyle"></view>
      </view>
    </view>

    <view v-if="activeMode == 'card'" class="i-color-picker__card">
      <view class="i-color-picker__card-grid">
        <view
          v-for="row in cardRows"
          :key="row"
          class="i-color-picker__card-row"
        >
          <view
            v-for="column in cardColumns"
            :key="column"
            :class="
              isCardCellActive(row, column)
                ? 'i-color-picker__card-cell i-color-picker__card-cell--active'
                : 'i-color-picker__card-cell'
            "
            :style="'background-color:' + getCardColor(row, column)"
            @click="selectCardCell(row, column)"
          >
            <view
              v-if="isCardCellActive(row, column)"
              class="i-color-picker__card-check"
            ></view>
          </view>
        </view>
      </view>
    </view>

    <view
      v-if="showAlpha"
      class="i-color-picker__track i-color-picker__track--alpha"
    >
      <view class="i-color-picker__alpha-checker"></view>
      <view class="i-color-picker__alpha-bg" :style="alphaTrackStyle"></view>
      <slider
        class="i-color-picker__slider"
        :value="alphaPercent"
        :min="0"
        :max="100"
        :step="1"
        :disabled="disabled"
        activeColor="rgba(255,255,255,0)"
        backgroundColor="rgba(255,255,255,0)"
        @changing="handleAlphaChanging"
        @change="handleAlphaChange"
      />
    </view>

    <view v-if="showInput" class="i-color-picker__input-row">
      <view class="i-color-picker__mode">
        <text class="i-color-picker__mode-text">{{ modeText }}</text>
      </view>
      <input
        class="i-color-picker__input"
        :value="hexInput"
        :disabled="disabled"
        @input="handleHexInput"
        @confirm="commitHexInput"
      />
      <view class="i-color-picker__preview" :style="previewStyle"></view>
    </view>

    <view
      v-if="showRecommend"
      :class="
        activeMode == 'card'
          ? 'i-color-picker__recommend i-color-picker__recommend--card'
          : 'i-color-picker__recommend'
      "
    >
      <text class="i-color-picker__label">推荐颜色</text>
      <scroll-view class="i-color-picker__swatches-scroll" scroll-x="true">
        <view class="i-color-picker__swatches">
          <view
            v-for="row in recommendRowList"
            :key="row.key"
            class="i-color-picker__swatch-row"
          >
            <view
              v-for="item in row.colors"
              :key="item.value"
              :class="
                normalizeToHex(item.value) == currentHex
                  ? 'i-color-picker__swatch i-color-picker__swatch--active'
                  : 'i-color-picker__swatch'
              "
              :style="'background-color:' + item.value"
              @click="selectColor(item.value)"
            ></view>
          </view>
        </view>
      </scroll-view>
    </view>

    <text v-if="showCurrent" class="i-color-picker__current"
      >当前颜色: {{ outputValue }}</text
    >
  </view>
</template>

<script setup lang="uts">
import { ref, computed, watch } from 'vue'

defineOptions({ name: 'i-color-picker' })

/**
 * Props 说明：用于控制颜色选择器的初始颜色、输入区、透明度、推荐色和禁用状态。
 * - value: 当前选中的颜色值；支持 #RRGGBB、#RGB，也兼容 primary/success/warning/danger/info 语义色。
 * - colors: 推荐颜色列表；可传字符串数组，也可传包含 value 字段的对象数组。
 * - mode: 输入区展示模式，当前支持 HEX，保留该参数便于后续扩展 RGB/HSB。
 * - selectMode: 选择器交互模式枚举；rgb 表示 RGB 滑条，spectrum 表示二维光谱色板，card 表示色卡矩阵。
 * - alpha: 透明度，取值 0 - 1；showAlpha 为 true 时会参与输出 rgba 文本。
 * - showAlpha: 是否显示透明度滑条。
 * - showInput: 是否显示 HEX 输入框和右侧颜色预览。
 * - showRecommend: 是否显示推荐颜色色块；推荐色来自 colors 参数，未传时使用组件默认推荐色。
 * - showCurrent: 是否显示“当前颜色”文本。
 * - disabled: 是否禁用选择、输入和滑动交互。
 * - panelHeight: 上方二维色板高度，支持数字或带单位字符串。
 */
const props = defineProps({
  value: { type: String, default: '#2979ff' },
  colors: {
    type: Array,
    default() {
      return []
    },
  },
  mode: { type: String, default: 'HEX' },
  selectMode: { type: String, default: 'spectrum' },
  alpha: { type: Number, default: 1 },
  showAlpha: { type: Boolean, default: true },
  showInput: { type: Boolean, default: true },
  showRecommend: { type: Boolean, default: true },
  showCurrent: { type: Boolean, default: true },
  disabled: { type: Boolean, default: false },
  panelHeight: { type: [String, Number], default: 260 },
})

/**
 * Emits 说明：向页面同步颜色选择结果。
 * - change: 颜色变化时触发；参数为当前输出颜色，showAlpha 时可能是 rgba(...)。
 * - input: 用户输入或拖动过程中触发；参数为当前输出颜色。
 * - update:value: 同步 value 受控值，便于外部双向绑定。
 * - update:modelValue: 同步 modelValue，兼容 v-model。
 * - mode-change: 切换选择模式时触发；参数为 rgb、spectrum 或 card。
 */
const emit = defineEmits(['change', 'input', 'update:value', 'update:modelValue', 'mode-change'])

type IParsedColor = {
  hex: string
  alpha: number
}

type IRecommendedColor = {
  value: string
}

type IRecommendedRow = {
  key: string
  colors: Array<IRecommendedColor>
}

function clamp(value : number, min : number, max : number) : number {
  return Math.max(min, Math.min(max, value))
}

function toHex(value : number) : string {
  const text = Math.round(clamp(value, 0, 255)).toString(16)
  return text.length == 1 ? '0' + text : text
}

function rgbToHex(r : number, g : number, b : number) : string {
  return '#' + toHex(r) + toHex(g) + toHex(b)
}

function normalizeHex(value : any | null) : string {
  if (value == null) return ''
  let text = value.toString().replace(' ', '').replace(' ', '').trim()
  if (text.indexOf('#') != 0) text = '#' + text
  if (text.length == 4) {
    text =
      '#' +
      text.charAt(1) +
      text.charAt(1) +
      text.charAt(2) +
      text.charAt(2) +
      text.charAt(3) +
      text.charAt(3)
  }
  if (text.length != 7) return ''
  return text.toLowerCase()
}

function semanticToHex(value : string) : string {
  if (value == 'primary') return '#2979ff'
  if (value == 'success') return '#19be6b'
  if (value == 'warning') return '#ff9900'
  if (value == 'danger' || value == 'error') return '#fa3534'
  if (value == 'info') return '#909399'
  return ''
}

function parseCssColor(value : any | null) : IParsedColor {
  if (value == null) return { hex: '', alpha: -1 }
  const text = value.toString().replace(' ', '').replace(' ', '').trim().toLowerCase()
  if (text == 'transparent') return { hex: '#ffffff', alpha: 0 }
  if (text.indexOf('rgb(') != 0 && text.indexOf('rgba(') != 0) return { hex: '', alpha: -1 }
  const start = text.indexOf('(')
  const end = text.indexOf(')')
  if (start < 0 || end <= start) return { hex: '', alpha: -1 }
  const parts : Array<string> = text.substring(start + 1, end).split(',')
  if (parts.length < 3) return { hex: '', alpha: -1 }
  const red = Math.round(clamp(parseFloat(parts[0]), 0, 255))
  const green = Math.round(clamp(parseFloat(parts[1]), 0, 255))
  const blue = Math.round(clamp(parseFloat(parts[2]), 0, 255))
  let alpha = -1
  if (parts.length > 3) alpha = clamp(parseFloat(parts[3]), 0, 1)
  return { hex: rgbToHex(red, green, blue), alpha: alpha }
}

function normalizeToHex(value : any | null) : string {
  if (value == null) return ''
  const parsed = parseCssColor(value)
  if (parsed.hex.length > 0) return parsed.hex
  const text = value.toString()
  const semantic = semanticToHex(text)
  if (semantic.length > 0) return semantic
  return normalizeHex(text)
}

function hsvToRgb(h : number, s : number, v : number) : Array<number> {
  const hh = ((h % 360) + 360) % 360
  const ss = clamp(s, 0, 100) / 100
  const vv = clamp(v, 0, 100) / 100
  const c = vv * ss
  const x = c * (1 - Math.abs(((hh / 60) % 2) - 1))
  const m = vv - c
  let r = 0
  let g = 0
  let b = 0
  if (hh < 60) {
    r = c
    g = x
  } else if (hh < 120) {
    r = x
    g = c
  } else if (hh < 180) {
    g = c
    b = x
  } else if (hh < 240) {
    g = x
    b = c
  } else if (hh < 300) {
    r = x
    b = c
  } else {
    r = c
    b = x
  }
  return [Math.round((r + m) * 255), Math.round((g + m) * 255), Math.round((b + m) * 255)]
}

function hsvToHex(h : number, s : number, v : number) : string {
  const rgb = hsvToRgb(h, s, v)
  return rgbToHex(rgb[0], rgb[1], rgb[2])
}

function hexToRgb(hex : any | null) : Array<number> {
  const text = normalizeHex(hex)
  if (text.length == 0) return [0, 0, 0]
  return [
    parseInt(text.substring(1, 3), 16),
    parseInt(text.substring(3, 5), 16),
    parseInt(text.substring(5, 7), 16),
  ]
}

function hexToHsv(hex : any | null) : Array<number> {
  const rgb = hexToRgb(hex)
  const r = rgb[0] / 255
  const g = rgb[1] / 255
  const b = rgb[2] / 255
  const max = Math.max(r, Math.max(g, b))
  const min = Math.min(r, Math.min(g, b))
  const delta = max - min
  let nextHue = 0
  if (delta != 0) {
    if (max == r) nextHue = 60 * (((g - b) / delta) % 6)
    else if (max == g) nextHue = 60 * ((b - r) / delta + 2)
    else nextHue = 60 * ((r - g) / delta + 4)
  }
  if (nextHue < 0) nextHue = nextHue + 360
  const nextSaturation = max == 0 ? 0 : (delta / max) * 100
  return [Math.round(nextHue), Math.round(nextSaturation), Math.round(max * 100)]
}

function hslToRgb(h : number, s : number, l : number) : Array<number> {
  const hh = ((h % 360) + 360) % 360
  const ss = clamp(s, 0, 100) / 100
  const ll = clamp(l, 0, 100) / 100
  const c = (1 - Math.abs(2 * ll - 1)) * ss
  const x = c * (1 - Math.abs(((hh / 60) % 2) - 1))
  const m = ll - c / 2
  let r = 0
  let g = 0
  let b = 0
  if (hh < 60) {
    r = c
    g = x
  } else if (hh < 120) {
    r = x
    g = c
  } else if (hh < 180) {
    g = c
    b = x
  } else if (hh < 240) {
    g = x
    b = c
  } else if (hh < 300) {
    r = x
    b = c
  } else {
    r = c
    b = x
  }
  return [Math.round((r + m) * 255), Math.round((g + m) * 255), Math.round((b + m) * 255)]
}

function hslToHex(h : number, s : number, l : number) : string {
  const rgb = hslToRgb(h, s, l)
  return rgbToHex(rgb[0], rgb[1], rgb[2])
}

function hexToHsl(hex : any | null) : Array<number> {
  const rgb = hexToRgb(hex)
  const r = rgb[0] / 255
  const g = rgb[1] / 255
  const b = rgb[2] / 255
  const max = Math.max(r, Math.max(g, b))
  const min = Math.min(r, Math.min(g, b))
  const delta = max - min
  let nextHue = 0
  if (delta != 0) {
    if (max == r) nextHue = 60 * (((g - b) / delta) % 6)
    else if (max == g) nextHue = 60 * ((b - r) / delta + 2)
    else nextHue = 60 * ((r - g) / delta + 4)
  }
  if (nextHue < 0) nextHue = nextHue + 360
  const nextLightness = (max + min) / 2
  const nextSaturation = delta == 0 ? 0 : delta / (1 - Math.abs(2 * nextLightness - 1))
  return [Math.round(nextHue), Math.round(nextSaturation * 100), Math.round(nextLightness * 100)]
}

function formatSize(value : any | null) : string {
  if (value == null) return '0px'
  const text = value.toString()
  if (text.indexOf('px') >= 0 || text.indexOf('rpx') >= 0 || text.indexOf('%') >= 0) return text
  return text + 'px'
}

function normalizeSelectMode(value : any | null) : string {
  if (value == null) return 'spectrum'
  const text = value.toString().toLowerCase()
  if (text == 'rgb') return 'rgb'
  if (text == 'card' || text == 'palette' || text == 'color-card') return 'card'
  return 'spectrum'
}

function normalizeColorItem(item : any | null) : string {
  if (item == null) return ''
  if (typeof item == 'object') {
    const value = (item as UTSJSONObject)['value']
    if (value != null) return normalizeToHex(value)
  }
  return normalizeToHex(item)
}

function safeColorItems(value : Array<any | null> | null) : Array<any | null> {
  if (value == null) return []
  return value
}

const activeMode = ref<string>(normalizeSelectMode(props.selectMode))
const hue = ref<number>(210)
const saturation = ref<number>(72)
const brightness = ref<number>(88)
const colorHex = ref(
  normalizeToHex(props.value).length > 0 ? normalizeToHex(props.value) : '#2979ff',
)
const spectrumX = ref<number>(50)
const spectrumY = ref<number>(50)
const alphaPercent = ref<number>(Math.round(props.alpha * 100))
const selectedCardColor = ref<string>('')
const hexInput = ref<string>('')
const panelRows = ref<number>(18)
const panelColumns = ref<number>(18)
const cardRows = ref<number>(10)
const cardColumns = ref<number>(12)
const panelId =
  'i-color-picker-panel-' + (Date.now()).toString() + '-' + (Math.round(Math.random() * 100000)).toString()
const panelRectLeft = ref<number>(0)
const panelRectTop = ref<number>(0)
const panelRectWidth = ref<number>(0)
const panelRectHeight = ref<number>(0)

const defaultColors = ref<Array<string>>([
  '#ff1d1d',
  '#ff8a00',
  '#ffd21e',
  '#00e923',
  '#18bfe2',
  '#0800ee',
  '#8e2de2',
  '#f000d4',
  '#000000',
  '#666666',
  '#cfcfcf',
  '#2491f2',
  '#40c51b',
  '#ffb319',
  '#ff2633',
  '#ff6268',
  '#ffb36a',
  '#4fc3bd',
])

const modeText = computed(() : string => {
  return props.mode.toUpperCase() + ' ▾'
})

const currentHex = computed(() : string => {
  return colorHex.value
})

const currentHsl = computed(() : Array<number> => {
  return hexToHsl(currentHex.value)
})

const redValue = computed(() : number => {
  return hexToRgb(currentHex.value)[0]
})

const greenValue = computed(() : number => {
  return hexToRgb(currentHex.value)[1]
})

const blueValue = computed(() : number => {
  return hexToRgb(currentHex.value)[2]
})

const outputValue = computed(() : string => {
  if (!props.showAlpha || alphaPercent.value >= 100) return currentHex.value
  const rgb = hexToRgb(currentHex.value)
  return (
    'rgba(' +
    rgb[0] +
    ', ' +
    rgb[1] +
    ', ' +
    rgb[2] +
    ', ' +
    (alphaPercent.value / 100).toFixed(2) +
    ')'
  )
})

const panelStyle = computed(() : string => {
  return 'height:' + formatSize(props.panelHeight) + ';background-color:#ffffff;'
})

const indicatorStyle = computed(() : string => {
  return 'left:' + spectrumX.value + '%;top:' + spectrumY.value + '%;'
})

const panelRowStyle = computed(() : string => {
  return (
    'height:' +
    parseFloat(((props.panelHeight).toString().replace('px', '').replace('rpx', '')).toString()) / panelRows.value +
    'px;'
  )
})

const alphaTrackStyle = computed(() : string => {
  return 'background:linear-gradient(to right,rgba(255,255,255,0),' + currentHex.value + ');'
})

const previewStyle = computed(() : string => {
  return 'background-color:' + outputValue.value + ';'
})

const recommendedList = computed(() : Array<IRecommendedColor> => {
  const list : Array<IRecommendedColor> = []
  const colors = safeColorItems(props.colors)
  if (colors.length > 0) {
    for (let i = 0; i < colors.length; i++) {
      const item = colors[i]
      const text = normalizeColorItem(item)
      if (text.length > 0) list.push({ value: text })
    }
    return list
  }
  for (let i = 0; i < defaultColors.value.length; i++) {
    list.push({ value: defaultColors.value[i] })
  }
  return list
})

const recommendRowList = computed(() : Array<IRecommendedRow> => {
  const list = recommendedList.value
  const rows = 2
  const columns = Math.ceil(list.length / rows)
  const result : Array<IRecommendedRow> = []
  for (let rowIndex = 0; rowIndex < rows; rowIndex++) {
    const rowColors : Array<IRecommendedColor> = []
    for (let columnIndex = 0; columnIndex < columns; columnIndex++) {
      const index = rowIndex * columns + columnIndex
      if (index < list.length) rowColors.push(list[index])
    }
    if (rowColors.length > 0) {
      result.push({ key: (rowIndex).toString(), colors: rowColors })
    }
  }
  return result
})

function syncHexInput() : void {
  hexInput.value = currentHex.value.replace('#', '# ')
}

function emitInput() : void {
  syncHexInput()
  emit('input', outputValue.value)
}

function commit() : void {
  syncHexInput()
  emit('input', outputValue.value)
  emit('change', outputValue.value)
  emit('update:value', outputValue.value)
  emit('update:modelValue', outputValue.value)
}

function getSpectrumPosition(hex : any | null) : Array<number> {
  const hsl = hexToHsl(hex)
  return [Math.round(100 - hsl[2]), Math.round((hsl[0] / 360) * 100)]
}

function applyColor(value : any | null, shouldCommit : boolean) : void {
  const parsed = parseCssColor(value)
  const hex = parsed.hex.length > 0 ? parsed.hex : normalizeToHex(value)
  if (hex.length == 0) return
  if (parsed.alpha >= 0) alphaPercent.value = clamp(Math.round(parsed.alpha * 100), 0, 100)
  const hsv = hexToHsv(hex)
  const spectrum = getSpectrumPosition(hex)
  colorHex.value = hex
  hue.value = hsv[0]
  saturation.value = hsv[1]
  brightness.value = hsv[2]
  spectrumX.value = spectrum[0]
  spectrumY.value = spectrum[1]
  syncHexInput()
  if (shouldCommit) commit()
}

watch(
  () : string => props.value,
  (nextValue : string) : void => {
    applyColor(nextValue, false)
  },
)

watch(
  () : number => props.alpha,
  (nextValue : number) : void => {
    alphaPercent.value = clamp(Math.round(nextValue * 100), 0, 100)
  },
)

watch(
  () : string => props.selectMode,
  (nextValue : string) : void => {
    activeMode.value = normalizeSelectMode(nextValue)
  },
)

applyColor(props.value, false)

function setActiveMode(value : any | null) : void {
  if (props.disabled) return
  const nextMode = normalizeSelectMode(value)
  if (activeMode.value == nextMode) return
  activeMode.value = nextMode
  emit('mode-change', nextMode)
}

function handleHueChanging(event : UniSliderChangeEvent) : void {
  if (props.disabled) return
  selectedCardColor.value = ''
  hue.value = parseFloat((event.detail.value).toString())
  colorHex.value = hsvToHex(hue.value, saturation.value, brightness.value)
  emitInput()
}

function handleHueChange(event : UniSliderChangeEvent) : void {
  if (props.disabled) return
  selectedCardColor.value = ''
  hue.value = parseFloat((event.detail.value).toString())
  colorHex.value = hsvToHex(hue.value, saturation.value, brightness.value)
  commit()
}

function handleAlphaChanging(event : UniSliderChangeEvent) : void {
  if (props.disabled) return
  alphaPercent.value = parseFloat((event.detail.value).toString())
  emitInput()
}

function handleAlphaChange(event : UniSliderChangeEvent) : void {
  if (props.disabled) return
  alphaPercent.value = parseFloat((event.detail.value).toString())
  commit()
}

function handleSaturationChanging(event : UniSliderChangeEvent) : void {
  if (props.disabled) return
  selectedCardColor.value = ''
  saturation.value = parseFloat((event.detail.value).toString())
  colorHex.value = hsvToHex(hue.value, saturation.value, brightness.value)
  emitInput()
}

function handleSaturationChange(event : UniSliderChangeEvent) : void {
  if (props.disabled) return
  selectedCardColor.value = ''
  saturation.value = parseFloat((event.detail.value).toString())
  colorHex.value = hsvToHex(hue.value, saturation.value, brightness.value)
  commit()
}

function handleBrightnessChanging(event : UniSliderChangeEvent) : void {
  if (props.disabled) return
  selectedCardColor.value = ''
  brightness.value = parseFloat((event.detail.value).toString())
  colorHex.value = hsvToHex(hue.value, saturation.value, brightness.value)
  emitInput()
}

function handleBrightnessChange(event : UniSliderChangeEvent) : void {
  if (props.disabled) return
  selectedCardColor.value = ''
  brightness.value = parseFloat((event.detail.value).toString())
  colorHex.value = hsvToHex(hue.value, saturation.value, brightness.value)
  commit()
}

function updateRgbValue(channel : string, value : number) : void {
  selectedCardColor.value = ''
  const rgb = hexToRgb(currentHex.value)
  if (channel == 'r') rgb[0] = Math.round(clamp(value, 0, 255))
  if (channel == 'g') rgb[1] = Math.round(clamp(value, 0, 255))
  if (channel == 'b') rgb[2] = Math.round(clamp(value, 0, 255))
  applyColor(rgbToHex(rgb[0], rgb[1], rgb[2]), false)
}

function getCardColor(row : number, column : number) : string {
  const greyList : Array<string> = [
    '#f1f1f1',
    '#dcdcdc',
    '#c8c8c8',
    '#b3b3b3',
    '#9e9e9e',
    '#898989',
    '#747474',
    '#5f5f5f',
    '#4a4a4a',
    '#333333',
    '#191919',
    '#000000',
  ]
  const hueList : Array<number> = [178, 202, 232, 258, 282, 310, 334, 358, 22, 47, 72, 100]
  if (row == 1) return greyList[column - 1]
  const lightnessList : Array<number> = [16, 24, 32, 42, 52, 62, 72, 82, 92]
  const saturationList : Array<number> = [96, 94, 90, 86, 78, 66, 52, 34, 18]
  const index = row - 2
  return hslToHex(hueList[column - 1], saturationList[index], lightnessList[index])
}

function updateSpectrumValue(ratioX : number, ratioY : number) : void {
  const nextX = clamp(ratioX, 0, 1)
  const nextY = clamp(ratioY, 0, 1)
  const nextHue = Math.round(nextY * 360)
  const nextLightness = Math.round(100 - nextX * 100)
  applyColor(hslToHex(nextHue, 100, nextLightness), false)
  spectrumX.value = Math.round(nextX * 100)
  spectrumY.value = Math.round(nextY * 100)
}

function handleRgbChanging(channel : string, event : UniSliderChangeEvent) : void {
  if (props.disabled) return
  updateRgbValue(channel, parseFloat((event.detail.value).toString()))
  emitInput()
}

function handleRgbChange(channel : string, event : UniSliderChangeEvent) : void {
  if (props.disabled) return
  updateRgbValue(channel, parseFloat((event.detail.value).toString()))
  commit()
}

function handleRedChanging(event : UniSliderChangeEvent) : void {
  handleRgbChanging('r', event)
}

function handleRedChange(event : UniSliderChangeEvent) : void {
  handleRgbChange('r', event)
}

function handleGreenChanging(event : UniSliderChangeEvent) : void {
  handleRgbChanging('g', event)
}

function handleGreenChange(event : UniSliderChangeEvent) : void {
  handleRgbChange('g', event)
}

function handleBlueChanging(event : UniSliderChangeEvent) : void {
  handleRgbChanging('b', event)
}

function handleBlueChange(event : UniSliderChangeEvent) : void {
  handleRgbChange('b', event)
}

function handleHexInput(event : UniInputEvent) : void {
  if (props.disabled) return
  selectedCardColor.value = ''
  hexInput.value = event.detail.value
  const normalized = normalizeHex(hexInput.value)
  if (normalized.length > 0) {
    applyColor(normalized, false)
    emitInput()
  }
}

function commitHexInput() : void {
  selectedCardColor.value = ''
  const normalized = normalizeHex(hexInput.value)
  if (normalized.length > 0) {
    applyColor(normalized, false)
    commit()
  }
}

function selectColor(value : string) : void {
  if (props.disabled) return
  selectedCardColor.value = ''
  applyColor(value, true)
}

function selectCardCell(row : number, column : number) : void {
  if (props.disabled) return
  const color = getCardColor(row, column)
  selectedCardColor.value = color
  applyColor(color, true)
}

function selectPanelCell(column : number, row : number) : void {
  if (props.disabled) return
  selectedCardColor.value = ''
  const ratioX = (column - 1) / (panelColumns.value - 1)
  const ratioY = (row - 1) / (panelRows.value - 1)
  updateSpectrumValue(ratioX, ratioY)
  commit()
}

function getPanelCellStyle(row : number, column : number) : string {
  const rowNumber = row
  const columnNumber = column
  const hueValue =
    panelRows.value <= 1 ? 0 : Math.round(((rowNumber - 1) / (panelRows.value - 1)) * 360)
  const lightnessValue =
    panelColumns.value <= 1
      ? 50
      : Math.round(98 - ((columnNumber - 1) / (panelColumns.value - 1)) * 96)
  return 'background-color:' + hslToHex(hueValue, 100, lightnessValue) + ';'
}

function refreshPanelRect() : void {
  const element = uni.getElementById(panelId)
  if (element == null) return
  const rect = element.getBoundingClientRect()
  panelRectLeft.value = rect.left
  panelRectTop.value = rect.top
  panelRectWidth.value = rect.width
  panelRectHeight.value = rect.height
}

function panelHeightNumber() : number {
  const value = props.panelHeight
  if (value == null) return 260
  const height = parseFloat(value.toString().replace('px', '').replace('rpx', ''))
  return isNaN(height) || height <= 0 ? 260 : height
}

function updatePanelByClientPoint(clientX : number, clientY : number) : void {
  selectedCardColor.value = ''
  refreshPanelRect()
  const width = panelRectWidth.value > 0 ? panelRectWidth.value : 320
  const height = panelRectHeight.value > 0 ? panelRectHeight.value : panelHeightNumber()
  updateSpectrumValue(
    (clientX - panelRectLeft.value) / width,
    (clientY - panelRectTop.value) / height,
  )
}

function updatePanelByTouch(event : UniTouchEvent) : void {
  if (props.disabled || event.touches.length == 0) return
  const touch = event.touches[0]
  updatePanelByClientPoint(touch.clientX, touch.clientY)
}

function updatePanelByEvent(event : UniPointerEvent) : void {
  if (props.disabled) return
  updatePanelByClientPoint(event.clientX, event.clientY)
}

function handlePanelTouchStart(event : UniTouchEvent) : void {
  updatePanelByTouch(event)
  emitInput()
}

function handlePanelTouchMove(event : UniTouchEvent) : void {
  updatePanelByTouch(event)
  emitInput()
}

function handlePanelTouchEnd() : void {
  commit()
}

function handlePanelClick(event : UniPointerEvent) : void {
  updatePanelByEvent(event)
  commit()
}

function isCardCellActive(row : number, column : number) : boolean {
  return selectedCardColor.value == getCardColor(row, column)
}

</script>

