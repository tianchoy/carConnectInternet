<template>
  <view class="i-index-list" :style="'background-color:' + bgColor">
    <scroll-view
      class="i-index-list__content"
      :style="contentStyle"
      scroll-y
      :scroll-into-view="scrollIntoView"
      :scroll-with-animation="true"
      :show-scrollbar="showScrollbar"
    >
      <view
        v-for="(group, groupIndex) in groups"
        :id="'i-index-list-group-' + (groupIndex).toString()"
        :key="(groupIndex).toString() + '-' + getGroupTitle(group, groupIndex)"
        class="i-index-list__group"
      >
        <view
          v-if="showIndexTitle"
          class="i-index-list__group-title"
          :style="groupTitleStyle"
        >
          <text class="i-index-list__group-title-text">
            {{ getGroupTitle(group, groupIndex) }}
          </text>
        </view>
        <view
          v-for="(item, itemIndex) in getGroupItems(group)"
          :key="(itemIndex).toString() + '-' + getItemText(item)"
          class="i-index-list__item"
          @click="selectItem(group, groupIndex, item, itemIndex)"
        >
          <text class="i-index-list__item-text">{{ getItemText(item) }}</text>
        </view>
      </view>
    </scroll-view>

    <view
      v-if="showIndexBar"
      :id="barId"
      class="i-index-list__bar"
      @touchstart="handleBarTouchStart"
      @touchmove="handleBarTouchMove"
    >
      <text
        v-for="(group, groupIndex) in groups"
        :key="'bar-' + (groupIndex).toString()"
        :class="
          activeIndex == groupIndex
            ? 'i-index-list__bar-text i-index-list__bar-text--active'
            : 'i-index-list__bar-text'
        "
        :style="activeIndex == groupIndex ? 'color:' + activeColor : ''"
        @tap="selectGroup(groupIndex)"
        @click="selectGroup(groupIndex)"
      >
        {{ getGroupTitle(group, groupIndex) }}
      </text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue'

defineOptions({ name: 'i-index-list' })

/**
 * Props 说明：索引列表数据与展示配置。
 * - list: 分组数据；对象支持 title/name/index、items/children。
 * - letters: 兼容旧用法的分组标题数组。
 * - itemsA/itemsB/itemsS: 兼容旧用法的 A/B/S 分组数据。
 * - activeColor: 右侧索引选中颜色。
 * - bgColor: 容器背景色。
 * - sticky: 是否启用分组标题 sticky 效果。
 * - showIndexBar: 是否显示右侧索引栏。
 * - showIndexTitle: 是否显示每组标题。
 * - showScrollbar: 是否显示滚动条。
 * - height: 列表高度。
 * - scrollIntoView: 点击右侧索引时内部会设置该值，让 scroll-view 滚到对应分组。
 */
const props = defineProps({
  list: {
    type: Array,
    default() {
      return []
    },
  },
  letters: {
    type: Array,
    default() {
      return ['A', 'B', 'S']
    },
  },
  itemsA: {
    type: Array,
    default() {
      return ['安徽', '澳门']
    },
  },
  itemsB: {
    type: Array,
    default() {
      return ['北京', '保定']
    },
  },
  itemsS: {
    type: Array,
    default() {
      return ['上海', '深圳']
    },
  },
  activeColor: { type: String, default: '#2979ff' },
  bgColor: { type: String, default: '#ffffff' },
  sticky: { type: Boolean, default: true },
  showIndexBar: { type: Boolean, default: true },
  showIndexTitle: { type: Boolean, default: true },
  showScrollbar: { type: Boolean, default: false },
  height: { type: [String, Number], default: '360' },
})

/**
 * Emits 说明：索引和列表项选择事件。
 * - select: 选择列表项时触发，返回 { groupIndex, itemIndex, index, item, text }。
 * - change: 点击右侧索引切换分组时触发，返回 { groupIndex, index }。
 * - click: 点击列表项时触发，参数同 select。
 */
const emit = defineEmits<{
  (event: 'select', payload: any): void
  (event: 'change', payload: any): void
  (event: 'click', payload: any): void
}>()

type IIndexGroup = {
  title : string,
  items : Array<any | null>,
}

type IIndexSelectPayload = {
  groupIndex : number,
  itemIndex : number,
  index : string,
  item : any | null,
  text : string,
}

type IIndexChangePayload = {
  groupIndex : number,
  index : string,
}

function objectText(object : UTSJSONObject, keyName : string) : string {
  const value = object[keyName]
  return value == null ? '' : value.toString()
}

function normalizeItems(value : Array<any | null> | null) : Array<any | null> {
  return value == null ? [] : value
}

function normalizeGroup(raw : any | null, index : number) : IIndexGroup | null {
  if (raw == null) return null
  if (typeof raw != 'object') return { title: raw.toString(), items: [] }
  const object = raw as UTSJSONObject
  let title = objectText(object, 'title')
  if (title.length == 0) title = objectText(object, 'name')
  if (title.length == 0) title = objectText(object, 'index')
  if (title.length == 0) title = (index + 1).toString()
  let items : Array<any | null> = []
  const rawItems = object['items']
  if (rawItems != null && Array.isArray(rawItems)) {
    items = rawItems as Array<any | null>
  } else {
    const children = object['children']
    if (children != null && Array.isArray(children)) items = children as Array<any | null>
  }
  return { title, items }
}

function normalizeGroups(value : Array<any | null> | null) : Array<IIndexGroup> {
  const result : Array<IIndexGroup> = []
  if (value == null) return result
  for (let i = 0; i < value.length; i++) {
    const group = normalizeGroup(value[i], i)
    if (group != null) result.push(group)
  }
  return result
}

function formatSize(value : any) : string {
  const text = value.toString()
  if (text.indexOf('px') >= 0 || text.indexOf('rpx') >= 0 || text.indexOf('%') >= 0) return text
  return text + 'px'
}

function getItemText(item : any | null) : string {
  if (item == null) return ''
  if (typeof item == 'object') {
    const object = item as UTSJSONObject
    const name = objectText(object, 'name')
    if (name.length > 0) return name
    const text = objectText(object, 'text')
    if (text.length > 0) return text
  }
  return item.toString()
}

const bgColor = computed(() : string => {
  return props.bgColor
})
const activeIndex = ref(0)
const scrollIntoView = ref('')
const barId = 'i-index-list-bar-' + (Math.round(Math.random() * 1000000)).toString()
const barTop = ref(0)
const barHeight = ref(0)

const groups = computed(() : Array<IIndexGroup> => {
  const provided = normalizeGroups(props.list)
  if (provided.length > 0) return provided
  const result : Array<IIndexGroup> = []
  const letters = props.letters
  if (letters == null) return result
  for (let i = 0; i < letters.length; i++) {
    const rawTitle = letters[i]
    if (rawTitle == null) continue
    const title = rawTitle.toString()
    let items = normalizeItems(props.itemsA)
    if (title == 'B') items = normalizeItems(props.itemsB)
    if (title == 'S') items = normalizeItems(props.itemsS)
    result.push({ title, items })
  }
  return result
})

const groupTitleStyle = computed(() : string => {
  let style = 'background-color:#f5f7fb;'
  if (props.sticky) {
    style += 'position:sticky;top:0;z-index:1;'
  }
  return style
})

const contentStyle = computed(() : string => {
  return 'height:' + formatSize(props.height) + ';'
})

function getGroupTitle(group : IIndexGroup, index : number) : string {
  return group.title.length > 0 ? group.title : (index + 1).toString()
}

function getGroupItems(group : IIndexGroup) : Array<any | null> {
  return group.items
}

function switchGroup(groupIndex : number, forceEmit : boolean) : void {
  if (groups.value.length == 0) return
  let nextIndex = groupIndex
  if (nextIndex < 0) nextIndex = 0
  if (nextIndex >= groups.value.length) nextIndex = groups.value.length - 1
  if (!forceEmit && activeIndex.value == nextIndex) return
  activeIndex.value = nextIndex
  scrollIntoView.value = 'i-index-list-group-' + (nextIndex).toString()
  const payload : IIndexChangePayload = {
    groupIndex: nextIndex,
    index: getGroupTitle(groups.value[nextIndex], nextIndex),
  }
  emit('change', payload)
}

function readTouchY(event : UniTouchEvent) : number {
  if (event.touches.length > 0) return event.touches[0].clientY
  if (event.changedTouches.length > 0) return event.changedTouches[0].clientY
  return NaN
}

function normalizeRectPoint(first : any | null, fallback : any | null) : number {
  if (first != null) {
    const firstValue = parseFloat(first.toString())
    if (!isNaN(firstValue)) return firstValue
  }
  if (fallback != null) {
    const fallbackValue = parseFloat(fallback.toString())
    if (!isNaN(fallbackValue)) return fallbackValue
  }
  return 0
}

function updateGroupByTouch(event : UniTouchEvent) : void {
  const y = readTouchY(event)
  if (isNaN(y) || barHeight.value <= 0 || groups.value.length == 0) return

  const letterHeight = 20
  const totalLetterHeight = groups.value.length * letterHeight
  const startOffset = Math.max(0, (barHeight.value - totalLetterHeight) / 2)
  const relativeY = y - barTop.value - startOffset
  let nextIndex = Math.floor(relativeY / letterHeight)

  if (nextIndex < 0) nextIndex = 0
  if (nextIndex >= groups.value.length) nextIndex = groups.value.length - 1
  switchGroup(nextIndex, false)
}

function refreshBarRect(event : UniTouchEvent, shouldUpdate : boolean) : void {
  uni
    .createSelectorQuery()
    .select('#' + barId)
    .boundingClientRect((rect : any | null) : void => {
      if (rect != null && typeof rect == 'object') {
        const object = rect as UTSJSONObject
        barTop.value = normalizeRectPoint(object['top'], object['y'])
        barHeight.value = normalizeRectPoint(object['height'], 0)
      }
      if (shouldUpdate) updateGroupByTouch(event)
    })
    .exec()
}

function selectGroup(groupIndex : number) : void {
  switchGroup(groupIndex, true)
}

function handleBarTouchStart(event : UniTouchEvent) : void {
  if (groups.value.length == 0) return
  if (barHeight.value > 0) {
    updateGroupByTouch(event)
    return
  }
  refreshBarRect(event, true)
}

function handleBarTouchMove(event : UniTouchEvent) : void {
  if (groups.value.length == 0) return
  if (barHeight.value > 0) {
    updateGroupByTouch(event)
    return
  }
  refreshBarRect(event, true)
}

function selectItem(group : IIndexGroup, groupIndex : number, item : any | null, itemIndex : number) : void {
  const payload : IIndexSelectPayload = {
    groupIndex,
    itemIndex,
    index: getGroupTitle(group, groupIndex),
    item,
    text: getItemText(item),
  }
  emit('click', payload)
  emit('select', payload)
}
</script>

<style>
.i-index-list {
  position: relative;
  border-radius: 8px;
  overflow: hidden;
}

.i-index-list__content {
  position: relative;
  z-index: 1;
  height: 360px;
}

.i-index-list__group-title {
  min-height: 32px;
  padding: 0 46px 0 14px;
  justify-content: center;
}

.i-index-list__group-title-text {
  color: #909399;
  font-size: 13px;
  line-height: 18px;
}

.i-index-list__item {
  min-height: 44px;
  padding: 0 48px 0 16px;
  justify-content: center;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #ebeef5;
  background-color: #ffffff;
}

.i-index-list__item-text {
  color: #303133;
  font-size: 14px;
  line-height: 20px;
}

.i-index-list__bar {
  position: absolute;
  right: 6px;
  top: 18px;
  bottom: 18px;
  z-index: 20;
  width: 30px;
  align-items: center;
  justify-content: center;
}

.i-index-list__bar-text {
  width: 24px;
  height: 20px;
  color: #606266;
  font-size: 12px;
  line-height: 20px;
  text-align: center;
}

.i-index-list__bar-text--active {
  font-weight: 700;
}
</style>
