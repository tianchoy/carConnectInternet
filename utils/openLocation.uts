import { showAppToast } from './toast.uts'
import CoordTransform from './coordTransform.uts'
// #ifdef APP-ANDROID
import { openExternalMap } from '@/uni_modules/external-map-navigation'
// #endif
// #ifdef APP-IOS
import { getAvailableIOSMapProviderIds, openExternalMap } from '@/uni_modules/external-map-navigation'
// #endif

export type OpenLocationParams = {
	latitude: number
	longitude: number
	name: string
}

function isValidCoordinate(latitude: number, longitude: number): boolean {
	return !isNaN(latitude) && !isNaN(longitude) &&
		latitude >= -90 && latitude <= 90 &&
		longitude >= -180 && longitude <= 180 &&
		!(latitude == 0 && longitude == 0)
}

function showInvalidLocationToast(): void {
	showAppToast({
		title: '暂无有效车辆位置',
		icon: 'none'
	})
}

function showOpenMapFailedToast(): void {
	showAppToast({
		title: '无法打开地图，请稍后重试',
		icon: 'none'
	})
}

// #ifdef APP-ANDROID
function openAndroidExternalMap(params: OpenLocationParams): void {
	const navigationResult = openExternalMap({
		latitude: params.latitude,
		longitude: params.longitude,
		name: params.name
	})
	if (navigationResult.code == 'opened') return

	if (navigationResult.code == 'invalid_coordinate') {
		showInvalidLocationToast()
		return
	}

	if (navigationResult.code == 'no_map_app') {
		showAppToast({
			title: '未检测到可用地图应用',
			icon: 'none'
		})
		return
	}

	showOpenMapFailedToast()
}
// #endif

// #ifdef APP-IOS
function openIOSExternalMap(params: OpenLocationParams, providerId?: string): void {
	const wgs84 = CoordTransform.tencentToWgs84(params.latitude, params.longitude)
	const navigationResult = openExternalMap({
		latitude: params.latitude,
		longitude: params.longitude,
		name: params.name,
		providerId: providerId,
		wgs84Latitude: wgs84.lat,
		wgs84Longitude: wgs84.lng
	})
	if (navigationResult.code == 'opened') return

	if (navigationResult.code == 'invalid_coordinate') {
		showInvalidLocationToast()
		return
	}

	showOpenMapFailedToast()
}

function getIOSMapProviderName(providerId: string): string {
	if (providerId == 'qqmap') return '腾讯地图'
	if (providerId == 'iosamap') return '高德地图'
	if (providerId == 'baidumap') return '百度地图'
	return ''
}

function chooseIOSMapProvider(params: OpenLocationParams, availableProviderIds: string[]): void {
	const itemList: string[] = []
	const providerIds: string[] = []
	availableProviderIds.forEach((providerId): void => {
		const providerName = getIOSMapProviderName(providerId)
		if (providerName == '') return
		itemList.push(providerName)
		providerIds.push(providerId)
	})

	if (providerIds.length == 0) {
		openIOSExternalMap(params)
		return
	}

	uni.showActionSheet({
		title: '选择地图应用',
		itemList: itemList,
		success: (res: ShowActionSheetSuccess) => {
			const tapIndex = res.tapIndex
			if (tapIndex < 0 || tapIndex >= providerIds.length) return

			const providerId = providerIds[tapIndex]
			if (providerId != '') openIOSExternalMap(params, providerId)
		}
	})
}

function openIOSLocation(params: OpenLocationParams): void {
	const providerIds = getAvailableIOSMapProviderIds()
	if (providerIds.length > 1) {
		chooseIOSMapProvider(params, providerIds)
		return
	}
	if (providerIds.length == 1) {
		openIOSExternalMap(params, providerIds[0])
		return
	}
	openIOSExternalMap(params)
}
// #endif

function openBuiltInLocation(params: OpenLocationParams): void {
	try {
		uni.openLocation({
			latitude: params.latitude,
			longitude: params.longitude,
			name: params.name != '' ? params.name : '当前位置',
			scale: 18,
			success: () => {
				console.log('成功打开位置地图')
			},
			fail: (error) => {
				console.error('打开位置地图失败:', error)
				showAppToast({
					title: '打开位置地图失败，请稍后重试',
					icon: 'none'
				})
			}
		})
	} catch (error) {
		console.error('打开位置地图异常:', error)
		showAppToast({
			title: '打开位置地图失败，请稍后重试',
			icon: 'none'
		})
	}
}

export function openLocation(params: OpenLocationParams): void {
	if (!isValidCoordinate(params.latitude, params.longitude)) {
		showInvalidLocationToast()
		return
	}

	// #ifdef APP-ANDROID
	openAndroidExternalMap(params)
	return
	// #endif

	// #ifdef APP-IOS
	openIOSLocation(params)
	return
	// #endif

	// #ifndef APP-ANDROID
	openBuiltInLocation(params)
	// #endif
}
