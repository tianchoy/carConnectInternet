import { isBusinessSuccessCode } from '../api/response.uts'
import { getNotifyQuota, getDeviceTicket, getNotifyStatus, reportSubscribeResults, type NotifyQuotaItem } from '../api/request.uts'

/**
 * 订阅消息前端封装（对接 /app/notify）
 *
 * 两条通道，由 /app/notify/quota 返回的 mode 决定，前端不硬编码：
 * - device（alarm 告警）：GET /app/notify/deviceTicket 换票 → wx.requestSubscribeDeviceMessage → 长期有效，无需上报
 * - once（order / expire / share）：wx.requestSubscribeMessage → POST /app/notify/subscribeReport 上报记账
 *
 * 后端文档：微信小程序订阅消息-前端对接API完整文档.md
 */

const QUOTA_STORAGE_KEY = 'wx_subscribe_quota'
const DEFAULT_BIZ_CODE = 'alarm'
/** 围栏进出告警的专属模板场景码（后端 wx.subscribe.templates.geofence，mode=longterm） */
const GEOFENCE_BIZ_CODE = 'geofence'

/**
 * 设备订阅状态缓存前缀。
 * 微信没有查询「设备订阅消息」状态的接口，只能以授权回调结果为准；
 * 且必须按「设备 + 模板」维度逐台记录 —— 多设备共用一个标记会导致切换设备后
 * 被误判为「已订阅」而跳过授权，那台设备实际从未授权成功，于是收不到它的告警通知。
 * 值格式：`${templateId}|${status}`
 */
const DEVICE_SUBSCRIBE_PREFIX = 'wx_dev_sub_'

/**
 * 围栏模板（长期订阅）的本地授权记录，值为 templateId。
 * 为什么不能只靠 wx.getSetting：itemSettings 只包含用户勾选过「总是保持以上选择」的模板，
 * 用户未勾选时每次都查不到，会把已授权误判成未授权（按钮永远停在「开启围栏提醒」）。
 */
const GEOFENCE_STORAGE_KEY = 'wx_geofence_subscribed'

export type DeviceAuthorizeStatus = 'accept' | 'acceptWithAudio' | 'acceptWithAlert' | 'reject' | 'ban' | 'filter' | 'fail' | 'unsupported' | 'noTemplate'

export type DeviceAuthorizeOutcome = {
    status: DeviceAuthorizeStatus
    errMsg: string
    errCode: number
    templateId: string
    /** 授权时使用的设备 sn：服务端下发必须同源同值，否则微信报 9800006（围栏等模板级通道为空） */
    sn: string
    /** 授权时使用的设备型号 ID（模板级通道为空） */
    modelId: string
}

/**
 * accept / acceptWithAudio / acceptWithAlert 都属于「已订阅」，
 * 区别只是微信服务通知的提醒强度（accept=仅接收，不弹横幅）
 */
export function isAcceptDeviceStatus(status : string) : boolean {
    return status == 'accept' || status == 'acceptWithAudio' || status == 'acceptWithAlert'
}

function deviceSubscribeKey(deviceNo : string) : string {
    return DEVICE_SUBSCRIBE_PREFIX + deviceNo
}

/**
 * 读取某台设备的授权结果；模板 ID 不一致（后端换过模板）时视为未订阅，强制重新授权
 */
export function getDeviceSubscribeStatus(deviceNo : string, templateId : string) : string {
    if (deviceNo == '' || templateId == '') return ''
    try {
        const raw = uni.getStorageSync(deviceSubscribeKey(deviceNo))
        if (raw == null || raw.toString() == '') return ''
        const text = raw.toString()
        const idx = text.indexOf('|')
        if (idx <= 0) return ''
        const cachedTemplate = text.substring(0, idx)
        if (cachedTemplate != templateId) return ''
        return text.substring(idx + 1)
    } catch (error) {
        console.warn('[notify] 读取设备订阅状态失败:', error)
        return ''
    }
}

/**
 * 记录某台设备的授权结果（accept 系列 = 已订阅，reject = 用户拒绝过需引导去设置页）
 */
export function saveDeviceSubscribeStatus(deviceNo : string, templateId : string, status : string) : void {
    if (deviceNo == '' || templateId == '' || status == '') return
    try {
        uni.setStorageSync(deviceSubscribeKey(deviceNo), templateId + '|' + status)
    } catch (error) {
        console.warn('[notify] 保存设备订阅状态失败:', error)
    }
}

export function clearDeviceSubscribeStatus(deviceNo : string) : void {
    if (deviceNo == '') return
    try {
        uni.removeStorageSync(deviceSubscribeKey(deviceNo))
    } catch (error) {
        console.warn('[notify] 清除设备订阅状态失败:', error)
    }
}

/**
 * 清空全部设备订阅记录（切换账号 / 退出登录时调用：openid 变了，旧的订阅关系不再适用）
 */
export function clearAllDeviceSubscribeStatus() : void {
    try {
        const info = uni.getStorageInfoSync()
        const keys = info.keys
        for (let i = 0; i < keys.length; i++) {
            if (keys[i].indexOf(DEVICE_SUBSCRIBE_PREFIX) == 0) {
                uni.removeStorageSync(keys[i])
            }
        }
        uni.removeStorageSync(GEOFENCE_STORAGE_KEY)
    } catch (error) {
        console.warn('[notify] 清空设备订阅状态失败:', error)
    }
}

/**
 * 围栏模板是否已在本机授权过（模板 ID 变更后旧记录失效）
 */
export function getGeofenceSubscribed(templateId : string) : boolean {
    if (templateId == '') return false
    try {
        const raw = uni.getStorageSync(GEOFENCE_STORAGE_KEY)
        if (raw == null || raw.toString() == '') return false
        return raw.toString() == templateId
    } catch (error) {
        console.warn('[notify] 读取围栏订阅状态失败:', error)
        return false
    }
}

export function saveGeofenceSubscribed(templateId : string) : void {
    if (templateId == '') return
    try {
        uni.setStorageSync(GEOFENCE_STORAGE_KEY, templateId)
    } catch (error) {
        console.warn('[notify] 保存围栏订阅状态失败:', error)
    }
}

/**
 * 设备订阅能力探测：非微信小程序端或基础库 < 2.20.0 时不可用，调用方应隐藏入口
 */
export function isDeviceSubscribeSupported() : boolean {
    try {
        return wx.canIUse('requestSubscribeDeviceMessage')
    } catch (error) {
        console.warn('[notify] 能力探测失败:', error)
        return false
    }
    return false
}

/**
 * 拉取各场景模板 ID 与通道，并写入本地缓存（后端要求缓存以减少请求）
 */
// 请求去重 + 节流：onShow、设备切换等多个入口可能连续触发拉取，避免重复请求 /quota
let quotaInFlight : Promise<Array<NotifyQuotaItem>> | null = null
let quotaFetchedAt : number = 0
const QUOTA_FETCH_MIN_INTERVAL : number = 10 * 1000

export async function fetchNotifyQuota() : Promise<Array<NotifyQuotaItem>> {
    // 并发去重：同一时刻只发一个请求，后到者共享结果
    const inFlight = quotaInFlight
    if (inFlight != null) return inFlight
    // 节流：短时间内直接复用本地缓存
    if (Date.now() - quotaFetchedAt < QUOTA_FETCH_MIN_INTERVAL) {
        const cached = readCachedQuota()
        if (cached.length > 0) return cached
    }
    const task = doFetchQuota()
    quotaInFlight = task
    return task
}

async function doFetchQuota() : Promise<Array<NotifyQuotaItem>> {
    try {
        const res = await getNotifyQuota()
        if (!isBusinessSuccessCode(res.code)) {
            console.warn('[notify] 拉取订阅额度失败:', res.msg)
            return readCachedQuota()
        }
        cacheQuota(res.data)
        quotaFetchedAt = Date.now()
        return res.data
    } catch (error) {
        console.warn('[notify] 拉取订阅额度异常:', error)
        return readCachedQuota()
    } finally {
        quotaInFlight = null
    }
}

/**
 * 查询订阅引导开关（GET /app/notify/status）
 * 后端用 data.enabled 控制首页订阅行的展示与否；查询失败 / 字段缺失按「隐藏」处理（fail-closed）
 */
export async function fetchNotifyStatusEnabled() : Promise<boolean> {
    try {
        const res = await getNotifyStatus()
        if (!isBusinessSuccessCode(res.code) || res.data == null) return false
        return res.data.getBoolean('enabled', false)
    } catch (error) {
        console.warn('[notify] 查询订阅开关失败:', error)
        return false
    }
}

function cacheQuota(list : Array<NotifyQuotaItem>) : void {
    try {
        uni.setStorageSync(QUOTA_STORAGE_KEY, JSON.stringify(list))
    } catch (error) {
        console.warn('[notify] 缓存订阅额度失败:', error)
    }
}

/**
 * 读取本地缓存的额度项；未拉取过时返回 null（调用方决定是否需要联网拉取）
 */
export function getCachedQuota(bizCode : string) : NotifyQuotaItem | null {
    const list = readCachedQuota()
    for (let i = 0; i < list.length; i++) {
        if (list[i].bizCode == bizCode) return list[i]
    }
    return null
}

function readCachedQuota() : Array<NotifyQuotaItem> {
    try {
        const raw = uni.getStorageSync(QUOTA_STORAGE_KEY)
        if (raw == null || raw.toString() == '') return []
        const parsed = JSON.parse(raw.toString()) as Array<any>
        const list : Array<NotifyQuotaItem> = []
        for (let i = 0; i < parsed.length; i++) {
            const row = parsed[i] as any
            list.push({
                bizCode: row.bizCode != null ? String(row.bizCode) : '',
                templateId: row.templateId != null ? String(row.templateId) : '',
                remaining: row.remaining != null ? Number(row.remaining) : -1,
                mode: row.mode != null ? String(row.mode) : ''
            })
        }
        return list
    } catch (error) {
        return []
    }
}

/**
 * 设备订阅授权（alarm 告警场景）
 * ⚠️ 必须在用户 tap 手势回调链内调用；deviceNo 传设备原始编号；snTicket 现取现用（5 分钟有效，不缓存）
 */
export async function authorizeDevice(deviceNo : string, bizCode : string = DEFAULT_BIZ_CODE) : Promise<DeviceAuthorizeOutcome> {
    if (!isDeviceSubscribeSupported()) {
        return { status: 'unsupported', errMsg: '当前微信版本不支持设备订阅', errCode: 0, templateId: '', sn: '', modelId: '' }
    }
    if (deviceNo == '') {
        return { status: 'fail', errMsg: '未选择设备', errCode: 0, templateId: '', sn: '', modelId: '' }
    }

    let item = getCachedQuota(bizCode)
    if (item == null) {
        await fetchNotifyQuota()
        item = getCachedQuota(bizCode)
    }
    if (item == null) {
        // 未配置模板的场景不会出现在 /quota 返回值中，按「隐藏引导 UI」处理，不算错误
        return { status: 'noTemplate', errMsg: '', errCode: 0, templateId: '', sn: '', modelId: '' }
    }
    if (item.mode != 'device') {
        return { status: 'noTemplate', errMsg: '当前场景未启用设备订阅', errCode: 0, templateId: item.templateId, sn: '', modelId: '' }
    }

    try {
        const ticketRes = await getDeviceTicket(deviceNo)
        if (!isBusinessSuccessCode(ticketRes.code) || ticketRes.data == null) {
            const msg = ticketRes.msg != '' ? ticketRes.msg : '获取设备票据失败，请稍后重试'
            console.warn('[notify] 换票失败:', msg)
            return { status: 'fail', errMsg: msg, errCode: 0, templateId: item.templateId, sn: '', modelId: '' }
        }
        const sn = ticketRes.data.getString('sn', '')
        const snTicket = ticketRes.data.getString('snTicket', '')
        const modelId = ticketRes.data.getString('modelId', '')
        const templateId = ticketRes.data.getString('templateId', '') != '' ? ticketRes.data.getString('templateId', '') : item.templateId
        if (sn == '' || snTicket == '' || templateId == '') {
            console.warn('[notify] 票据字段不完整:', ticketRes.data)
            return { status: 'fail', errMsg: '设备票据不完整，请稍后重试', errCode: 0, templateId: templateId, sn: sn, modelId: modelId }
        }
        // 换票返回的 sn 必须与下发侧完全一致，否则微信报 9800006（用户授权了但收不到通知）
        if (templateId != item.templateId) {
            console.warn('[notify] 换票模板与 /quota 模板不一致，订阅与下发可能不同源: quota=' + item.templateId + ', ticket=' + templateId)
        }
        if (modelId == '') {
            console.warn('[notify] 换票未返回 modelId，设备订阅可能被微信拒绝（19720736）')
        }
        // 订阅与下发必须同源同值，否则微信报 9800006
        const outcome = await callDeviceSubscribe(sn, snTicket, modelId, templateId)
        // 授权结果按「设备 + 模板」落库：微信不支持查询设备订阅状态，后续只能以这里为准
        if (isAcceptDeviceStatus(outcome.status) || outcome.status == 'reject') {
            saveDeviceSubscribeStatus(deviceNo, item.templateId, outcome.status)
        }
        return outcome
    } catch (error) {
        console.error('[notify] 设备订阅异常:', error)
        return { status: 'fail', errMsg: '订阅请求异常，请稍后重试', errCode: 0, templateId: item.templateId, sn: '', modelId: '' }
    }
}

/**
 * 围栏进出告警授权（专属模板「围栏进出通知」）
 *
 * 为什么单独一个通道：设备订阅模板（type=3）的关键词枚举由微信平台生成且封闭，
 * 本小程序在「设备管理」类目下的设备模板 enum 只有「超速/停留超时/震动/低电量」四值，
 * **无法表达"进入围栏/离开围栏"**。围栏告警因此改走长期订阅模板（含 phrase「活动状态」字段）。
 *
 * 该模板是「长期订阅」：用 wx.requestSubscribeMessage 授权（**不是** requestSubscribeDeviceMessage），
 * 一次授权长期可达、不消耗额度，也无需上报记账。
 * ⚠️ 必须在用户 tap 手势回调链内调用。
 */
export async function authorizeGeofence() : Promise<DeviceAuthorizeOutcome> {
    let item = getCachedQuota(GEOFENCE_BIZ_CODE)
    if (item == null) {
        await fetchNotifyQuota()
        item = getCachedQuota(GEOFENCE_BIZ_CODE)
    }
    if (item == null || item.templateId == '') {
        return { status: 'noTemplate', errMsg: '', errCode: 0, templateId: '', sn: '', modelId: '' }
    }
    return await callGeofenceAuthorize(item.templateId)
}

function callGeofenceAuthorize(templateId : string) : Promise<DeviceAuthorizeOutcome> {
    return new Promise((resolve) => {
        uni.requestSubscribeMessage({
            tmplIds: [templateId],
            success: (res : any) => {
                const resObj = res as UTSJSONObject
                const rawValue = resObj[templateId]
                const value = rawValue != null ? rawValue.toString() : ''
                let status : DeviceAuthorizeStatus = 'fail'
                if (value == 'accept') status = 'accept'
                else if (value == 'ban') status = 'ban'
                else if (value == 'filter') status = 'filter'
                // 授权成功后按本机记录（微信侧可能查不到该模板）
                if (status == 'accept') saveGeofenceSubscribed(templateId)
                // 未拿到该模板结果时按失败处理（可重试），不能当成「用户拒绝」
                resolve({ status: status, errMsg: status == 'fail' ? '未获取到授权结果，请重试' : '', errCode: 0, templateId: templateId, sn: '', modelId: '' })
            },
            fail: (err : any) => {
                const errObj = err as UTSJSONObject
                const rawErr = errObj['errMsg']
                const rawCode = errObj['errCode']
                const errMsg = rawErr != null ? rawErr.toString() : ''
                let errCode = 0
                if (rawCode != null) {
                    const parsed = parseInt(rawCode.toString())
                    if (!isNaN(parsed)) errCode = parsed
                }
                console.warn('[notify] 围栏订阅授权失败, errCode=' + errCode.toString() + ':', errMsg)
                resolve({ status: 'fail', errMsg: errMsg, errCode: errCode, templateId: templateId, sn: '', modelId: '' })
            }
        })
    })
}

function callDeviceSubscribe(sn : string, snTicket : string, modelId : string, templateId : string) : Promise<DeviceAuthorizeOutcome> {
    return new Promise((resolve) => {
        wx.requestSubscribeDeviceMessage({
            sn: sn,
            snTicket: snTicket,
            modelId: modelId,
            tmplIds: [templateId],
            success: (res : any) => {
                // wx 原生回调对象是普通 JS 对象，不是 UTSJSONObject，只能用索引访问，不能调 getString/getJSON
                const resObj = res as UTSJSONObject
                const rawValue = res != null ? resObj[templateId] : null
                const value = rawValue != null ? rawValue.toString() : ''
                const status = parseDeviceStatus(value)
                if (status == 'fail') {
                    // 未拿到该模板的授权结果：可能是基础库/机型兼容问题，绝不能当成「用户拒绝」落库
                    console.warn('[notify] 未取到设备订阅授权结果, templateId=' + templateId + ', value=' + value)
                    resolve({ status: 'fail', errMsg: '未获取到授权结果，请重试', errCode: 0, templateId: templateId, sn: sn, modelId: modelId })
                    return
                }
                resolve({ status: status, errMsg: '', errCode: 0, templateId: templateId, sn: sn, modelId: modelId })
            },
            fail: (err : any) => {
                const errObj = err as UTSJSONObject
                const rawErr = err != null ? errObj['errMsg'] : null
                const rawCode = err != null ? errObj['errCode'] : null
                const errMsg = rawErr != null ? rawErr.toString() : ''
                let errCode = 0
                if (rawCode != null) {
                    const parsed = parseInt(rawCode.toString())
                    if (!isNaN(parsed)) errCode = parsed
                }
                console.warn('[notify] 设备订阅授权失败, errCode=' + errCode.toString() + ':', errMsg)
                resolve({ status: 'fail', errMsg: normalizeDeviceError(errMsg, errCode), errCode: errCode, templateId: templateId, sn: sn, modelId: modelId })
            }
        })
    })
}

// 微信原生错误信息对用户不可读，按 errCode 优先转成可判断的中文提示（含排障线索）
// 错误码取值：wx.requestSubscribeDeviceMessage 官方错误码表
function normalizeDeviceError(errMsg : string, errCode : number) : string {
    if (errCode == 19720728) return '模板 ID 不存在，请核对后台模板配置'
    if (errCode == 19720736) return '设备型号与模板不匹配'
    if (errCode == 19720726 || errCode == 19720727) return '设备票据失效，请重试'
    if (errCode == 10001 || errCode == 20001) return '模板 ID 未配置'
    if (errCode == 20003) return '单次订阅模板数量超限'
    if (errCode == -12001 || errMsg.indexOf('invalid scope') >= 0) return '设备消息能力未开通，请联系客服'
    if (errMsg.indexOf('cancel') >= 0) return errMsg
    return errMsg
}

function parseDeviceStatus(value : string) : DeviceAuthorizeStatus {
    if (value == 'accept' || value == 'acceptWithAudio' || value == 'acceptWithAlert') return value as DeviceAuthorizeStatus
    if (value == 'reject') return 'reject'
    if (value == 'ban') return 'ban'
    if (value == 'filter') return 'filter'
    // 未知/空结果按失败处理：不能当成「用户拒绝」，否则会把可重试的异常永久记为拒绝，
    // 后续点击只会被引导去设置页，再也拿不到授权弹窗
    return 'fail'
}

/**
 * 【2026-11-04 修复】按「设备 + 模板」判定订阅状态
 *
 * 背景：微信的 `wx.getSetting(withSubscriptions)` 只按**模板**返回 itemSettings，
 * 不区分设备。原实现直接用它判定「已订阅」，导致多设备用户的必然缺陷：
 * 用户给 A 设备授权后，切到 B 设备时首页仍显示「已订阅」，
 * 点击直接走「去设置页关闭」分支，**永远不会为 B 发起授权** —— 表现为「明明开了订阅却收不到 B 的告警」。
 *
 * 修复口径：只认「本机为这台设备授权成功」的记录（见 getDeviceSubscribeStatus）。
 * 注意**不能**再叠加 checkTemplateSubscribed 兜底 —— 设备订阅模板不会出现在
 * itemSettings 里，叠加后恒为 false，「已订阅」永远显示不出来，用户会一直被重复拉起授权。
 */
export function checkDeviceSubscribed(deviceNo : string, templateId : string) : Promise<boolean> {
    return Promise.resolve(isAcceptDeviceStatus(getDeviceSubscribeStatus(deviceNo, templateId)))
}

/**
 * 查询某模板当前是否处于订阅状态（用户在设置页取消后会变为非 accept）
 */
export function checkTemplateSubscribed(templateId : string) : Promise<boolean> {
    return new Promise((resolve) => {
        if (templateId == '' || !isDeviceSubscribeSupported()) {
            resolve(false)
            return
        }
        wx.getSetting({
            withSubscriptions: true,
            success: (res : any) => {
                // wx 原生回调对象是普通 JS 对象，只能用索引访问，不能调 getJSON/getString
                try {
                    const resObj = res as UTSJSONObject
                    const settingRaw = res != null ? resObj['subscriptionsSetting'] : null
                    if (settingRaw == null) { resolve(false); return }
                    const setting = settingRaw as UTSJSONObject
                    const mainSwitch = setting['mainSwitch']
                    if (mainSwitch == false) { resolve(false); return }
                    const itemsRaw = setting['itemSettings']
                    if (itemsRaw == null) { resolve(false); return }
                    const items = itemsRaw as UTSJSONObject
                    const state = items[templateId]
                    resolve(state != null && state.toString() == 'accept')
                } catch (error) {
                    console.warn('[notify] 解析订阅状态失败:', error)
                    resolve(false)
                }
            },
            fail: () => resolve(false)
        })
    })
}

/**
 * 订阅消息总开关是否被关闭（用户在小程序设置里整体关闭「订阅消息」）。
 *
 * 重要：设备订阅消息（requestSubscribeDeviceMessage）的订阅状态**无法**通过
 * wx.getSetting().subscriptionsSetting.itemSettings 查询 —— 官方文档明确 itemSettings
 * 只返回「一次性订阅消息的模板 id / 系统订阅消息的类型」，且仅限用户勾选过
 * 「总是保持以上选择，不再询问」的项。设备订阅模板不会出现在其中，checkTemplateSubscribed
 * 对设备模板恒为 false。
 *
 * 因此设备订阅状态只能以「授权回调结果 + 本地缓存」为准，这里只兜底判断总开关是否被关掉。
 */
export function isSubscribeMainSwitchOff() : Promise<boolean> {
    return new Promise((resolve) => {
        try {
            wx.getSetting({
                withSubscriptions: true,
                success: (res : any) => {
                    const resObj = res as UTSJSONObject
                    const settingRaw = res != null ? resObj['subscriptionsSetting'] : null
                    if (settingRaw == null) { resolve(false); return }
                    const setting = settingRaw as UTSJSONObject
                    const mainSwitch = setting['mainSwitch']
                    resolve(mainSwitch == false)
                },
                fail: () => resolve(false)
            })
        } catch (error) {
            console.warn('[notify] 查询订阅总开关失败:', error)
            resolve(false)
        }
    })
}

/**
 * 一次性订阅授权（order / expire / share），成功后原样上报后端记账
 * ⚠️ 必须在用户 tap 手势回调链内调用，单次最多 3 个模板
 */
export async function requestSubscribeOnce(bizCodes : Array<string>) : Promise<UTSJSONObject | null> {
    if (bizCodes.length == 0) return null
    let list = readCachedQuota()
    if (list.length == 0) {
        list = await fetchNotifyQuota()
    }
    const tmplIds : Array<string> = []
    for (let i = 0; i < bizCodes.length && tmplIds.length < 3; i++) {
        for (let j = 0; j < list.length; j++) {
            if (list[j].bizCode == bizCodes[i] && list[j].mode == 'once' && list[j].templateId != '') {
                tmplIds.push(list[j].templateId)
                break
            }
        }
    }
    if (tmplIds.length == 0) return null
    return await callOnceSubscribe(tmplIds)
}

function callOnceSubscribe(tmplIds : Array<string>) : Promise<UTSJSONObject | null> {
    return new Promise((resolve) => {
        uni.requestSubscribeMessage({
            tmplIds: tmplIds,
            success: (res : any) => {
                const resObj = res as UTSJSONObject | null
                if (resObj != null) reportOnceResult(resObj)
                resolve(resObj)
            },
            fail: (err : any) => {
                console.warn('[notify] 一次性订阅授权失败:', err)
                resolve(null)
            }
        })
    })
}

async function reportOnceResult(result : UTSJSONObject) : Promise<void> {
    try {
        const res = await reportSubscribeResults(result)
        if (!isBusinessSuccessCode(res.code)) {
            console.warn('[notify] 订阅结果上报失败:', res.msg)
        }
    } catch (error) {
        console.warn('[notify] 订阅结果上报异常:', error)
    }
}
