<template>
	<view class="container">
		<custom-navBar title="停车记录" :show-back="true" backgroundColor="#fff" textColor="#333" :showCapsule="false">
		</custom-navBar>
		<view class="tools-panel">
			<view class="Datetime-box">
				<view class="date-box">
					<i-icon name="/static/rili.png" fontSize="15"></i-icon>
					<text class="Date" @click="showPicker('start')">{{startTime}}</text>
					<i-icon name="/static/xiangxia.png" fontSize="15" @click="showPicker('start')"></i-icon>
					<text style="padding: 0 10rpx;">至</text>
					<text class="Date" @click="showPicker('end')">{{endTime}}</text>
					<i-icon name="/static/xiangxia.png" fontSize="15" @click="showPicker('end')"></i-icon>
				</view>
			</view>
			<l-popup v-model="showDateTimePicker" position="bottom" :closeable="false">
				<l-date-time-picker confirm-btn="确认" cancel-btn="取消" :title="pickerTitle" :mode="63" :start="pickerMinTime" :end="pickerMaxTime" :value="pickerValue"
					@confirm="onConfirm" @cancel="onCancel">
				</l-date-time-picker>
			</l-popup>
		</view>
		<!-- <view class="mileage_title">
			<text>设备名称</text>
		</view> -->
		<scroll-view class="content-box" scroll-y="true">
			<i-empty text="当前时间暂无停车数据" :showButton="false" description="" v-if="sortedCarStopDetail.length == 0" ></i-empty>
			<view v-else>
				<!-- 主列表：长停（无 stopType 时全部记录都落在这里，行为与旧版一致） -->
				<view class="content" v-for="(item,index) in longStops" :key="'long-'+index">
					<view class="item">
						<image class="icons" mode="aspectFit" src="/static/startTime.png" />
						<text>{{item.startTime}}</text>
					</view>
					<view class="item">
						<image class="icons" mode="aspectFit" src="/static/endTime.png" />
						<text>{{item.endTime}}</text>
					</view>
					<view class="item">
						<image class="icons" mode="aspectFit" src="/static/stopTime.png" />
						<text>停留 {{calculateDuration(item.getNumber('duration', 0))}}</text>
					</view>
					<view class="item">
						<image class="icons" mode="aspectFit" src="/static/user_location.png" />
						<text class="address" v-if="item.address">{{item.address || '加载中...'}}</text>
						<text v-else @click="showAddress(item.getNumber('latitude', 0), item.getNumber('longitude', 0))">点击查看停车位置</text>
					</view>
				</view>
				<!-- 短停折叠条：只折叠、不过滤，展开后仍可逐条查看 -->
				<view class="short-fold" v-if="shortStops.length > 0" @click="toggleShort">
					<text class="short-fold-text">{{ shortFoldText() }}</text>
					<text class="short-fold-action">{{ shortExpanded ? '收起' : '展开' }}</text>
				</view>
				<template v-if="shortExpanded">
					<view class="content" v-for="(item,index) in shortStops" :key="'short-'+index">
						<view class="item">
							<image class="icons" mode="aspectFit" src="/static/startTime.png" />
							<text>{{item.startTime}}</text>
						</view>
						<view class="item">
							<image class="icons" mode="aspectFit" src="/static/endTime.png" />
							<text>{{item.endTime}}</text>
						</view>
						<view class="item">
							<image class="icons" mode="aspectFit" src="/static/stopTime.png" />
							<text>停留 {{calculateDuration(item.getNumber('duration', 0))}}</text>
						</view>
						<view class="item">
							<image class="icons" mode="aspectFit" src="/static/user_location.png" />
							<text class="address" v-if="item.address">{{item.address || '加载中...'}}</text>
							<text v-else @click="showAddress(item.getNumber('latitude', 0), item.getNumber('longitude', 0))">点击查看停车位置</text>
						</view>
					</view>
				</template>
			</view>
		</scroll-view>
	</view>
	<app-toast></app-toast>
</template>

<script setup lang="uts">
import { isBusinessSuccessCode } from '../../api/response.uts'
import { showAppToast } from '../../utils/toast.uts'
import { openLocation } from '../../utils/openLocation.uts'
	import { ref, reactive, onMounted, computed } from 'vue'
	import { getTrackPos } from '../../api/request.uts'
	import { formatTimes, parseLocalDateTime } from '../../utils/formateTime.uts'
	import { getAddress } from '../../utils/getAdress.uts'
	// 导入坐标转换插件
	import CoordTransform from '../../utils/coordTransform.uts'

	const carStatus = ref('在线')

	// 日期时间选择器相关
	const showDateTimePicker = ref(false)
	const currentPickerType = ref('start')
	const pickerTitle = ref('选择开始时间')

	const startTime = ref('')
	const endTime = ref('')
	const deviceNo = ref<string | null>('')
	type StopRecord = UTSJSONObject
	const carStopDetail = ref<Array<StopRecord>>([])
	const getStopNumber = (item: UTSJSONObject, key: string): number => item.getNumber(key, 0)
	const getStopText = (item: UTSJSONObject, key: string): string => item.getString(key, '')

	// 计算属性：按照时间倒序排列的停车记录
	const sortedCarStopDetail = computed((): Array<StopRecord> => {
		const sorted = carStopDetail.value.slice()
		sorted.sort((a: StopRecord, b: StopRecord): number => {
			const timeA = parseLocalDateTime(a.getString('endTime', ''))
			const timeB = parseLocalDateTime(b.getString('endTime', ''))
			if (timeA == null) return timeB == null ? 0 : 1
			if (timeB == null) return -1
			return timeB - timeA // 倒序排列
		})
		return sorted
	})

	// 依据 stopType 细分：主列表只放非 SHORT；SHORT 折叠展示（只折叠、不过滤，数据不丢）。
	// 后端未返回 stopType 时（当前仓库即为该情况），所有记录 stopType 均为空串，会全部留在主列表，行为与旧版完全一致。
	const longStops = computed((): Array<StopRecord> => {
		return sortedCarStopDetail.value.filter((item: StopRecord): boolean => item.getString('stopType', '') != 'SHORT')
	})
	const shortStops = computed((): Array<StopRecord> => {
		return sortedCarStopDetail.value.filter((item: StopRecord): boolean => item.getString('stopType', '') == 'SHORT')
	})
	const shortExpanded = ref(false)
	const toggleShort = (): void => {
		shortExpanded.value = !shortExpanded.value
	}
	// 折叠条用的紧凑时长（duration 与列表 calculateDuration 口径一致，按毫秒处理）
	const formatShortDuration = (ms: number): string => {
		const totalMinutes = Math.floor(ms / 60000)
		if (totalMinutes >= 60) {
			const h = Math.floor(totalMinutes / 60)
			const m = totalMinutes % 60
			return `${h}小时${m}分`
		}
		if (totalMinutes > 0) return `${totalMinutes}分钟`
		return '不足1分钟'
	}
	const shortFoldText = (): string => {
		let total = 0
		shortStops.value.forEach((item: StopRecord): void => {
			total += item.getNumber('duration', 0)
		})
		return `本段行程含 ${shortStops.value.length} 次短暂停留，累计 ${formatShortDuration(total)}`
	}

	onLoad((option) => {
		deviceNo.value = option.deviceNo
	})

	const initDateTime = () => {
		const now = new Date()
		endTime.value = formatTimes(now.getTime())
		// 开始时间默认为当前时间前24小时
		startTime.value = formatTimes(now.getTime() - 3600000 * 24)
	}


	const pickerValue = computed(() : string => {
		return currentPickerType.value == 'start' ? startTime.value : endTime.value
	})

	const pickerMinTime = computed(() => {
		const now = new Date()
		return new Date(
			now.getFullYear(),
			now.getMonth() - 6,
			now.getDate(),
			0, 0, 0
		).getTime()
	})

	// 最大日期（当前时间）
	const pickerMaxTime = computed(() => {
		return Date.now()
	})

	const loadStopData = async () : Promise<void> => {
		uni.showLoading({
			title: '加载中...'
		})
		const data = {
			deviceNo: deviceNo.value,
			startTime: startTime.value,
			endTime: endTime.value,
			// 单位是「秒」（后端按秒解析）：传 2 会被当成 2 秒，停车段全被判成 LONG、行程被切碎
			minParkTime: 300,
			withStop: true,
			withPos: false,
			withTrip: false
		} as UTSJSONObject
		try {
			const res = await getTrackPos(data)
			const trackData = res.data
			if (!isBusinessSuccessCode(res.code) || trackData == null) {
				showAppToast({ title: res.msg || '数据加载失败', icon: 'none' })
				carStopDetail.value = []
				return
			}
			const stopsWithAddress : Array<StopRecord> = []
			const stops = trackData.getArray<UTSJSONObject>('stops') ?? []
			stops.forEach((stop : UTSJSONObject) : void => {
				const convertedCoord = CoordTransform.wgs84ToTencent(stop.getNumber('latitude', 0), stop.getNumber('longitude', 0))
				stop.set('latitude', convertedCoord.lat)
				stop.set('longitude', convertedCoord.lng)
				stopsWithAddress.push(stop)
			})
			carStopDetail.value = stopsWithAddress
		} catch (error) {
			console.error('获取停车数据失败:', error)
			showAppToast({ title: '数据加载失败', icon: 'none' })
		} finally {
			uni.hideLoading()
		}
	}

	// 初始化加载
	onMounted(() => {
		initDateTime()
		loadStopData()
	})

	// 显示日期时间选择器
	const showPicker = (type : string) => {
		currentPickerType.value = type
		pickerTitle.value = type === 'start' ? '选择开始时间' : '选择结束时间'
		showDateTimePicker.value = true
	}

	// 确认选择时间
	const onConfirm = (value : string) => {
		if (currentPickerType.value === 'start') {
			startTime.value = value
		} else {
			endTime.value = value
		}
		loadStopData()
		showDateTimePicker.value = false
	}

	const onCancel = () => {
		showDateTimePicker.value = false
	}

	const calculateDuration = (diff:number) : string => {
		const hours = Math.floor(diff / (1000 * 60 * 60))
		const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60))
		const seconds = Math.floor((diff % (1000 * 60)) / 1000)

		return `${hours}小时${minutes}分${seconds}秒`
	}

	const showAddress = (latitude : number, longitude : number) => {
		openLocation({
			latitude: latitude,
			longitude: longitude,
			name: '停车位置'
		})
	}
</script>

<style lang="scss">
	.container {
		height: 100%;
		display: flex;
		flex-direction: column;
		background-color: #f5f7fa;

		.tools-panel {
			background-color: #fff;
			border: 1rpx solid #69c2f1;
			padding: 20rpx;
			margin: 20rpx;
			border-radius: 20rpx;

			.Datetime-box {
				display: flex;
				flex-direction: row;
				justify-content: center;
				align-items: center;

				.date-box {
					width: 100%;
					display: flex;
					flex-direction: row;
					justify-content: space-between;
					align-items: center;

					.Date {
						font-size: 25rpx;
						border-radius: 5rpx;
					}
				}
			}
		}

		.mileage_title {
			margin: 20rpx 40rpx 0;
			padding: 20rpx;
			display: flex;
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
		}

		.content-box{
			flex: 1;
			min-height: 0;
			margin-bottom: 30rpx;
		}

		.short-fold {
			display: flex;
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
			margin: 0 40rpx 20rpx;
			padding: 24rpx 30rpx;
			background-color: #eef6fd;
			border-radius: 15rpx;

			.short-fold-text {
				font-size: 26rpx;
				color: #5b92cc;
				flex: 1;
			}

			.short-fold-action {
				font-size: 26rpx;
				color: #3485df;
				margin-left: 20rpx;
			}
		}

		.content {
			@extend .mileage_title;
			background-color: #fff;
			border-radius: 15rpx;
			margin-bottom: 20rpx;
			display: flex;
			flex-direction: column;
			justify-content: flex-start;
			align-items: flex-start;

			.item {
				display: flex;
				flex-direction: row;
				align-items: center;
				padding: 15rpx 0;

				.icons {
					width: 40rpx;
					height: 40rpx;
					margin-right: 15rpx;
				}

			}
		}
	}
</style>