<template>
	<view class="container">
		<custom-navBar title="个人中心" :show-back="false" backgroundColor="#fff" textColor="#333" :showCapsule="false">
		</custom-navBar>
		<view class="user-info-box" @click="userInfoDetail">
			<view class="userinfo">
				<view>
					<i-icon name="/static/avatar.png" fontSize="40"></i-icon>
				</view>
				<view class="user-info">
					<text v-if="Login">{{userInfo.mobile}}</text>
					<text v-else>点击登录</text>
				</view>
			</view>
			<i-icon name="/static/arrow-right.png" fontSize="15"></i-icon>
		</view>
		<view v-if="Login">
			<view class="list" @click="carList">
				<view class="left">
					<text>我的车辆</text>
					<text class="badge"><i-badge type="danger" maxCount="99" :count="carsnumber"></i-badge></text>
				</view>
				<i-icon name="/static/arrow-right.png" fontSize="15"></i-icon>
			</view>
			<view class="list" @click="platformRenewal">平台续费</view>
			<!-- <view class="list" @click="productMall">产品商城</view> -->
		</view>
		<view class="version" v-if="version">当前版本：{{version}}</view>
		<movable-area class="movable-area" v-if="csEnabled">
			<movable-view
				class="movable-view"
				direction="all"
				:x="moveX"
				:y="moveY"
				@change="onMoveChange"
			>
				<view class="contact-button-movable" @click="contactCustomerService">
					<!-- 客服 logo 统一用 service.png；不设底色/圆角，只展示图形本身 -->
					<image src="/static/service.png" mode="aspectFit" style="width: 48px; height: 48px; background-color: transparent;" />
					<text class="contact-text">人工客服</text>
					<!-- 服务时间由后台下发，未配置则不展示（不再写死 08:00-24:00） -->
					<text class="contact-text" v-if="customerServiceConfig.serviceTime.length > 0">{{customerServiceConfig.serviceTime}}</text>
				</view>
			</movable-view>
		</movable-area>
	</view>
	<!-- 客服降级弹框：企业微信客服不可用 / 仅配置手机号与二维码时展示 -->
	<customerServicePopup v-model:show="showCustomerServicePopup" :qrcode="customerServiceConfig.serviceQrcode"
		:phones="csPhones" :serviceTime="customerServiceConfig.serviceTime"
		@qrcodeError="refreshCustomerService"></customerServicePopup>
	<app-toast></app-toast>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { isBusinessSuccessCode } from '../../api/response.uts'
import { showAppToast } from '../../utils/toast.uts'
	import { getUserInfo, getUserDeviceList, getCustomerServiceConfig } from '../../api/request';
	import { buildCustomerServiceConfig, emptyCustomerService, getCurrentAppId, hasAnyChannel, legacyCustomerService, openCustomerService, splitServicePhones } from '../../common/customerService.uts'
	import type { CustomerServiceConfig } from '../../common/customerService.uts'
	import customerServicePopup from '../../components/customerServicePopup.uvue'

	const userInfo = ref({
		avatar: '/static/avatar.png',
		nickname: '',
	})
	const carsnumber = ref(0)
	const Login = ref(false)
	const version = ref('')

	// 客服配置（接口下发）：全未配置时入口不渲染
	const customerServiceConfig = ref<CustomerServiceConfig>(emptyCustomerService())
	const showCustomerServicePopup = ref(false)
	const csEnabled = computed<boolean>(() => hasAnyChannel(customerServiceConfig.value))
	const csPhones = computed<string[]>(() => splitServicePhones(customerServiceConfig.value))
	// onShow 与弹框错误重试可能同时触发，避免重复请求
	let customerServiceLoading = false

	// 可拖拽相关变量
	const moveX = ref(0)
	const moveY = ref(0)
	const windowWidth = ref(0)
	const windowHeight = ref(0)
	const buttonWidth = 120
	const buttonHeight = 200

	// 加载数据
	const loadData = async () => {
		const params = {} as UTSJSONObject
		try {
			const res = await getUserInfo()
			if (isBusinessSuccessCode(res.code) && res.data != null) {
				userInfo.value = {
					avatar: res.data.getString('avatar', '/static/avatar.png'),
					nickname: res.data.getString('nickname', '')
				}
			} else {
				showAppToast({ title: res.msg || '获取用户信息失败', icon: 'none' })
			}

			const resCars = await getUserDeviceList(params)
			if (isBusinessSuccessCode(resCars.code) && resCars.data != null) {
				carsnumber.value = resCars.data.totalCount
			} else {
				showAppToast({ title: resCars.msg || '获取车辆数量失败', icon: 'none' })
			}
		} catch (error) {
			console.error('加载用户中心数据失败:', error)
			showAppToast({ title: '加载用户信息失败', icon: 'none' })
		}
	}

	onShow(() => {
		// 获取窗口尺寸
		const systemInfo = uni.getSystemInfoSync()
		windowWidth.value = systemInfo.windowWidth
		windowHeight.value = systemInfo.windowHeight

		// 设置初始位置
		moveX.value = windowWidth.value - buttonWidth - 20
		moveY.value = windowHeight.value - buttonHeight - 20

		// 如果有 token，加载用户信息
		const token = uni.getStorageSync('token')
		if (token) {
			Login.value = true
			loadData()
		} else {
			Login.value = false
		}

		// 获取小程序版本号
		const accountInfo = wx.getAccountInfoSync();
		const appVersion = accountInfo.miniProgram.version;
		version.value = appVersion

		// 客服配置：服务时间与渠道由后台下发
		loadCustomerServiceConfig()
	})

	// 联系客服：按「客服地址 → 企业微信客服 → 手机号/二维码」统一降级
	const contactCustomerService = () => {
		openCustomerService(customerServiceConfig.value, () => {
			showCustomerServicePopup.value = true
		})
	}

	/** 拉取客服配置：onShow 预取，点击时直接用内存值（TAP 回调内不能发请求） */
	const loadCustomerServiceConfig = async () => {
		if (customerServiceLoading) return
		customerServiceLoading = true
		try {
			const res = await getCustomerServiceConfig(getCurrentAppId())
			if (isBusinessSuccessCode(res.code)) {
				// 接口成功即以后端为准：字段全空表示运营主动清空，入口必须隐藏
				customerServiceConfig.value = buildCustomerServiceConfig(res.data)
			}
		} catch (e) {
			// 请求异常：沿用改造前写死的企微客服，避免发版后入口凭空消失
			console.error('获取客服配置失败，沿用改造前的企业微信客服兜底:', e)
			if (!hasAnyChannel(customerServiceConfig.value)) {
				customerServiceConfig.value = legacyCustomerService()
			}
		} finally {
			customerServiceLoading = false
		}
	}

	/** 弹框二维码 403/加载失败：重新拉配置换一条新签名地址 */
	const refreshCustomerService = () => {
		void loadCustomerServiceConfig()
	}


	const onMoveChange = (e : UTSJSONObject) => {
		const detail = e.getJSON('detail')
		const x = detail != null ? detail.getNumber('x', 0) : 0
		const y = detail != null ? detail.getNumber('y', 0) : 0
		const maxX = windowWidth.value - buttonWidth
		const maxY = windowHeight.value - buttonHeight

		// 边界限制，防止拖出屏幕
		if (x < 0 || x > maxX || y < 0 || y > maxY) {
			moveX.value = Math.max(0, Math.min(maxX, x))
			moveY.value = Math.max(0, Math.min(maxY, y))
		}
	}

	// 用户信息详情
	const userInfoDetail = () => {
		if (Login.value) {
			uni.navigateTo({
				url: '/pages/userCenter/userInfo/userInfo?userInfo=' + encodeURIComponent(JSON.stringify(userInfo.value))
			})
		} else {
			uni.navigateTo({
				url: '/pages/login/login'
			})
		}
	}

	// 我的车辆
	const carList = () => {
		if (Login.value) {
			uni.navigateTo({
				url: '/pages/userCenter/carList/carList'
			})
		} else {
			showAppToast({
				title: '请先登录',
				icon: 'none',
			})
		}
	}

	// 平台续费
	const platformRenewal = () => {
		if (Login.value) {
			uni.navigateTo({
				url: '/pages/userCenter/payDeviceList/payDeviceList'
			})
		} else {
			showAppToast({
				title: '请先登录',
				icon: 'none',
			})
		}
	}

	// 产品商城
	const productMall = () => {
		if (Login.value) {
			// 跳转到网页容器页面
			uni.navigateTo({
				url: '/pages/webview/webview?url=' + encodeURIComponent('https://shop.zdiot.cn/')
			})
		} else {
			showAppToast({
				title: '请先登录',
				icon: 'none',
			})
		}
	}
</script>

<style lang="scss">
	.container {
		width: 100%;
		height: 100%;
		background-color: #fff;
		position: relative;

		.user-info-box {
			width: 100%;
			padding: 40rpx 60rpx;
			display: flex;
			flex-direction: row;
			justify-content: space-between;
			align-items: center;

			.userinfo {
				display: flex;
				flex-direction: row;
				justify-content: flex-start;
				align-items: center;
				flex: 1;
			}

			.user-info {
				margin-left: 20rpx;
				text-align: center;
				font-size: 30rpx;
				color: #333;
			}
		}

		.list {
			background-color: #f5f5f5;
			padding: 30rpx;
			border-radius: 20rpx;
			margin: 15rpx;
			display: flex;
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
			font-size: 25rpx;

			.left {
				display: flex;
				flex-direction: row;
				justify-content: space-between;
				align-items: center;

				.badge {
					margin-left: 20rpx;
				}
			}
		}

		.version {
			position: fixed;
			bottom: 50rpx;
			left: 20rpx;
			right: 20rpx;
			text-align: center;
			font-size: 25rpx;
			color: #c3c2c2ff;
			margin: 20rpx 40rpx 0;
		}

		// 可移动区域样式
		.movable-area {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			width: 100%;
			height: 100%;
			pointer-events: none;
			z-index: 999;

		}

		// movable-view 必须显式给宽高：uni-app x 下不给尺寸会退化成极小区域，
		// 里面的「客服 logo + 人工客服」会被容器裁掉一半（看起来像贴边半隐藏）。
		// 尺寸与脚本里的 buttonWidth / buttonHeight 保持一致，保证拖动边界算得准。
		.movable-view {
			width: 120px;
			height: 200px;
			pointer-events: auto;
		}

		// 客服按钮内容：纵向居中，背景透明（只展示 logo 本身）
		.contact-button-movable {
			width: 120px;
			height: 200px;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			background-color: transparent;
		}

		.contact-text {
			font-size: 12px;
			color: #1f2937;
			margin-top: 4px;
		}
	}
</style>