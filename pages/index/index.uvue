}

// 底部「选择车辆」弹框
// l-popup 放在根 scroll-view 之外：嵌在页面滚动容器里会形成 scroll-view 套 scroll-view，
// 外层可能抢走竖向手势或让背景页面跟着一起滚。
// 白底 / 顶部圆角 / 底部安全区由 l-popup 的 bg-color、radius、safe-area-inset-bottom 提供，
// 这里不要再给 .car-picker 设背景和圆角，否则会盖掉 l-popup 的圆角。
.car-picker {
    width: 100%;
    // 固定高度由行内样式按屏幕高度的 60% 覆盖；flex 列布局让列表区域自适应填满剩余空间
    height: 900rpx;
    display: flex;
    flex-direction: column;
    padding-top: 30rpx;

    // 标题 + 检索框 并排：标题居左，检索框居右
    .car-picker-header {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 0 40rpx 20rpx 40rpx;
    }

    .car-picker-title {
        font-size: 34rpx;
        font-weight: 600;
        color: #333333;
        text-align: left;
    }

    // 检索输入框
    .car-picker-search {
        flex: 1;
        margin-left: 50rpx;
    }

    // 列表区域自适应填满弹框剩余空间，超出后内部滚动（行内 maxHeight 作为安全上限）
    .car-picker-list {
        flex: 1;
        min-height: 0;
        max-height: 900rpx;
    }

    // 检索无结果
    .car-picker-empty {
        padding: 60rpx 0;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;

        .car-picker-empty-text {
            font-size: 28rpx;
            color: #9A9A9A;
        }
    }

    .car-picker-item {
        padding: 30rpx 40rpx;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        border-top-width: 1rpx;
        border-top-style: solid;
        border-top-color: #F0EAEA;
    }

    .car-picker-item-name {
        flex: 1;
        min-width: 0;
        padding-right: 20rpx;
        font-size: 32rpx;
        color: #333333;
    }

    // 当前选中设备：名称高亮
    .car-picker-item-name--active {
        color: #3C6ECF;
    }

    .car-picker-item-status {
        flex-shrink: 0;
        display: flex;
        flex-direction: row;
        align-items: center;
    }

    .car-picker-dot {
        width: 14rpx;
        height: 14rpx;
        border-radius: 50%;
    }

    .car-picker-dot--online {
        background-color: #5BBF6A;
    }

    .car-picker-dot--offline {
        background-color: #9A9A9A;
    }

    .car-picker-status-text {
        margin-left: 10rpx;
        font-size: 28rpx;
    }

    .car-picker-status-text--online {
        color: #5BBF6A;
    }

    .car-picker-status-text--offline {
        color: #9A9A9A;
    }

    .car-picker-cancel {
        padding: 32rpx 0;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        border-top-width: 1rpx;
        border-top-style: solid;
        border-top-color: #F0EAEA;

        .car-picker-cancel-text {
            font-size: 32rpx;
            color: #333333;
        }
    }
}
</style>