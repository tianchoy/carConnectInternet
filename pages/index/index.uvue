<template>
    <!--
      scroll-y 在弹框打开时置为 false：
      仅把弹框移出滚动容器仍会被穿透，真机上滑动列表时页面会跟着滚，
      这里直接在弹框打开期间锁死页面滚动（此时页面被遮罩盖住，本来也不该滚）。
    -->
    <scroll-view class="container" :scroll-y="showPicker ? 'false' : 'true'" :show-scrollbar="false">
        <view class="page-bg">
            <view class="top" :style="{paddingTop: statusBarHeight + 43 + 'px'}">
                <view class="device-car">
                    <!-- 整条（除右侧三个按钮外）都是选择设备的触发区域，下三角紧贴设备名 -->
                    <view class="current-car" @click="handlePicker">
                        <view v-if="checkToken()">
                            <text v-if="currentCarName" class="car-id">{{currentCarName ?? '加载中…'}}</text>
                            <text v-else class="car-id">暂无设备</text>
                        </view>
                        <text v-else class="login" @click.stop="gotoLogin">点击登录!</text>
                        <i-icon name="/static/right-bottom.png" fontSize="7"></i-icon>
                    </view>
                    <view class="nav-tools">
                        <i-icon name="/static/reload.png" fontSize="24" @click="handleReload"></i-icon>
                        <i-icon class="nav-tool-spacing" name="/static/maps.png" fontSize="20"  @click="toDeviceList"></i-icon>
                        <view class="nav-tool-spacing nav-tool-add" @click="toAdd">
                            <i-icon name="/static/addNew.png" fontSize="24"></i-icon>
                        </view>
                    </view>
                </view>
                <view class="banner">
                    <image src="../../static/banner.png" mode="aspectFit" class="banner-image"></image>
                </view>
                <view class="subscribe-row" v-if="subscribeAvailable && checkToken() && hasDevice" @click="handleSubscribeTap">
                    <image src="../../static/msg.png" mode="aspectFit" class="subscribe-icon"></image>
                    <view class="subscribe-text">
                        <text class="subscribe-title">车辆告警通知</text>
                        <text class="subscribe-desc">{{ subscribeRowDesc }}</text>
                    </view>
                    <view class="subscribe-btn" :class="{ 'subscribed': deviceSubscribed && geofenceSubscribed }">
                        <text class="subscribe-btn-text">{{ subscribeBtnText }}</text>
                    </view>
                </view>
                <view class="car-state">
                    <view class="state-item">
                        <text class="state-label">设备状态</text>
                        <text class="state-value" :class="{'online': hasDevice && safeDeviceDetail.connectionStatus == 'online'}">
                            {{hasDevice ? (safeDeviceDetail.connectionStatus == 'online' ? '在线' : '离线') : '--'}}
                        </text>
                    </view>
                    <view class="state-item">
                        <text class="state-label">最后定位</text>
                        <text class="state-value">{{ hasDevice ? devicePositionUpdateTime : '暂无位置' }}</text>
                    </view>
                </view>
            </view>
            <view class="content">
                <view class="map-box">
                    <view class="map-header">
                        <text class="map-title">车辆定位</text>
                        <view class="map-refresh-wrap" @click="refreshLocation">
                            <text class="map-refresh">刷新定位</text>
                        </view>
                    </view>
                    <view class="map-container">
                        <map
                            v-if="isMapReady"
                            id="myMap"
                            :latitude="center.latitude"
                            :longitude="center.longitude"
                            :scale="mapScale"
                            style="width:100%;height:100%"
                            :show-location="false"
                            :enable-traffic="true"
                            :enable-overlooking="true"
                            :enable-building="true"
                            :enable-3D="false"
                            :markers="markers"
                            >
                        </map>
                    </view>
                </view>
                <view class="mile-record">
                    <view class="record-header">
                        <text class="record-title">轨迹记录</text>
                        <view class="record-desc-wrap" @click="toRecordDetail">
                            <text class="record-desc">更多轨迹</text>
                        </view>
                    </view>
                    <view class="ring-container">
                        <view class="ring-item">
                            <view class="ring-bg green">
                                <view class="ring-quarter ring-quarter--top-left">
                                    <view class="ring-stroke ring-stroke--track"></view>
                                </view>
                                <view class="ring-quarter ring-quarter--top-right">
                                    <view class="ring-stroke ring-stroke--active"></view>
                                </view>
                                <view class="ring-quarter ring-quarter--bottom-right">
                                    <view class="ring-stroke ring-stroke--active"></view>
                                </view>
                                <view class="ring-quarter ring-quarter--bottom-left">
                                    <view class="ring-stroke ring-stroke--active"></view>
                                </view>
                            </view>
                            <view class="ring-text">
                                <text class="unit">条</text>
                                <text class="num">{{totalTrips}}</text>
                                <text class="label">今日轨迹</text>
                            </view>
                        </view>
                        <view class="ring-item">
                            <view class="ring-bg orange">
                                <view class="ring-quarter ring-quarter--top-left">
                                    <view class="ring-stroke ring-stroke--track"></view>
                                </view>
                                <view class="ring-quarter ring-quarter--top-right">
                                    <view class="ring-stroke ring-stroke--active"></view>
                                </view>
                                <view class="ring-quarter ring-quarter--bottom-right">
                                    <view class="ring-stroke ring-stroke--active"></view>
                                </view>
                                <view class="ring-quarter ring-quarter--bottom-left">
                                    <view class="ring-stroke ring-stroke--active"></view>
                                </view>
                            </view>
                            <view class="ring-text">
                                <text class="unit">km</text>
                                <text class="num">{{(totalMileage/1000).toFixed(2)}}</text>
                                <text class="label">今日里程</text>
                            </view>
                        </view>
                    </view>
                </view>
                <view class="device-list">
                    <view class="device-item"  @click="toDeviceDetail">
                        <view class="item-label">
                            <view class="icon icon-device"><image src="../../static/pos.png" mode="aspectFill" class="icon-image"></image></view>
                            <view class="item-info">
                                <text class="item-title">设备详情</text>
                                <text class="item-desc">查看设备更多详情</text>
                            </view>
                        </view>
                        <i-icon name="/static/arrow-right.png" fontSize="15"></i-icon>
                    </view>
                    <view class="device-item" @click="toFindCar">
                        <view class="item-label">
                            <view class="icon icon-car"><image src="../../static/car.png" mode="aspectFill" class="icon-image"></image></view>
                            <view class="item-info">
                                <text class="item-title">一键寻车</text>
                                <text class="item-desc">点击立即寻找车辆位置</text>
                            </view>
                        </view>
                        <i-icon name="/static/arrow-right.png" fontSize="15"></i-icon>
                    </view>
                    <view class="device-item" @click="toFence">
                        <view class="item-label">
                            <view class="icon icon-fence"><image src="../../static/dzwl.png" mode="aspectFill" class="icon-image"></image></view>
                            <view class="item-info">
                                <text class="item-title">电子围栏</text>
                                <text class="item-desc">点击去设置或者查看电子围栏</text>
                            </view>
                        </view>
                        <i-icon name="/static/arrow-right.png" fontSize="15"></i-icon>
                    </view>
                </view>
                <view class="service">
                    <text class="service-header">服务中心</text>
                    <view class="service-content">
                        <view class="service-item" @click="toMsgCenter">
                            <view class="message-icon-wrap">
                                <image src="../../static/msg.png" mode="aspectFit" class="icon-image"></image>
                                <text v-if="unreadMessageCount > 0" class="message-unread-badge">{{unreadMessageBadgeText}}</text>
                            </view>
                            <text class="item-title">警报消息</text>
                        </view>
                        <view class="service-item" @tap="toPay(currentCarIccId)">
                            <image src="../../static/pay.png" mode="aspectFit" class="icon-image"></image>
                            <text class="item-title">一键续费</text>
                        </view>
                        <view class="service-item" @click="unbindDevice">
                            <image src="../../static/del.png" mode="aspectFit" class="icon-image"></image>
                            <text class="item-title" style="color: #d81e06;">删除设备</text>
                        </view>
                        <view class="service-item" @click="logout">
                            <image src="../../static/logout.png" mode="aspectFit" class="icon-image"></image>
                            <text class="item-title" style="color: #EE793A;">退出登录</text>
                        </view>
                    </view>
                </view>
            </view>
        </view>
    </scroll-view>
    <!--
      在线客服悬浮球：放在根 scroll-view 之外（scroll-view 内的 fixed 会跟着内容一起滚）。
      拖动与点击都在页面内实现：轻点进企业微信客服，拖动只移动位置（位移超 8px 不算点击）。
    -->
    <view
        v-if="csEnabled"
        class="cs-float"
        :style="{ left: csFabLeft + 'px', top: csFabTop + 'px', transition: csFabDragging ? 'none' : 'left 0.3s ease' }"
        @touchstart="onCsFabTouchStart"
        @touchmove.stop="onCsFabTouchMove"
        @touchend="onCsFabTouchEnd"
        @click="onCsFabClick"
    >
        <!-- 背景透明：只展示客服 logo 本身，不套白底方块；跳动动画走 .cs-fab-icon -->
        <image
            src="/static/service.png"
            mode="aspectFit"
            class="cs-fab-icon"
            style="width: 48px; height: 48px; background-color: transparent;"
        ></image>
    </view>
    <!--
      选择车辆弹框：必须放在根 scroll-view 之外。
      嵌在页面滚动容器里会形成 scroll-view 套 scroll-view，
      外层可能抢走竖向手势或让背景页面跟着一起滚。
      destroy-on-close：关闭即销毁，设备多时列表节点不会常驻内存。
    -->
    <l-popup
        v-model="showPicker"
        position="bottom"
        :closeable="false"
        :safe-area-inset-bottom="true"
        :destroy-on-close="true"
        :radius="16"
        bg-color="#ffffff"
    >
        <!-- touchmove.stop：截断 touchmove 向上传播，第二道防穿透 -->
        <view class="car-picker" @touchmove.stop :style="{ height: pickerPanelHeight + 'px' }">
            <view class="car-picker-header">
                <text class="car-picker-title">选择车辆</text>
                <view class="car-picker-search">
                    <i-input
                        v-model="pickerSearchKeyword"
                        placeholder="搜索设备名称 / 车牌号 / 设备号"
                        clearable
                        height="72rpx"
                        round="36rpx"
                        border="none"
                        bg-color="#f2f3f5"
                        font-size="13px"
                    >
                        <template #prefix>
                            <i-icon name="search" color="#999999" customStyle="margin-right: 12rpx;" />
                        </template>
                    </i-input>
                </view>
            </view>
            <scroll-view
                class="car-picker-list"
                scroll-y="true"
                :show-scrollbar="false"
                :style="{ maxHeight: pickerListMaxHeight + 'px' }"
            >
                <view
                    v-for="(device, index) in filteredPickerDeviceList"
                    :key="index"
                    class="car-picker-item"
                    @click="handleDeviceSelect(device)"
                >
                    <text :class="isCurrentDevice(device) ? 'car-picker-item-name car-picker-item-name--active' : 'car-picker-item-name'">{{ deviceDisplayName(device) }}</text>
                    <view class="car-picker-item-status">
                        <view :class="isDeviceOnline(device) ? 'car-picker-dot car-picker-dot--online' : 'car-picker-dot car-picker-dot--offline'"></view>
                        <text :class="isDeviceOnline(device) ? 'car-picker-status-text car-picker-status-text--online' : 'car-picker-status-text car-picker-status-text--offline'">{{ isDeviceOnline(device) ? '在线' : '离线' }}</text>
                    </view>
                </view>
                <view v-if="filteredPickerDeviceList.length == 0" class="car-picker-empty">
                    <text class="car-picker-empty-text">无匹配设备</text>
                </view>
            </scroll-view>
            <view class="car-picker-cancel" @click="closePicker">
                <text class="car-picker-cancel-text">取消</text>
            </view>
        </view>
    </l-popup>
	<!-- 客服降级弹框：企业微信客服不可用 / 仅配置手机号与二维码时展示 -->
	<customerServicePopup v-model:show="showCustomerServicePopup" :qrcode="customerServiceConfig.serviceQrcode"
		:phones="csPhones" :serviceTime="customerServiceConfig.serviceTime"></customerServicePopup>
	<app-toast></app-toast>
	<app-modal></app-modal>
</template>

<script setup lang="ts">
import { isBusinessSuccessCode } from '../../api/response.uts'
import { showAppToast } from '../../utils/toast.uts'
import { openLocation } from '../../utils/openLocation.uts'
import { showAppModal, type AppModalSuccess } from '../../utils/modal.uts'
import { ref, reactive, computed, nextTick } from 'vue';
import { isDeviceSubscribeSupported, authorizeDevice, authorizeGeofence, topUpGeofenceQuota, checkTemplateSubscribed, fetchNotifyQuota, fetchNotifyStatusEnabled, getCachedQuota, isSubscribeMainSwitchOff, getDeviceSubscribeStatus, isAcceptDeviceStatus, clearDeviceSubscribeStatus, clearAllDeviceSubscribeStatus, getGeofenceSubscribed } from '../../utils/notify.uts'
import { getCustomDeviceList, getUserDeviceList, getDeviceDetail, getDevicePos,getTrackPos,delDevice,logout as logoutRequest, getMessageUnreadCount, getHomePlatformAppId, getCustomerServiceConfig } from '../../api/request.uts'
import { buildCustomerServiceConfig, emptyCustomerService, getCurrentAppId, hasAnyChannel, legacyCustomerService, openCustomerService, splitServicePhones } from '../../common/customerService.uts'
import type { CustomerServiceConfig } from '../../common/customerService.uts'
import customerServicePopup from '../../components/customerServicePopup.uvue'
import CoordTransform from '../../utils/coordTransform.uts'
import { getTodayZeroTime } from '../../utils/gettime.uts'
import { formatLocalTime, formatTimes } from '../../utils/formateTime.uts'
import { getDeviceIcon } from '../../utils/cars'


type Device = {
    name: string,
    deviceName: string,
    value: string,
    deviceNo: string,
    deptId: string,
    deviceId: string,
    iccid: string,
    simMerchant: string,
    connectionStatus: string,
    carType: string,
    plateNo: string,
    latitude: number,
    longitude: number
}

//// 响应式数据
type MapCenter = {
    latitude: number
    longitude: number
}

const center = reactive<MapCenter>({
    latitude: 39.90469,
    longitude: 116.40717
})
const userLocation = reactive<MapCenter>({
    latitude: 0,
    longitude: 0
})
const hasUserLocation = ref(false)
const hasDevice = ref(false)

type UserDeviceListData = {
    list: Array<UTSJSONObject>
}

const userDeviceList = ref<Array<UTSJSONObject>>([])
type PositionState = 'loading' | 'available' | 'empty' | 'invalid' | 'failed'
const positionState = ref<PositionState>('loading')
const positionMessage = computed<string>(() => {
    if (positionState.value == 'loading') return '正在获取车辆位置'
    if (positionState.value == 'empty') return '暂无车辆定位数据'
    if (positionState.value == 'invalid') return '定位数据异常'
    if (positionState.value == 'failed') return '位置获取失败，请检查网络后重试'
    return ''
})
const initialMapScale = 12
const mapScale = ref(initialMapScale)
const isMapReady = ref(false)
const statusBarHeight = ref(20)
const menuButtonInfo = ref(null)
const navBarHeight = ref(44)
const deviceList = ref<Array<Device>>([])
// 选择车辆弹框相关变量
const showPicker = ref(false)
// 设备列表区域最大高度（px），超出后列表整体可上下滑动
const pickerListMaxHeight = ref(600)
// 弹框整体固定高度（px），占屏幕高度的 60%，避免搜索结果多少导致弹框忽上忽下
const pickerPanelHeight = ref(600)
// 弹框内检索关键字
const pickerSearchKeyword = ref('')
// 是否正在切换设备：切换过程中忽略再次点击，避免连点重复请求
const isSwitchingDevice = ref(false)
const currentCarDeviceNo = ref('')
const currentCarDeptId = ref('')
const currentCarDeviceId = ref('')
const currentCarIccId = ref('')
const currentCarName = ref('')
const currentCarSimMerchant = ref('')
const currentCarConnectionStatus = ref('')
const currentCarCarType = ref('')
const currentCarPlateNo = ref('')
const unreadMessageCount = ref(0)
const platformAppId = ref('')
const unreadMessageBadgeText = computed<string>(() => unreadMessageCount.value > 99 ? '99+' : unreadMessageCount.value.toString())
const payUrl = ref('')

type DeviceStatus = {
    batteryPercent: number
    voltage: number
    signalStrength: number
}

type DeviceDetailState = {
    deviceStatus: DeviceStatus
    connectionStatus: string
    lastUpdateTime: string
}

const deviceDetail = ref<DeviceDetailState>({
    deviceStatus: {
        batteryPercent: 0,
        voltage: 0,
        signalStrength: 0
    },
    connectionStatus: 'offline',
    lastUpdateTime: ''
})
const markers = ref([] as Marker[])
const lastUpdateTime = ref('--:--:--')
const devicePosInfo = ref<UTSJSONObject | null>(null)
const devicePositionUpdateTime = computed<string>(() => {
    const position = devicePosInfo.value
    return position != null ? position.getString('positionUpdateTime', '暂无位置') : '暂无位置'
})

// 本地存储key
const SELECTED_DEVICE_STORAGE_KEY: string = 'selected_device_info'
const SELECTED_DEVICE_INDEX_STORAGE_KEY: string = 'selected_device_index'

// 计算属性
const safeDeviceDetail = computed<DeviceDetailState>(() => {
    const detail = deviceDetail.value
    return {
        deviceStatus: {
            batteryPercent: detail.deviceStatus.batteryPercent,
            voltage: detail.deviceStatus.voltage,
            signalStrength: detail.deviceStatus.signalStrength
        },
        connectionStatus: detail.connectionStatus,
        lastUpdateTime: detail.lastUpdateTime
    }
})

const batteryPercent = computed<number>(() : number => {
    const percent = safeDeviceDetail.value.deviceStatus.batteryPercent
    return Math.max(0, Math.min(100, Math.round(percent)))
})


// 设备显示名称
const deviceDisplayName = (device: Device): string => {
    if (device.deviceName != '') return device.deviceName
    if (device.name != '') return device.name
    if (device.deviceNo != '') return device.deviceNo
    return '未命名设备'
}

// 设备是否在线
const isDeviceOnline = (device: Device): boolean => {
    return device.connectionStatus == 'online'
}

// 是否为当前已选中的设备（用于列表中高亮）
const isCurrentDevice = (device: Device): boolean => {
    if (currentCarDeviceId.value != '' && device.deviceId == currentCarDeviceId.value) return true
    if (currentCarDeviceNo.value == '') return false
    return device.deviceNo == currentCarDeviceNo.value || device.value == currentCarDeviceNo.value
}

// 弹框内按 设备名称 / 车牌号 / 设备号 模糊检索
const filteredPickerDeviceList = computed<Array<Device>>(() => {
    const keyword = pickerSearchKeyword.value.trim()
    if (keyword == '') return deviceList.value
    const kw = keyword.toLowerCase()
    return deviceList.value.filter((device: Device) =>
        (device.deviceName != null && device.deviceName.toLowerCase().indexOf(kw) >= 0)
        || (device.name != null && device.name.toLowerCase().indexOf(kw) >= 0)
        || (device.plateNo != null && device.plateNo.toLowerCase().indexOf(kw) >= 0)
        || (device.deviceNo != null && device.deviceNo.toLowerCase().indexOf(kw) >= 0)
    )
})

// 关闭 picker
const closePicker = () => {
    showPicker.value = false
}

// —— 在线客服悬浮球 ——
// 页面内自己实现拖动 + 点击（i-fab 的 click 会被组件内部 moved 过滤吞掉）。
// 交互参考 llk-mini 的 liu-drag-button：松手后按「离屏幕中线更近的一侧」吸附到左/右边缘，
// 不做 5 秒贴边收起——任何时候（含页面滚动）都完整展示，避免只露半边看不清。
const CS_FAB_SIZE = 48
// 吸附后与屏幕左右边缘的间距（px）
const CS_FAB_EDGE = 2
const CS_FAB_TAP_TOLERANCE = 8
const csFabLeft = ref(0)
const csFabTop = ref(0)
const csFabDragging = ref(false)
const csFabTopLimit = ref(116)
const csFabBottomLimit = ref(40)
let csFabWindowWidth = 375
let csFabWindowHeight = 667
let csFabMoved = false
let csFabStartClientX = 0
let csFabStartClientY = 0
let csFabStartLeft = 0
let csFabStartTop = 0

// —— 客服配置（接口下发，不再写死企业与链接）——
// 全未配置时 csEnabled=false，悬浮球与入口整体不渲染
const customerServiceConfig = ref<CustomerServiceConfig>(emptyCustomerService())
const showCustomerServicePopup = ref(false)
const csEnabled = computed<boolean>(() => hasAnyChannel(customerServiceConfig.value))
const csPhones = computed<string[]>(() => splitServicePhones(customerServiceConfig.value))

/**
 * 拉取客服配置：页面 onLoad 预取，点击时直接用内存值。
 *
 * <p>微信要求 {@code openCustomerServiceChat} 必须由用户 TAP <b>同步</b>触发，
 * 因此点击回调里不能再发请求。</p>
 */
const loadCustomerServiceConfig = async () => {
    try {
        const res = await getCustomerServiceConfig(getCurrentAppId())
        if (isBusinessSuccessCode(res.code)) {
            // 接口成功即以后端为准：字段全空表示运营主动清空，入口必须隐藏
            customerServiceConfig.value = buildCustomerServiceConfig(res.data)
        }
    } catch (e) {
        // 请求异常：沿用改造前写死的企微客服，避免发版后入口凭空消失
        console.error('获取客服配置失败，沿用改造前的企业微信客服兜底:', e)
        if (!hasAnyChannel(customerServiceConfig.value)) {
            customerServiceConfig.value = legacyCustomerService()
        }
    }
}

const initCsFab = () => {
    const systemInfo = uni.getSystemInfoSync()
    csFabWindowWidth = systemInfo.windowWidth != null ? systemInfo.windowWidth : 375
    csFabWindowHeight = systemInfo.windowHeight != null ? systemInfo.windowHeight : 667
    const statusTop = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
    // 顶部避开自定义导航栏，底部留出安全距离，避免压住服务中心最后一行
    csFabTopLimit.value = statusTop + 96
    csFabBottomLimit.value = 40
    let top = Math.floor(csFabWindowHeight * 0.62)
    const maxTop = csFabWindowHeight - CS_FAB_SIZE - csFabBottomLimit.value
    if (top > maxTop) top = maxTop
    if (top < csFabTopLimit.value) top = csFabTopLimit.value
    // 初始紧贴右侧，垂直方向略偏下（拇指好点）
    csFabLeft.value = Math.floor(csFabWindowWidth - CS_FAB_SIZE - CS_FAB_EDGE)
    csFabTop.value = top
}

// click 可能因连续轻点触发多次，节流防止重复打开客服会话；
// 这里必须是同步调用（不能先 await），否则脱离微信手势链
let csFabLastOpenAt = 0
const openCsFabService = () => {
    const now = Date.now()
    if (now - csFabLastOpenAt < 600) return
    csFabLastOpenAt = now
    contactCustomerService()
}

const onCsFabTouchStart = (e: any) => {
    const touch = e.touches != null && e.touches.length > 0 ? e.touches[0] : null
    if (touch == null) return
    csFabDragging.value = true
    csFabMoved = false
    csFabStartClientX = Number(touch.clientX)
    csFabStartClientY = Number(touch.clientY)
    csFabStartLeft = csFabLeft.value
    csFabStartTop = csFabTop.value
}

const onCsFabTouchMove = (e: any) => {
    if (!csFabDragging.value) return
    const touch = e.touches != null && e.touches.length > 0 ? e.touches[0] : null
    if (touch == null) return
    const dx = Number(touch.clientX) - csFabStartClientX
    const dy = Number(touch.clientY) - csFabStartClientY
    // 位移超过阈值才算拖动，避免轻点时手抖被误判
    if (!csFabMoved && (dx > CS_FAB_TAP_TOLERANCE || dx < -CS_FAB_TAP_TOLERANCE || dy > CS_FAB_TAP_TOLERANCE || dy < -CS_FAB_TAP_TOLERANCE)) {
        csFabMoved = true
    }
    if (!csFabMoved) return
    let left = csFabStartLeft + dx
    let top = csFabStartTop + dy
    // 限制在可视区域内
    const maxLeft = csFabWindowWidth - CS_FAB_SIZE
    const maxTop = csFabWindowHeight - CS_FAB_SIZE - csFabBottomLimit.value
    if (left < 0) left = 0
    if (left > maxLeft) left = maxLeft
    if (top < csFabTopLimit.value) top = csFabTopLimit.value
    if (top > maxTop) top = maxTop
    csFabLeft.value = left
    csFabTop.value = top
}

const onCsFabTouchEnd = () => {
    csFabDragging.value = false
    // 松手吸附：以图标中心判断靠左还是靠右，吸到对应边缘（拖到中间也不会停在中间挡内容）。
    // left 有 0.3s 过渡（见模板 :style），所以这里是平滑滑入而不是瞬移。
    if (csFabMoved) {
        const centerX = csFabLeft.value + CS_FAB_SIZE / 2
        csFabLeft.value = centerX < csFabWindowWidth / 2
            ? CS_FAB_EDGE
            : (csFabWindowWidth - CS_FAB_SIZE - CS_FAB_EDGE)
    }
    // 注意：不能在这里调 openCustomerServiceChat，微信要求必须是 TAP 手势回调
}

// 轻点进企业微信客服；拖动松手不触发
const onCsFabClick = () => {
    if (csFabMoved) return
    openCsFabService()
}

// 初始化尺寸数据
const initDimensions = () => {
    const systemInfo = uni.getSystemInfoSync();
    statusBarHeight.value = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20;
    // 设备列表最多占屏幕高度的 60%，保证弹框标题与「取消」按钮始终可见
    const windowHeight = systemInfo.windowHeight != null ? systemInfo.windowHeight : 600
    pickerListMaxHeight.value = Math.floor(windowHeight * 0.6)
    // 弹框整体固定为屏幕高度的 60%，搜索结果多少都不会改变弹框高度
    pickerPanelHeight.value = Math.floor(windowHeight * 0.6)
}

// 延迟函数
const delay = (ms: number): Promise<void> => {
    return new Promise<void>((resolve: (value: void) => void) => {
        setTimeout(() => {
            resolve()
        }, ms)
    })
}

// 保存选中的设备信息
const saveSelectedDevice = (device: Device) => {
    try {
        const deviceInfo = {
            name: device.deviceName || device.name || device.deviceNo,
            deviceName: device.deviceName || device.name || device.deviceNo,
            deviceNo: device.deviceNo || device.value,
            deptId: device.deptId,
            deviceId: device.deviceId,
            iccid: device.iccid,
            simMerchant: device.simMerchant,
            connectionStatus: device.connectionStatus,
            carType: device.carType,
            plateNo: device.plateNo,
            latitude: device.latitude,
            longitude: device.longitude
        }
        uni.setStorageSync(SELECTED_DEVICE_STORAGE_KEY, JSON.stringify(deviceInfo))
        console.log('保存选中设备成功:', deviceInfo)
    } catch (error) {
        console.error('保存选中设备失败:', error)
    }
}

type SavedDevice = {
    name: string
    deviceName: string
    deviceNo: string
    deptId: string
    deviceId: string
    iccid: string
    simMerchant: string
    connectionStatus: string
    carType: string
    plateNo: string
    latitude: number
    longitude: number
}

// storage 在微信小程序里返回的是普通 JS 对象（无 UTSJSONObject 的 getString/getNumber），
// 原生 App 端可能是真正的 UTSJSONObject。这里统一兼容两种形态按字段读取，避免 data.getString is not a function
const readStoredStr = (obj: any, key: string, def: string): string => {
	if (obj != null && typeof obj.getString == 'function') return obj.getString(key, def)
	const v = obj != null ? obj[key] : undefined
	return v == null ? def : (typeof v == 'string' ? v : String(v))
}
const readStoredNum = (obj: any, key: string, def: number): number => {
	if (obj != null && typeof obj.getNumber == 'function') return obj.getNumber(key, def)
	const v = obj != null ? obj[key] : undefined
	return v == null ? def : Number(v)
}

const decodeSavedDevice = (raw: any): SavedDevice | null => {
    if (raw == null || raw == '') return null
    let data: any = null
    if (typeof raw == 'string') {
        try {
            data = JSON.parse(raw)
        } catch (error) {
            return null
        }
    } else {
        data = raw
    }
    if (data == null) return null
    const deviceNo = readStoredStr(data, 'deviceNo', '')
    const deviceId = readStoredStr(data, 'deviceId', '')
    if (deviceNo == '' && deviceId == '') return null
    const identity = deviceNo != '' ? deviceNo : deviceId
    const device: SavedDevice = {
        name: readStoredStr(data, 'name', identity),
        deviceName: readStoredStr(data, 'deviceName', readStoredStr(data, 'name', identity)),
        deviceNo: deviceNo,
        deptId: readStoredStr(data, 'deptId', ''),
        deviceId: deviceId,
        iccid: readStoredStr(data, 'iccid', ''),
        simMerchant: readStoredStr(data, 'simMerchant', ''),
        connectionStatus: readStoredStr(data, 'connectionStatus', ''),
        carType: readStoredStr(data, 'carType', ''),
        plateNo: readStoredStr(data, 'plateNo', ''),
        latitude: readStoredNum(data, 'latitude', 0),
        longitude: readStoredNum(data, 'longitude', 0)
    }
    return device
}

// 获取保存的选中设备
const getSavedSelectedDevice = (): SavedDevice | null => {
    try {
        const rawDevice = uni.getStorageSync(SELECTED_DEVICE_STORAGE_KEY)
        if (rawDevice == null) return null
        return decodeSavedDevice(rawDevice)
    } catch (error) {
        console.error('获取保存设备失败:', error)
    }
    return null
}

// 清除保存的选中设备
const clearSavedSelectedDevice = () => {
    try {
        uni.removeStorageSync(SELECTED_DEVICE_STORAGE_KEY)
        console.log('清除保存设备成功')
    } catch (error) {
        console.error('清除保存设备失败:', error)
    }
}

