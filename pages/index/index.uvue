    })
}

async function unbindCurrentDevice() : Promise<void> {
    const result = await delDevice(currentCarDeviceId.value)
    console.log('解绑设备结果:', result)
    if (isBusinessSuccessCode(result.code)) {
        showAppToast({
            title: result.msg || '解绑成功',
            icon: 'none'
        })
        // 设备已解绑，清掉该设备的订阅记录，避免重新绑定后误判为已订阅
        clearDeviceSubscribeStatus(currentCarDeviceNo.value)
        clearSavedSelectedDevice()
        clearSavedSelectedDeviceIndex()

        await loadDeviceList()
    } else {
        showAppToast({
            title: '解绑失败',
            icon: 'error'
        })
    }
}

// 解绑设备
const unbindDevice = () : void => {
    if (!isLogin()) return
    if (!isCarSelected()) return
    showAppModal({
        title: '解绑车辆',
        content: '确定解绑当前车辆吗？',
        success: (res: AppModalSuccess) : void => {
            if (res.confirm) {
                void unbindCurrentDevice()
            }
        }
    })
}

async function performLogout(): Promise<void> {
    const res = await logoutRequest()
    if(isBusinessSuccessCode(res.code)){
        // 账号切换后 openid 变化，旧账号的设备订阅记录不再适用，必须清空
        clearAllDeviceSubscribeStatus()
        clearSavedSelectedDevice()
        clearSavedSelectedDeviceIndex()
        uni.removeStorageSync('token')
        uni.reLaunch({
            url:'/pages/login/login'
        })
    }else{
        showAppToast({
            title: res.msg || '退出账户失败'
        })
    }
}

// 退出登录
const logout = (): void => {
    if (!isLogin()) return
    showAppModal({
        title: '退出登录',
        content: '确定退出登录吗？',
        success: (res: AppModalSuccess): void => {
            if (res.confirm) void performLogout()
        }
    })
}

// —— 车辆告警通知（硬件设备订阅，mode=device）——
const deviceSubscribed = ref(false)
// 围栏进出告警走独立的订阅模板（一次性订阅，模板级授权，不区分设备）
const geofenceSubscribed = ref(false)
// 用户是否对围栏模板勾过「总是保持以上选择」：只有勾过才能在点击链内静默续攒额度，
// 没勾过时每次调用都会弹授权窗，绝不能拿 geofenceSubscribed 当这个开关用。
const geofenceAlwaysKeep = ref(false)
// 当前设备此前被拒绝过（或已被微信置为 ban）：微信不会再弹授权，改为引导去设置页手动开启
const subscribeRejected = ref(false)
const subscribeAvailable = ref(false)
const subscribeRequesting = ref(false)
// 合并并发调用：onShow、切设备、设备列表加载都会触发刷新，避免重复请求
let subscribeRefreshing = false
// 刷新过程中又收到新请求（如刚切完设备）时，标记待重跑，避免状态停留在旧设备
let subscribeRefreshPending = false
// 老版本用一条全局标记（不区分设备）记录订阅状态，无法判断属于哪台设备，升级后清理：
// 让用户对当前设备重新授权一次，确保微信侧真的建立订阅关系
try {
    uni.removeStorageSync('alarm_subscribe_accepted')
    uni.removeStorageSync('alarm_subscribe_rejected')
} catch (error) {
    console.warn('清理旧订阅标记失败:', error)
}
// 「车辆定位器告警」（设备订阅）和「围栏进出通知」（一次性订阅）是两个独立模板，
// 微信一次点击只能调起一个订阅弹窗，必须各自授权一次，才会在「通知管理」里各出现一条。
// 按钮做成三态：第一次点开启通知（设备订阅），第二次点开启围栏提醒，两条都开才是已订阅。
const subscribeBtnText = computed<string>(() => {
    if (deviceSubscribed.value && geofenceSubscribed.value) return '已订阅'
    if (deviceSubscribed.value) return '开启围栏提醒'
    return '开启通知'
})
const subscribeRowDesc = computed<string>(() => {
    if (deviceSubscribed.value && geofenceSubscribed.value) {
        return '车辆发生进/出围栏、超速等告警时将通过微信提醒'
    }
    // 两条通道分开授权：设备订阅已开、围栏专属模板未开时，引导再点一次
    if (deviceSubscribed.value && !geofenceSubscribed.value) {
        return '车辆告警已开启，再点一次开启围栏进出提醒'
    }
    return '开启后，告警将通过微信服务通知提醒'
})

// 真正执行一次订阅状态计算：拉后端开关 + 告警模板，再按「当前设备 + 当前模板」取授权记录
const applySubscribeState = async (): Promise<void> => {
    // 后端开关控制订阅引导的展示与否
    const enabled = await fetchNotifyStatusEnabled()
    if (!enabled) {
        subscribeAvailable.value = false
        deviceSubscribed.value = false
        geofenceSubscribed.value = false
        subscribeRejected.value = false
        return
    }
    // 模板 ID 以后端配置为准，前端不硬编码
    await fetchNotifyQuota()
    const item = getCachedQuota('alarm')
    // 未配置模板的场景不会出现在 /quota 返回值中，此时隐藏引导 UI，不报错
    if (item == null || item.mode != 'device' || item.templateId == '') {
        subscribeAvailable.value = false
        deviceSubscribed.value = false
        geofenceSubscribed.value = false
        subscribeRejected.value = false
        return
    }
    subscribeAvailable.value = true
    // 设备订阅状态无法通过 wx.getSetting 查询（官方限制：itemSettings 不含设备订阅模板），
    // 以「本机为这台设备成功授权过」的本地记录为准；用户关闭「订阅消息总开关」时降级为未开启。
    // 【2026-11-04 修复】必须按「当前这台设备」判定，不能按模板判定：
    // 微信 getSetting(withSubscriptions) 只返回模板级状态，多设备用户给 A 授权后
    // 会把 B 也显示成「已订阅」，点击时直接走"去设置页关闭"分支、永不再发起授权。
    // 也不能再叠加模板状态兜底 —— 设备模板不出现在 itemSettings 里，叠加后恒为 false。
    const status = getDeviceSubscribeStatus(currentCarDeviceNo.value, item.templateId)
    // 总开关关闭时所有订阅都不生效，仅降级展示为未开启（不清记录：用户重新打开后仍有效）
    const mainSwitchOff = await isSubscribeMainSwitchOff()
    deviceSubscribed.value = !mainSwitchOff && isAcceptDeviceStatus(status)
    subscribeRejected.value = !deviceSubscribed.value && (status == 'reject' || status == 'ban')
    // 围栏模板是「模板级」长期订阅（不按设备区分），直接用模板状态判定
    const gItem = getCachedQuota('geofence')
    if (gItem != null && gItem.templateId != '') {
        // 本地授权记录为准，微信侧状态兜底：用户没勾「总是保持以上选择」时 itemSettings 查不到该模板
        const localGeofence = getGeofenceSubscribed(gItem.templateId)
        const wxGeofence = await checkTemplateSubscribed(gItem.templateId)
        // 微信侧有记录 ≡ 用户勾了「总是保持」，只有这种状态才能静默续攒额度
        geofenceAlwaysKeep.value = wxGeofence
        geofenceSubscribed.value = !mainSwitchOff && (localGeofence || wxGeofence)
    } else {
        geofenceSubscribed.value = true  // 后端未配置围栏模板时不阻塞主流程
        geofenceAlwaysKeep.value = false
    }
}

// 拉取订阅展示开关（/app/notify/status）与告警模板，并按「当前设备」判断是否已订阅
const refreshSubscribeState = async (): Promise<void> => {
    // 没有设备时直接收起入口，不必发请求
    if (!isDeviceSubscribeSupported() || !checkToken() || currentCarDeviceNo.value == '') {
        subscribeAvailable.value = false
        deviceSubscribed.value = false
        geofenceSubscribed.value = false
        subscribeRejected.value = false
        return
    }
    // 刷新途中又来请求（如刚切完设备）：标记待重跑，避免状态停留在旧设备
    if (subscribeRefreshing) {
        subscribeRefreshPending = true
        return
    }
    subscribeRefreshing = true
    try {
        do {
            subscribeRefreshPending = false
            await applySubscribeState()
        } while (subscribeRefreshPending)
    } finally {
        subscribeRefreshing = false
    }
}

// 设备订阅按 sn 逐台生效：只授权了当前设备，其它设备切过去后仍需单独开启
const hasMoreDevices = (): boolean => {
    return deviceList.value.length > 1
}

// 打开小程序设置页；返回后重新校准订阅状态（用户可能刚在设置里关闭了订阅消息）
const openSubscribeSettings = (): void => {
    uni.openSetting({
        complete: () => {
            void refreshSubscribeState()
        }
    })
}

// 拒绝授权后微信不再弹窗，引导用户到设置页手动开启「订阅消息」
const showSubscribeSettingsGuide = (): void => {
    showAppModal({
        title: '开启通知',
        content: '您已拒绝接收通知，微信不会再弹出授权框。请点击「去开启」，在「订阅消息」中打开「车辆定位器告警」',
        confirmText: '去开启',
        cancelText: '取消',
        success: (res: AppModalSuccess): void => {
            if (res.confirm) {
                openSubscribeSettings()
            }
        }
    })
}

// 设备订阅返回 accept 只代表「允许接收」，微信不会弹横幅/响铃，
// 消息会静默落在微信会话列表的「服务通知」里 —— 必须讲清楚，否则用户会认为没收到通知。
// 需要横幅提醒时，引导去设置页把该模板改成「接收并提醒」。
const showAlertUpgradeGuide = (): void => {
    showAppModal({
        title: '已开启接收通知',
        content: '告警消息会出现在微信「服务通知」中。如需弹出横幅提醒，请点击「去设置」-「订阅消息」，把「车辆定位器告警」和「围栏进出通知」都改为「接收并提醒」',
        confirmText: '去设置',
        cancelText: '知道了',
        success: (res: AppModalSuccess): void => {
            if (res.confirm) {
                openSubscribeSettings()
            }
        }
    })
}

// 「围栏进出通知」是普通一次性订阅模板，微信只允许它出现在 requestSubscribeMessage 的弹窗里，
// 无法和设备订阅（车辆定位器告警，type=3）合并进同一个授权框 —— 微信按 API 区分模板类别。
// 这里用本小程序自己的确认框承接第二次授权：modal 的「继续开启」属于用户点击手势，
// 在回调里同步调用 authorizeGeofence()，微信才认（否则报 can only be invoked by user TAP gesture）。
const showGeofenceGuide = (needUpgrade : boolean): void => {
    showAppModal({
        title: '再开启一步',
        content: '车辆告警已开启。再开启「围栏进出通知」，车辆进出围栏时才会收到微信提醒。',
        confirmText: '继续开启',
        cancelText: '稍后',
        success: (res: AppModalSuccess): void => {
            if (res.confirm) {
                // 直接调用：finishGeofenceAuthorize 在第一个 await 之前同步执行，仍在手势链内
                void finishGeofenceAuthorize(needUpgrade)
            }
            // 选「稍后」不再追问，也不弹改接收并提醒的框（尊重用户选择，按钮已变成「开启围栏提醒」）
        }
    })
}

const finishGeofenceAuthorize = async (needUpgrade : boolean): Promise<void> => {
    try {
        // 第一行同步发起，保证处于点击手势链内
        const g = await authorizeGeofence()
        if (g.status == 'accept' || g.status == 'noTemplate') {
            geofenceSubscribed.value = true
            if (needUpgrade) {
                showAlertUpgradeGuide()
            } else {
                showAppToast({ title: '订阅成功，已开启提醒', icon: 'none' })
            }
            return
        }
        if (g.errMsg.indexOf('cancel') >= 0) {
            // 用户主动取消：不打扰，按钮保持「开启围栏提醒」
            return
        }
        if (g.status == 'ban' || g.status == 'filter') {
            showSubscribeSettingsGuide()
            return
        }
        showAppToast({ title: '围栏提醒未开启，可点按钮重试', icon: 'none' })
    } catch (error) {
        console.warn('[index] 围栏模板授权异常:', error)
        showAppToast({ title: '围栏提醒未开启，可点按钮重试', icon: 'none' })
    }
}

// 用户主动点击订阅
// 两个模板的授权机制不同，必须分两次点击、每次只弹一个授权框：
//  · 车辆定位器告警：设备订阅（type=3），需先换票（snTicket 5 分钟有效），可异步发起；
//  · 围栏进出通知：一次性订阅（type=2），requestSubscribeMessage 必须在 tap 手势链内
//    **同步**发起，任何 await 之后调用都会被微信以 "can only be invoked by user TAP gesture" 拒绝。
// 按钮三态引导：开启通知 → 开启围栏提醒 → 已订阅，避免用户不知道还差一步。
const handleSubscribeTap = async (): Promise<void> => {
    if (!isLogin()) return
    if (!isCarSelected()) return
    if (subscribeRequesting.value) return
    if (!isDeviceSubscribeSupported()) {
        showAppToast({ title: '当前微信版本不支持设备订阅', icon: 'none' })
        return
    }
    // 两个模板都已授权：不弹授权窗，只静默续攒一次围栏额度，并引导去设置页管理
    if (deviceSubscribed.value && geofenceSubscribed.value) {
        topUpGeofenceQuota(geofenceAlwaysKeep.value)
        showAppModal({
            title: '车辆告警通知',
            content: hasMoreDevices()
                ? '当前设备已开启告警通知，其它设备需切换后单独开启。如需关闭，请点击「去设置」后在「订阅消息」中关闭'
                : '当前设备已开启告警通知。如需关闭，请点击「去设置」后在「订阅消息」中关闭',
            confirmText: '去设置',
            cancelText: '取消',
            success: (res: AppModalSuccess): void => {
                if (res.confirm) {
                    openSubscribeSettings()
                }
            }
        })
        return
    }
    // 当前设备已被拒绝过：微信不会再次弹窗，直接引导到设置页手动开启
    if (subscribeRejected.value) {
        showSubscribeSettingsGuide()
        return
    }

    subscribeRequesting.value = true
    try {
        // —— A) 只差围栏模板：点击后立刻同步发起，保证仍在 tap 手势链内 ——
        if (deviceSubscribed.value && !geofenceSubscribed.value) {
            const g = await authorizeGeofence()
            if (g.status == 'accept') {
                geofenceSubscribed.value = true
            } else if (g.status == 'noTemplate') {
                // 后端未配置围栏模板：不打扰用户，围栏告警仍有 App 推送与站内信
                geofenceSubscribed.value = true
            } else if (g.errMsg.indexOf('cancel') >= 0) {
                // 用户主动取消：不打扰
                return
            } else if (g.status == 'ban' || g.status == 'filter') {
                showSubscribeSettingsGuide()
                return
            } else {
                showAppToast({ title: '围栏提醒授权失败，请稍后重试', icon: 'none' })
                return
            }
            showAppToast({ title: '围栏进出提醒已开启', icon: 'none' })
            return
        }

        // —— B) 设备未订阅：换票 → 设备订阅授权（按设备逐台授权）——
        const tappingDeviceNo = currentCarDeviceNo.value
        const outcome = await authorizeDevice(tappingDeviceNo, 'alarm')
        // 授权结果已由 authorizeDevice 按「设备 + 模板」写入本地记录
        if (isAcceptDeviceStatus(outcome.status)) {
            // 弹窗期间已切到别的设备：不要用旧设备的结果覆盖新设备的状态
            if (tappingDeviceNo == currentCarDeviceNo.value) {
                deviceSubscribed.value = true
                subscribeRejected.value = false
            }
            // 按本地记录判断提醒强度：accept / acceptWithAudio 只进微信「服务通知」，不弹横幅。
            const alarmItem = getCachedQuota('alarm')
            const devStatus = alarmItem != null ? getDeviceSubscribeStatus(tappingDeviceNo, alarmItem.templateId) : ''
            const needUpgrade = devStatus != 'acceptWithAlert'
            if (!geofenceSubscribed.value) {
                // 还差围栏模板：用本小程序自己的确认框承接第二次授权，
                // 用户不用再自己去找首页按钮（详见 showGeofenceGuide）
                showGeofenceGuide(needUpgrade)
            } else if (needUpgrade) {
                showAlertUpgradeGuide()
            } else {
                showAppToast({ title: '订阅成功，已开启接收并提醒', icon: 'none' })
            }
        } else if (outcome.status == 'reject') {
            // 用户点了「拒绝」：下次点击「开启通知」直接引导去设置页手动开启
            if (tappingDeviceNo == currentCarDeviceNo.value) subscribeRejected.value = true
            if (outcome.errMsg.indexOf('cancel') < 0) {
                showAppToast({ title: '您已拒绝授权通知，可点击按钮前往设置手动开启', icon: 'none' })
            }
        } else if (outcome.status == 'ban') {
            // ban = 微信已记住拒绝且不再弹窗，只能去设置页手动开启
            if (tappingDeviceNo == currentCarDeviceNo.value) subscribeRejected.value = true
            showSubscribeSettingsGuide()
        } else if (outcome.status == 'filter') {
            showAppToast({ title: '通知模板暂不可用，请联系客服', icon: 'none' })
        } else if (outcome.status == 'noTemplate') {
            subscribeAvailable.value = false
        } else if (outcome.status == 'fail') {
            if (outcome.errMsg.indexOf('cancel') < 0) {
                showAppToast({ title: outcome.errMsg != '' ? outcome.errMsg : '订阅失败，请稍后重试', icon: 'none' })
            }
        }
    } finally {
        subscribeRequesting.value = false
    }
}

onShow(async () => {
    if (checkToken()) {
        await loadUnreadMessageCount()
        void refreshSubscribeState()
        const needRefresh = uni.getStorageSync('needRefreshHome')
        if (needRefresh) {
            await loadDeviceList()
            uni.removeStorageSync('needRefreshHome')
        }
    }
})

// 刷新设备列表
const handleReload = () => {
    // 一次性订阅：在点击手势链内同步续攒围栏额度
    topUpGeofenceQuota(geofenceAlwaysKeep.value)
    if (!isLogin()) return
    void loadHomePlatformAppId()
    loadDeviceList()
}

// 页面加载
onLoad(() => {
    initDimensions()
    initCsFab()
    void loadHomePlatformAppId()
    void loadCustomerServiceConfig()

    if (checkToken()) {
        loadDeviceList()
    }
})
</script>


