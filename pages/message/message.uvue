<template>
	<custom-navBar title="消息中心" :show-back="true" backgroundColor="#fff" textColor="#333" :showCapsule="false" :isShowStyle="true">
	</custom-navBar>
	<view class="container">
		<!-- 新消息提示：点击后才将暂存消息插入列表 -->
		<view v-if="hasNewMessages" class="new-message-tip" @click="loadNewMessages">
			<text class="new-message-text">有 {{newMessageCount}} 条新消息，点击查看</text>
		</view>
		<scroll-view
			scroll-y="true" 
			:show-scrollbar="false"
			:scroll-top="messageScrollTop"
			class="scroll-container"
			id="message-scroll-container"
			refresher-enabled
			:refresher-triggered="refresherTriggered"
			:lower-threshold="100"
			@refresherrefresh="onRefresherRefresh"
			@scrolltolower="onScrollToLower"
			@scroll="onMessageScroll">

			<view class="list-box">
				<!-- 显示空状态 -->
				<view v-if="isInitialLoading" class="empty-state">
					<text class="empty-state-text">加载中...</text>
				</view>
				<view v-else-if="isMessageListEmpty" class="empty-state">
					<text class="empty-state-text">暂无消息</text>
				</view>
				<view
					v-for="(item, index) in msgList"
					:key="getMessageId(item, index)"
					class="message-item"
					@click="handleItemClick(item)">
					<view class="message-header">
						<text class="message-title">{{ getMessageTitle(item) }}</text>
						<text class="time-text">{{ formatTime(getMessageCreateTime(item)) }}</text>
					</view>
					<view class="message-content-row">
						<text class="message-content">{{ getMessageContent(item) }}</text>
						<view class="unread-box" v-if="isMessageUnread(item)">
							<text class="unread-badge">未读</text>
						</view>
					</view>
				</view>
				<view v-if="showLoadMore" class="load-more">
					<text class="tips-text" v-if="isListLoading">加载中...</text>
					<text class="tips-text" v-else-if="loadStatus == 'nomore'">没有更多了</text>
					<text class="tips-text" v-else>上拉加载更多</text>
				</view>
			</view>
		</scroll-view>
		<!-- 登录提示 -->


		<i-modal
			:show="modal"
			:title="getMessageTypeText(modalContent.getNumber('messageType', 0))"
			:content="modalContent.getString('content', '')"
			@confirm="ReadIt">
		</i-modal>
	</view>
	<app-toast></app-toast>
</template>

<script setup lang="uts">
	import { ref, computed, nextTick, onActivated, onDeactivated } from 'vue'
	import { getUserMsgList, setMsgState } from '../../api/request.uts'
	import { consumePendingMessageId, consumePushStaleFlag } from '../../services/push.uts'
	import { parseLocalDateTime } from '../../utils/formateTime.uts'

	const modal = ref<boolean>(false)
	const modalContent = ref<UTSJSONObject>({})
	const refresherTriggered = ref(false)

	// 消息列表相关
	const msgList = ref<UTSJSONObject[]>([])
	const currPage = ref(1)          // 当前页码
	const pageSize = ref(10)         // 每页条数
	const totalPage = ref(1)         // 总页数
	const loadStatus = ref('loadmore') // 加载状态
	const isListLoading = ref(false) // 消息列表是否正在加载
	const isCheckingNewMessages = ref(false) // 是否正在检查新消息
	const hasLoadedInitial = ref(false) // 首次列表请求是否完成
	const hasNewMessages = ref(false) // 是否有新消息
	const newMessageCount = ref(0)   // 新消息数量
	const pendingNewMessages = ref<UTSJSONObject[]>([]) // 等待用户确认展示的新消息
	const messageScrollTop = ref(0)
	const Login = ref(false)
	const messageScrollViewportHeight = ref(0)
	const isNearMessageListBottom = ref(false)

	const isInitialLoading = computed<boolean>(() => {
		return isListLoading.value && !hasLoadedInitial.value && msgList.value.length == 0
	})

	const isMessageListEmpty = computed<boolean>(() => {
		return hasLoadedInitial.value && msgList.value.length == 0 && !hasNewMessages.value
	})

	const showLoadMore = computed<boolean>(() => {
		return msgList.value.length > 0 && (isListLoading.value || loadStatus.value == 'loadmore' || loadStatus.value == 'nomore')
	})

	// 定时器相关
	let checkTimer: number = 0
	let scrollResumeTimer: number | null = null
	const NEW_MESSAGE_CHECK_INTERVAL = 10000
	const SCROLL_RESUME_DELAY = 1500
	const isPageActive = ref(false)
	// 停止新消息检查
	function stopNewMessageCheck() : void {
		if (checkTimer > 0) {
			console.log('停止定时消息检查')
			clearInterval(checkTimer)
			checkTimer = 0
		}
	}

	function stopScrollResumeTimer() : void {
		const timer: number | null = scrollResumeTimer
		if (timer != null) {
			clearTimeout(timer)
			scrollResumeTimer = null
		}
	}

	// 震动报警函数
	function vibrateAlert() : void {
		for (let i = 0; i < 3; i++) {
			uni.vibrateLong({})
		}
	}

	async function findLatestMessages() : Promise<Array<UTSJSONObject>> {
		if (isListLoading.value || isCheckingNewMessages.value) return []
		isCheckingNewMessages.value = true
		try {
			const res = await getUserMsgList({ page: 1, pageSize: 10 })
			const pageData = res.data
			if (res.code != 200 || pageData == null) return []
			const latestList : Array<UTSJSONObject> = pageData.list

			const existingIds = new Set<string>()
			let latestLoadedTime : number | null = null
			const rememberMessage = (message : UTSJSONObject) : void => {
				const messageId = message.getString('messageId', '')
				if (messageId != '') existingIds.add(messageId)
				const messageTime = parseLocalDateTime(message.getString('createTime', ''))
				const currentLatestLoadedTime = latestLoadedTime
				if (messageTime != null && (currentLatestLoadedTime == null || messageTime > currentLatestLoadedTime)) {
					latestLoadedTime = messageTime
				}
			}

			msgList.value.forEach(rememberMessage)
			pendingNewMessages.value.forEach(rememberMessage)

			const latestMessages : Array<UTSJSONObject> = []
			latestList.forEach((message : UTSJSONObject) : void => {
				const messageId = message.getString('messageId', '')
				const messageTime = parseLocalDateTime(message.getString('createTime', ''))
				const isNewerThanLoaded = latestLoadedTime == null
					? msgList.value.length == 0 && pendingNewMessages.value.length == 0
					: messageTime != null && messageTime > latestLoadedTime
				if (messageId != '' && !existingIds.has(messageId) && isNewerThanLoaded) {
					existingIds.add(messageId)
					latestMessages.push(message)
				}
			})

			return latestMessages
		} catch (error) {
			console.error('检查新消息失败:', error)
			return []
		} finally {
			isCheckingNewMessages.value = false
		}
	}

	// 检查新消息，只暂存结果，避免打断用户当前的阅读位置
	async function checkNewMessages() : Promise<void> {
		if (!isPageActive.value || isListLoading.value || isCheckingNewMessages.value) return
		const latestMessages = await findLatestMessages()
		if (latestMessages.length > 0) {
			pendingNewMessages.value = [...pendingNewMessages.value, ...latestMessages]
			hasNewMessages.value = true
			newMessageCount.value = pendingNewMessages.value.length
			vibrateAlert()
		}
	}

	// 启动新消息检查
	function startNewMessageCheck() : void {
		if (checkTimer > 0) {
			stopNewMessageCheck()
		}

		console.log('启动定时消息检查')
		// 每10秒检查一次新消息
		checkTimer = setInterval(() => {
			if (isPageActive.value) {
				console.log('定时检查新消息...')
				void checkNewMessages()
			}
		}, NEW_MESSAGE_CHECK_INTERVAL)
	}

	function pauseNewMessageCheckWhileScrolling() : void {
		stopNewMessageCheck()
		stopScrollResumeTimer()
		scrollResumeTimer = setTimeout(() => {
			scrollResumeTimer = null
			if (!isPageActive.value) return
			startNewMessageCheck()
			void checkNewMessages()
		}, SCROLL_RESUME_DELAY)
	}


	// 加载消息列表
	async function loadMsgList(isInit : boolean = false) : Promise<boolean> {
		if (isListLoading.value || isCheckingNewMessages.value) return false
		if (isInit) {
			currPage.value = 1
			msgList.value = []
			hasLoadedInitial.value = false
			pendingNewMessages.value = []
			hasNewMessages.value = false
			newMessageCount.value = 0
			messageScrollTop.value = 0
			loadStatus.value = 'loadmore'
			isNearMessageListBottom.value = false
		}
		isListLoading.value = true
		try {
			if (!isInit) loadStatus.value = 'loading'
			const res = await getUserMsgList({
				page: currPage.value,
				pageSize: pageSize.value
			})
			if (res.code != 200) {
				loadStatus.value = 'loadmore'
				return false
			}
			const data = res.data
			if (data == null) {
				totalPage.value = currPage.value
				loadStatus.value = 'nomore'
				if (isInit) {
					hasLoadedInitial.value = true
					pendingNewMessages.value = []
					hasNewMessages.value = false
					newMessageCount.value = 0
				}
				return true
			}
			const totalPages = data.totalPage > 0 ? data.totalPage : 1
			totalPage.value = totalPages
			const newData : Array<UTSJSONObject> = data.list
			const isEmptyInitial = isInit && newData.length == 0
			if (isInit) {
				msgList.value = newData
				hasLoadedInitial.value = true
				pendingNewMessages.value = []
				hasNewMessages.value = false
				newMessageCount.value = 0
			} else {
				newData.forEach((item : UTSJSONObject) : void => {
					const messageId = item.getString('messageId', '')
					const exists = msgList.value.some((existing : UTSJSONObject) : boolean => existing.getString('messageId', '') == messageId)
					if (!exists) msgList.value.push(item)
				})
			}
			loadStatus.value = isEmptyInitial || currPage.value >= totalPage.value ? 'nomore' : 'loadmore'
			return true
		} catch (error) {
			loadStatus.value = 'loadmore'
			console.error('请求异常:', error)
			return false
		} finally {
			isListLoading.value = false
		}
	}

	// 加载新消息：先补查一次，再一次性展示所有暂存消息
	async function loadNewMessages() : Promise<void> {
		if (isListLoading.value || isCheckingNewMessages.value) return
		console.log('加载新消息')
		await checkNewMessages()
		if (pendingNewMessages.value.length > 0) {
			msgList.value = [...pendingNewMessages.value, ...msgList.value]
			pendingNewMessages.value = []
			messageScrollTop.value = 1
			await nextTick()
			messageScrollTop.value = 0
		}
		hasNewMessages.value = false
		newMessageCount.value = 0
		console.log('新消息加载完成')
	}


	// 页面加载时初始化数据
	onLoad(() => {
		// 获取 token
		const token = uni.getStorageSync('token')
		// 如果有 token，加载消息列表
		if (token) {
			Login.value = true
			loadMsgList(true)
		} else {
			Login.value = false
		}
	})

	const measureMessageScrollViewport = () : void => {
		uni.createSelectorQuery().select('#message-scroll-container').boundingClientRect((rect : any) => {
			if (rect == null) return
			const nodeInfo = rect as NodeInfo
			const height = nodeInfo.height ?? 0
			if (height > 0) {
				messageScrollViewportHeight.value = height
			}
		}).exec()
	}

	async function handleItemClick(item : UTSJSONObject) : Promise<void> {
		modalContent.value = item
		modal.value = true
		if (item.getNumber('status', 0) == 1) {
			try {
				const messageId = item.getString('messageId', '')
				const res = await setMsgState(messageId)
				if (res.code == 200) {
					const index = msgList.value.findIndex((message : UTSJSONObject) : boolean => message.getString('messageId', '') == messageId)
					if (index != -1) {
						msgList.value[index].set('status', 0)
						msgList.value = [...msgList.value]
					}
				}
			} catch (error) {
				console.error('更新状态失败:', error)
			}
		}
	}

	async function openPendingPushMessage() : Promise<void> {
		if (isListLoading.value || isCheckingNewMessages.value) {
			setTimeout(() => {
				void openPendingPushMessage()
			}, 150)
			return
		}
		const messageId = consumePendingMessageId()
		const shouldRefresh = consumePushStaleFlag()
		if (messageId == '' && !shouldRefresh) return
		await loadMsgList(true)
		if (messageId == '') return
		const message = msgList.value.find((item : UTSJSONObject) : boolean => item.getString('messageId', '') == messageId)
		if (message != null) await handleItemClick(message)
	}

	const finishPageLifecycle = (): void => {
		isPageActive.value = false
		stopNewMessageCheck()
		stopScrollResumeTimer()
	}

	const resumePageLifecycle = (): void => {
		stopScrollResumeTimer()
		isPageActive.value = true
		startNewMessageCheck()
		void openPendingPushMessage()
		void checkNewMessages()
	}

	// 页面显示时启动定时器
	onShow(() => {
		if (!Login.value) return
		console.log('页面显示 - 启动自动刷新')
		measureMessageScrollViewport()
		resumePageLifecycle()
	})

	onHide(() => {
		console.log('页面隐藏 - 停止自动刷新')
		finishPageLifecycle()
	})

	onUnload(() => {
		console.log('页面卸载 - 清理资源')
		finishPageLifecycle()
	})

	onActivated(() => {
		if (!Login.value) return
		console.log('页面激活 - 启动自动刷新')
		resumePageLifecycle()
	})

	onDeactivated(() => {
		console.log('页面停用 - 停止自动刷新')
		finishPageLifecycle()
	})

	// 下拉刷新处理
	const onRefresherRefresh = () => {
		console.log('下拉刷新触发')
		refresherTriggered.value = true
		loadMsgList(true).then(() => {
			refresherTriggered.value = false
		}).catch(() => {
			refresherTriggered.value = false
		})
	}

	// 加载更多
	const loadMore = async () => {
		if (isListLoading.value || isCheckingNewMessages.value || loadStatus.value != 'loadmore' || currPage.value >= totalPage.value) {
			if (currPage.value >= totalPage.value) {
				loadStatus.value = 'nomore'
			}
			return
		}

		const previousPage = currPage.value
		currPage.value = previousPage + 1
		const loaded = await loadMsgList()
		if (!loaded) currPage.value = previousPage
	}

	// 滚动到底部加载更多
	const onScrollToLower = () => {
		if (loadStatus.value == 'loadmore' && !isListLoading.value && !isCheckingNewMessages.value) {
			loadMore()
		}
	}

	const onMessageScroll = (event : UniScrollEvent) : void => {
		pauseNewMessageCheckWhileScrolling()
		// #ifdef APP-IOS
		const viewportHeight = messageScrollViewportHeight.value
		if (viewportHeight <= 0) return
		const remainingDistance = event.detail.scrollHeight - event.detail.scrollTop - viewportHeight
		const isNearBottom = event.detail.deltaY > 0 && remainingDistance <= 100
		if (isNearBottom && !isNearMessageListBottom.value) {
			isNearMessageListBottom.value = true
			loadMore()
		} else if (!isNearBottom) {
			isNearMessageListBottom.value = false
		}
		// #endif
	}



	const ReadIt = () => {
		modal.value = false
	}

	const getMessageId = (item : UTSJSONObject, index : number) : string => {
		const messageId = item.getString('messageId', '')
		return messageId != '' ? messageId : index.toString()
	}

	const getMessageCreateTime = (item : UTSJSONObject) : string => {
		return item.getString('createTime', '')
	}

	const getMessageContent = (item : UTSJSONObject) : string => {
		return item.getString('content', '')
	}

	const isMessageUnread = (item : UTSJSONObject) : boolean => {
		return item.getNumber('status', 0) == 1
	}

	const getMessageTypeText = (type: number) : string => {
		switch(type) {
			case 1: return '警告'
			case 2: return '事件'
			default: return '通知'
		}
	}

	const getMessageTitle = (item : UTSJSONObject) : string => {
		return getMessageTypeText(item.getNumber('messageType', 0)) + ' - ' + getMessageCreateTime(item)
	}

	// 工具函数
	const formatTime = (timeString: string) => {
		if (!timeString) return ''
		try {
			const milliseconds = parseLocalDateTime(timeString)
			if (milliseconds == null) return timeString
			const date = new Date(milliseconds)
			const now = new Date()
			const diff = now.getTime() - date.getTime()
			const minutes = Math.floor(diff / 60000)
			const hours = Math.floor(diff / 3600000)
			const days = Math.floor(diff / 86400000)

			if (minutes < 1) return '刚刚'
			if (minutes < 60) return `${minutes}分钟前`
			if (hours < 24) return `${hours}小时前`
			if (days < 7) return `${days}天前`

			return `${date.getMonth() + 1}-${date.getDate()}`
		} catch (error) {
			return timeString
		}
	}
</script>

<style lang="scss">
	.container {
		width: 100%;
		position: fixed;
		top: 170rpx;
		bottom: 0;
		display: flex;
		flex-direction: column;
		background-color: #f5f5f5;

		.new-message-tip {
			flex-shrink: 0;
			background: linear-gradient(135deg, #2979ff, #07c160);
			padding: 20rpx;
			text-align: center;
			font-size: 26rpx;
		}

		.new-message-text {
			color: #ffffff;
		}

		.scroll-container {
			flex: 1;
			min-height: 0;
			width: 100%;
		}

		.list-box {
			width: 100%;
			padding: 20rpx;
			position: relative;
			.message-item {
				margin-bottom: 20rpx;
				padding: 24rpx;
				border-radius: 20rpx;
				background-color: #fff;
			}

			.message-header,
			.message-content-row {
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: space-between;
			}

			.message-title {
				flex: 1;
				font-size: 30rpx;
				color: #333;
				white-space: nowrap;
				text-overflow: ellipsis;
				overflow: hidden;
			}

			.message-content-row {
				margin-top: 16rpx;
			}

			.message-content {
				flex: 1;
				font-size: 26rpx;
				color: #666;
				white-space: nowrap;
				text-overflow: ellipsis;
				overflow: hidden;
			}

			.unread-box{
				display: flex;
				flex-shrink: 0;
				align-items: center;
				justify-content: center;
				padding: 4rpx 12rpx;
				background-color: #f56c6c;
				margin-left: 16rpx;
				border-radius: 20rpx;

				.unread-badge {
					color: #fff;
					font-size: 22rpx;
				}
			}

			

			.empty-state {
				display: flex;
				justify-content: center;
				padding: 50rpx 0;
				.empty-state-text {
					color: #999;
					font-size: 28rpx;
					text-align: center;
				}
			}

			.load-more {
				display: flex;
				flex-direction: row;
				justify-content: center;
				align-items: center;
				padding: 30rpx 0;
				.tips-text {
					color: #999;
					font-size: 26rpx;
					text-align: center;
				}
			}
		}
	}
</style>