type PushEventKind = 'received' | 'clicked' | 'custom'

type NormalizedPushEvent = {
	kind: PushEventKind
	payload: any
}

export type PushRegistrationIdReadyListener = (registrationId: string) => void
export type PushSessionAuthenticatedListener = (registrationId: string) => void

const pushRegistrationIdReadyListeners: Array<PushRegistrationIdReadyListener> = []
const pushSessionAuthenticatedListeners: Array<PushSessionAuthenticatedListener> = []

const PUSH_PENDING_MESSAGE_ID_KEY = 'push.pending_message_id.jpush'
const PUSH_MESSAGE_STALE_KEY = 'push.message_stale.jpush'
const PUSH_SESSION_KEY = 'push.session.jpush'
const PUSH_REGISTRATION_ID_KEY = 'push.registration_id.jpush'

const PUSH_REGISTRATION_ID_MAX_RETRY_COUNT = 5
const PUSH_REGISTRATION_ID_RETRY_DELAY = 3000

// Release/TestFlight/App Store packages must use APNs production. Development-signed
// packages can set a local override to false before launch when testing the sandbox.
const JPUSH_IOS_PRODUCTION_OVERRIDE_KEY = 'push_jpush_ios_production_override'
const DEFAULT_JPUSH_IOS_IS_PRODUCTION = true

// #ifdef APP-ANDROID
import AndroidLog from 'android.util.Log'
import {
	init as initAndroidJPush,
	setEventCallBack as setJPushEventCallBack,
	getRegistrationId as getAndroidJPushRegistrationId,
	setBadgeNumber as setAndroidJPushBadgeNumber
} from '@/uni_modules/jg-jpush-u'
import {
	init as initHuaweiJPushVendor
} from '@/uni_modules/jg-jpush-u-huawei'
// #endif
// #ifdef APP-IOS
import {
	initPush as initIosJPush,
	setEventCallBack as setJPushEventCallBack,
	getRegistrationId as getIosJPushRegistrationId,
	getRegistrationIdAsync as getIosJPushRegistrationIdAsync,
	resetBadge as resetIosJPushBadge
} from '@/uni_modules/jg-jpush-u'
// #endif

const JPUSH_APP_KEY = 'a53c28d734057573f67e16f7'
const JPUSH_CHANNEL = 'developer-default'

function pushDebug(message: string): void {
	// #ifdef APP-ANDROID
	AndroidLog.e('PushManager', message)
	// #endif
	console.error('[PushManager] ' + message)
}

function notifyPushRegistrationIdReady(registrationId: string): void {
	for (let index = 0; index < pushRegistrationIdReadyListeners.length; index++) {
		try {
			pushRegistrationIdReadyListeners[index](registrationId)
		} catch (error) {
			console.error('[PushManager] RegistrationID 就绪监听执行失败:', error)
		}
	}
}

function notifyPushSessionAuthenticated(registrationId: string): void {
	for (let index = 0; index < pushSessionAuthenticatedListeners.length; index++) {
		try {
			pushSessionAuthenticatedListeners[index](registrationId)
		} catch (error) {
			console.error('[PushManager] 已认证会话监听执行失败:', error)
		}
	}
}

function stringValue(value: any): string {
	if (value == null) return ''
	return value.toString()
}

function storageString(key: string): string {
	const value = uni.getStorageSync(key)
	return value == null ? '' : stringValue(value)
}

function payloadValue(payload: any, key: string): string {
	if (payload == null) return ''
	if (typeof payload == 'string') {
		try {
			const parsedPayload = JSON.parse<UTSJSONObject>(payload)
			if (parsedPayload == null) return ''
			return payloadValue(parsedPayload, key)
		} catch (error) {
			return ''
		}
	}
	try {
		const object = payload as UTSJSONObject
		return object.getString(key, '')
	} catch (error) {
		return ''
	}
}

function nestedPayloadValue(payload: any, key: string): string {
	let value = payloadValue(payload, key)
	if (value != '') return value
	const nestedKeys = ['data', 'extra', 'notificationExtras', 'extras']
	for (let index = 0; index < nestedKeys.length; index++) {
		const nestedValue = payloadValue(payload, nestedKeys[index])
		if (nestedValue == '') continue
		value = payloadValue(nestedValue, key)
		if (value != '') return value
	}
	return ''
}

// Business message IDs must be supplied in the notification payload/extras. JPush's
// msgId is a provider message ID, so it is intentionally not used as a fallback.
function pushMessageId(payload: any): string {
	let id = nestedPayloadValue(payload, 'messageId')
	if (id == '') id = nestedPayloadValue(payload, 'message_id')
	if (id == '') id = nestedPayloadValue(payload, 'id')
	return id
}

function jpushIosIsProduction(): boolean {
	const override = storageString(JPUSH_IOS_PRODUCTION_OVERRIDE_KEY)
	if (override == 'false') return false
	if (override == 'true') return true
	return DEFAULT_JPUSH_IOS_IS_PRODUCTION
}

interface PushAdapter {
	init(
		onEvent: (event: NormalizedPushEvent) => void,
		onRegistrationAvailable: () => void,
		onRegistrationId: (registrationId: string, reason: string) => void
	): void
	getRegistrationId(): string
}

class JPushAdapter implements PushAdapter {
	private initialized = false

	init(
		onEvent: (event: NormalizedPushEvent) => void,
		onRegistrationAvailable: () => void,
		onRegistrationId: (registrationId: string, reason: string) => void
	): void {
		if (this.initialized) return
		this.initialized = true
		// #ifdef APP-ANDROID || APP-IOS
		try {
			// The plugin caches early events, but registering before initialization prevents
			// unnecessary replay and guarantees registration events reach the manager.
			setJPushEventCallBack({
				callback: (event) => {
					const eventName = event.eventName
					const eventData = event.eventData
					if (eventName == 'onRegister' || (eventName == 'onConnected' && eventData == 'true')) {
						onRegistrationAvailable()
						return
					}
					if (eventName == 'onNotifyMessageArrived') {
						onEvent({ kind: 'received', payload: eventData })
						return
					}
					if (eventName == 'onCustomMessage') {
						onEvent({ kind: 'custom', payload: eventData })
						return
					}
					if (eventName == 'onClickMessage') {
						onEvent({ kind: 'clicked', payload: eventData })
					}
				}
			})
			// #ifdef APP-ANDROID
			// Load Huawei's JPush vendor channel before the JPush core SDK initializes.
			initHuaweiJPushVendor()
			// An empty value keeps using the AppKey configured in AndroidManifest.xml.
			initAndroidJPush('')
			// #endif
			// #ifdef APP-IOS
			const isProduction = jpushIosIsProduction()
			pushDebug('初始化 JPush iOS，APNs 环境: ' + (isProduction ? 'production' : 'development'))
			initIosJPush({
				appkey: JPUSH_APP_KEY,
				channel: JPUSH_CHANNEL,
				isProduction: isProduction,
				advertisingId: ''
			})
			getIosJPushRegistrationIdAsync((result) => {
				if (result.registrationId != '') {
					onRegistrationId(result.registrationId, '')
					return
				}
				if (result.code != 0) onRegistrationId('', 'JPush iOS RegistrationID 回调失败，错误码: ' + result.code)
			})
			// #endif
			onRegistrationAvailable()
		} catch (error) {
			pushDebug('初始化 JPush 失败: ' + error.toString())
		}
		// #endif
	}

	getRegistrationId(): string {
		// #ifdef APP-ANDROID
		try {
			return getAndroidJPushRegistrationId()
		} catch (error) {
			pushDebug('获取 JPush RegistrationID 失败: ' + error.toString())
		}
		// #endif
		// #ifdef APP-IOS
		try {
			return getIosJPushRegistrationId()
		} catch (error) {
			pushDebug('获取 JPush RegistrationID 失败: ' + error.toString())
		}
		// #endif
		return ''
	}
}

class PushManager {
	private adapter: PushAdapter | null = null
	private initialized = false
	private registrationRequesting = false
	private registrationRetryCount = 0
	private registrationRetryTimer: number = 0

	init(): void {
		if (this.initialized) {
			this.refreshRegistrationId()
			return
		}
		pushDebug('已选择推送 provider: jpush')
		this.adapter = new JPushAdapter()
		this.initialized = true
		this.adapter.init((event) => {
			this.handlePushEvent(event)
		}, () => {
			this.refreshRegistrationId()
		}, (registrationId, reason) => {
			// iOS returns the RegistrationID asynchronously after JPush network registration.
			if (!this.initialized) return
			if (registrationId != '') {
				this.saveRegistrationId(registrationId)
				return
			}
			if (reason != '') {
				pushDebug(reason)
				this.scheduleRegistrationRetry(reason)
			}
		})
		this.refreshRegistrationId()
	}

	refreshRegistrationId(): void {
		if (!this.initialized) this.init()
		if (this.adapter == null || this.registrationRequesting) return
		this.saveJPushRegistrationId()
	}

	markAuthenticated(): void {
		if (!this.initialized) this.init()
		uni.setStorageSync(PUSH_SESSION_KEY, 'authenticated')
		const cachedRegistrationId = this.getCachedRegistrationId()
		this.refreshRegistrationId()
		notifyPushSessionAuthenticated(cachedRegistrationId)
	}

	clearSessionState(): void {
		uni.removeStorageSync(PUSH_SESSION_KEY)
		uni.removeStorageSync(PUSH_PENDING_MESSAGE_ID_KEY)
		uni.removeStorageSync(PUSH_MESSAGE_STALE_KEY)
	}

	consumePendingMessageId(): string {
		const value = storageString(PUSH_PENDING_MESSAGE_ID_KEY)
		uni.removeStorageSync(PUSH_PENDING_MESSAGE_ID_KEY)
		return value
	}

	consumeStaleFlag(): boolean {
		const value = storageString(PUSH_MESSAGE_STALE_KEY)
		uni.removeStorageSync(PUSH_MESSAGE_STALE_KEY)
		return value == 'true'
	}

	getCachedRegistrationId(): string {
		return storageString(PUSH_REGISTRATION_ID_KEY)
	}

	clearBadge(): void {
		// #ifdef APP-IOS
		try {
			resetIosJPushBadge()
		} catch (error) {
			pushDebug('清除 iOS 应用角标失败: ' + error.toString())
		}
		// #endif
		// #ifdef APP-ANDROID
		try {
			setAndroidJPushBadgeNumber(0)
		} catch (error) {
			pushDebug('清除 Android 应用角标失败: ' + error.toString())
		}
		// #endif
	}

	private handlePushEvent(event: NormalizedPushEvent): void {
		this.clearBadge()
		const messageId = pushMessageId(event.payload)
		if (messageId != '') uni.setStorageSync(PUSH_PENDING_MESSAGE_ID_KEY, messageId)
		if (event.kind == 'received' || event.kind == 'clicked' || event.kind == 'custom') {
			uni.setStorageSync(PUSH_MESSAGE_STALE_KEY, true)
		}
		if (event.kind == 'clicked') {
			uni.switchTab({ url: '/pages/message/message' })
		}
	}

	private clearRegistrationTimers(): void {
		if (this.registrationRetryTimer > 0) {
			clearTimeout(this.registrationRetryTimer)
			this.registrationRetryTimer = 0
		}
	}

	private scheduleRegistrationRetry(reason: string): void {
		if (this.registrationRetryCount >= PUSH_REGISTRATION_ID_MAX_RETRY_COUNT) {
			pushDebug('设备注册 ID 获取超时，已停止重试。原因: ' + reason)
			return
		}
		if (this.registrationRetryTimer > 0) return
		this.registrationRetryCount += 1
		this.registrationRetryTimer = setTimeout(() => {
			this.registrationRetryTimer = 0
			this.refreshRegistrationId()
		}, PUSH_REGISTRATION_ID_RETRY_DELAY)
	}

	private saveRegistrationId(registrationId: string): void {
		this.clearRegistrationTimers()
		this.registrationRequesting = false
		if (registrationId == '') {
			this.scheduleRegistrationRetry('注册 ID 为空')
			return
		}
		this.registrationRetryCount = 0
		uni.setStorageSync(PUSH_REGISTRATION_ID_KEY, registrationId)
		pushDebug('JPush RegistrationID 已就绪')
		notifyPushRegistrationIdReady(registrationId)
	}

	private saveJPushRegistrationId(): void {
		if (this.adapter == null) return
		this.registrationRequesting = true
		const registrationId = this.adapter.getRegistrationId()
		this.registrationRequesting = false
		if (registrationId == '') {
			this.scheduleRegistrationRetry('JPush RegistrationID 为空')
			return
		}
		this.saveRegistrationId(registrationId)
	}
}

const pushManager = new PushManager()

export function initPush(): void {
	// #ifdef APP-ANDROID || APP-IOS
	pushManager.init()
	// #endif
}

export function refreshPushRegistrationId(): void {
	// #ifdef APP-ANDROID || APP-IOS
	pushManager.refreshRegistrationId()
	// #endif
}

export function clearPushBadge(): void {
	// #ifdef APP-ANDROID || APP-IOS
	pushManager.clearBadge()
	// #endif
}

export function markPushSessionAuthenticated(): void {
	// #ifdef APP-ANDROID || APP-IOS
	pushManager.markAuthenticated()
	// #endif
}

export function clearPushSessionState(): void {
	pushManager.clearSessionState()
}

export function consumePendingMessageId(): string {
	return pushManager.consumePendingMessageId()
}

export function consumePushStaleFlag(): boolean {
	return pushManager.consumeStaleFlag()
}

export function getCachedPushRegistrationId(): string {
	return pushManager.getCachedRegistrationId()
}

export function onPushRegistrationIdReady(listener: PushRegistrationIdReadyListener): void {
	pushRegistrationIdReadyListeners.push(listener)
}

export function onPushSessionAuthenticated(listener: PushSessionAuthenticatedListener): void {
	pushSessionAuthenticatedListeners.push(listener)
}
