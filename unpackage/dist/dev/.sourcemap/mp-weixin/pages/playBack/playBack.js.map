<template>
	<view class="container">
		<custom-navBar title="轨迹回放" :show-back="true" backgroundColor="#fff" textColor="#333" :showCapsule="false">
		</custom-navBar>
		<view class="map-container" id="track-map-container">
			<map v-if="isMapReady" id="myMap" :latitude="center.latitude" :longitude="center.longitude" :markers="markers"
				:polyline="polyline" :scale="mapScale" style="width:100%;height:100%" :show-location="false" :enable-traffic="true" :enable-overlooking="true" :enable-building="true" :enable-3D="true">
			</map>

			<!--
				播放期车标：普通 view 覆盖在 map 之上，固定钉在屏幕中心。
				这是"车标零闪动"的根本原因——车标不再属于原生 markers 覆盖物图层，
				播放期间完全不产生 markers 的 setData，也就完全避开了安卓端的图层销毁重建。
				地图中心每帧精确跟到车标经纬度，中心即车标，因此视觉上二者完全同频。
			-->
			<view v-if="showCarOverlay" class="car-overlay">
				<image class="car-overlay-icon" :src="carOverlayIcon" :style="'transform: rotate(' + carOverlayRotation + 'deg);'"></image>
			</view>

			<sub-navBar class="sub-nav-overlay" :showTime="false" :currentCar="plateNo" :showCar="true" :carStatus='carStatus'></sub-navBar>
		</view>

		<view class="tools-panel">
			<view class="Datetime-box">
				<view class="date-box">
					<i-icon name="/static/rili.png" fontSize="15"></i-icon>
					<view class="date-time-control" @click="showPicker('start')">
						<text class="date-part">{{getPlaybackDate(startTime)}} {{getPlaybackClock(startTime)}}</text>
					</view>
					<i-icon class="date-arrow" name="/static/xiangxia.png" fontSize="15" @click="showPicker('start')"></i-icon>
					<text class="date-separator">至</text>
					<view class="date-time-control" @click="showPicker('end')">
						<text class="date-part">{{getPlaybackDate(endTime)}} {{getPlaybackClock(endTime)}}</text>
					</view>
					<i-icon class="date-arrow" name="/static/xiangxia.png" fontSize="15" @click="showPicker('end')"></i-icon>
				</view>
			</view>
			<view class="tool-tag-item">
				<i-button type="primary" @click="togglePlayback" size="small" :text="isPlaying ? '暂停':'播放'"></i-button>
				<view class="slider">

					<i-slider v-model="playbackSpeed" :min="1" :max="30" :step="1"
						@change="setPlaybackSpeedFromValue">
					</i-slider>






				</view>
				<text class="speed-label">{{playbackSpeed}}x</text>
			</view>
			<view class="play-back-info">
				<view class="item-info">
					<text class="info-label">{{currentTime}}</text>
					<text class="info-label">时间</text>
				</view>
				<view class="item-info">
					<text class="info-label">{{currentSpeed}}Km/h</text>
					<text class="info-label">速度</text>
				</view>
				<view class="item-info">
					<text class="info-label">{{(totalDistance/1000).toFixed(1)}}Km</text>
					<text class="info-label">里程</text>
				</view>
			</view>
			<l-popup v-model="showDateTimePicker" position="bottom" :closeable="false">
				<l-date-time-picker confirm-btn="确认" cancel-btn="取消" :start="pickerMinTime" :end="pickerMaxTime" :value="pickerValue" :title="pickerTitle" :mode="63" format="YYYY-MM-DD HH:mm:ss" 
					@confirm="onConfirm" @cancel="onCancel">
				</l-date-time-picker>
			</l-popup>
		</view>
	</view>
	<app-toast></app-toast>
</template>

<script setup lang="uts">
import { isBusinessSuccessCode } from '../../api/response.uts'
import { showAppToast } from '../../utils/toast.uts'
	import { ref, reactive, onMounted, watch } from 'vue'
	import { getTrackPos } from '../../api/request.uts'
	import { formatTimes, normalizeLocalDateTime, parseLocalDateTime } from '../../utils/formateTime.uts'
	import { getDeviceIcon } from '../../utils/cars'
	// 导入坐标转换插件
	import CoordTransform from '../../utils/coordTransform.uts'
	import { getUserCurrentLocation } from '../../utils/getUserLocation.uts'





	type TrackPoint = {
		latitude : number;
		longitude : number;
		rotation : number;
		deviceTime : string;
		speed : number;
	}

	type TrackBounds = {
		minLat : number;
		maxLat : number;
		minLng : number;
		maxLng : number;
	}

	type MapPolylinePoint = {
		latitude: number
		longitude: number
	}

	type MpPolylineData = {
		points: Array<MapPolylinePoint>
		color: string
		width: number
		dottedLine: boolean
		arrowLine: boolean
		borderColor: string
		borderWidth: number
	}

	// 地图状态
	const center = reactive({
		latitude: 39.90469,
		longitude: 116.40717
	})
	const mapScale = ref<number>(12)
	const isMapReady = ref(false)
	const deviceNo = ref<string | null>('')
	const carStatus = ref<string | null>('')
	const plateNo = ref<string | null>('')
	const carType = ref<string | null>('')

	// 日期时间选择器相关
	const showDateTimePicker = ref(false)
	const currentPickerType = ref('start') // 'start' or 'end'
	const pickerTitle = ref('选择开始时间')

	// 轨迹回放相关
	type MapMarker = Marker

	const trackPoints = ref<Array<TrackPoint>>([])






	const polyline = ref<Array<MpPolylineData>>([])

	const isPlaying = ref(false)
	const isTrackPlayable = ref(false)
	const playbackSpeed = ref(1)
	const totalDistance = ref(0)
	const currentSpeed = ref(0)
	const currentTime = ref('')
	const currentIndex = ref(0)
	const carMarker = ref<MapMarker | null>(null)

	// 微信小程序里逻辑层与原生地图层是跨线程通信。关键认知：
	// "地图中心"和"车标"是两笔开销完全不同的 setData，编译后它们各自是一个独立的顶层绑定
	//（latitude/longitude 与 markers）：
	//   - center：只有两个数字，极轻，逐帧下发不会引起闪动；
	//   - markers：整个数组，微信端每收到一次赋值，安卓机就会销毁并重建整个 marker 覆盖物层。
	// 车标闪动的根因就在第二项：只要播放期间还在下发 markers，就一定会闪，节流只能让它
	// 闪得少一点，无法根治（长距离直线段车速高、每帧位移大，反而是每帧必发，闪得最明显）。
	// 因此最终方案是把播放期车标整体移出原生图层，改用普通 view 覆盖（.car-overlay）：
	// 覆盖层车标恒定钉在屏幕中心，只有地图在动，播放期间 markers 一次都不下发。
	const PLAYBACK_FRAME_INTERVAL_MS = 50





	// 播放期车标改为普通 view 覆盖物（见模板中的 .car-overlay），彻底移出原生 markers 图层。
	// 状态：是否显示覆盖层车标、覆盖层车标的图标与角度。
	// 覆盖层车标恒定钉在地图容器正中，因此它自身永远不需要移动——需要移动的只有地图。
	// 这样播放期间 markers 一次都不下发，安卓端不再有覆盖物层的销毁重建，闪动从根上消失。
	const showCarOverlay = ref(false)
	const carOverlayIcon = ref('/static/cars/online/default.png')
	const carOverlayRotation = ref(0)

	const MIN_SEGMENT_DURATION_MS = 500
	const MAX_SEGMENT_DURATION_MS = 6000
	const FALLBACK_SPEED_KMH = 20

	// 折线每次更新都要把整条轨迹的点跨线程传一遍、再由原生层整条重画，是小程序端最贵的
	// 一次 setData，也是安卓端闪动的主要来源。它只需让"已走/未走"的分界大致跟上即可，
	// 不需要和车标同频（车标已经压在分界前面，两者最多差一根线的宽度），因此间隔放大到
	// 1000ms，把跨线程通信预算尽量留给车标。
	const POLYLINE_RENDER_INTERVAL_MS = 1000





	// 车标角度变化小于该度数时不下发新的 rotate：地图端每收到一个不同的 rotate 都要重建
	// 车标视图，而 2° 以内的差异肉眼完全看不出来
	const MARKER_ROTATION_UPDATE_THRESHOLD = 2
	const renderedPoint = reactive<TrackPoint>({
		latitude: 0,
		longitude: 0,
		rotation: 0,
		deviceTime: '',
		speed: 0
	})
	const activeSegmentTargetIndex = ref(-1)
	let playbackTimer : number | null = null
	let replaySessionId = 0
	let lastPolylineRenderAt = 0
	// 上一次真正下发给地图的车标角度（用于过滤无意义的 rotate 变化）
	let lastCarMarkerRotation = 0

	function copyTrackPoint(point : TrackPoint) : TrackPoint {
		return {
			latitude: point.latitude,
			longitude: point.longitude,
			rotation: point.rotation,
			deviceTime: point.deviceTime,
			speed: point.speed
		}
	}

	function resetRenderedPoint(point : TrackPoint) : void {
		renderedPoint.latitude = point.latitude
		renderedPoint.longitude = point.longitude
		renderedPoint.rotation = point.rotation
		renderedPoint.deviceTime = point.deviceTime
		renderedPoint.speed = point.speed
	}

	// 两个角度之间的最短差值（-180~180）。朝向是环形量，必须按最短路径比较：
	// 从 359° 转到 1° 实际只转了 2°，直接相减会得到 -358°，导致每帧都误判为"大幅转向"。
	function shortestAngleDiff(from : number, to : number) : number {
		let difference = to - from
		if (difference > 180) difference -= 360
		else if (difference < -180) difference += 360
		return difference
	}

	function formatPlaybackTime(timestamp : number) : string {
		return formatTimes(timestamp) ?? ''
	}
	const now = new Date()
	const initialEndTime = formatTimes(now.getTime())
	const initialStartTime = formatTimes(now.getTime() - 3600000 * 6)
	const startTime = ref(initialStartTime)
	const endTime = ref(initialEndTime)

	function normalizePlaybackTime(value : string, fallback : string) : string {
		const milliseconds = parseLocalDateTime(value)
		return milliseconds == null ? fallback : formatPlaybackTime(milliseconds)
	}

	const pickerValue = computed(() : string => {
		return currentPickerType.value == 'start' ? startTime.value : endTime.value
	})

	const pickerMinTime = computed(() => {
		const now = new Date()
		return new Date(
			now.getFullYear(),
			now.getMonth() - 6,
			now.getDate(),
			0, 0, 0
		).getTime()
	})

	// 最大日期（当前时间）
	const pickerMaxTime = computed(() => {
		return Date.now()
	})

	function getPlaybackDate(value : string) : string {
		const parts = value.split(' ')
		return parts.length > 1 ? parts[0] : value
	}

	function getPlaybackClock(value : string) : string {
		const parts = value.split(' ')
		return parts.length > 1 ? parts[1] : ''
	}

	function setPlaybackTimeRange(startValue : string, endValue : string) : void {
		startTime.value = normalizePlaybackTime(startValue, startTime.value)
		endTime.value = normalizePlaybackTime(endValue, endTime.value)
	}

	const lat = ref<string | null>('')
	const lng = ref<string | null>('')

	// 标记点集合
	const markers = ref<Array<MapMarker>>([])

	// 日期函数
	function safeParseDate(dateStr : string) : number {
		return parseLocalDateTime(dateStr) ?? 0
	}

	// 规范化日期时间，确保展示和接口查询均精确到秒
	function normalizeDateTime(dateStr : string) : string {
		return normalizeLocalDateTime(dateStr)
	}

	function resolveRouteDateTime(dateStr : string) : string | null {
		if (dateStr == '') return null
		try {
			const decoded = (decodeURIComponent(dateStr) ?? '').replace(/\+/g, ' ').replace('T', ' ')
			const milliseconds = parseLocalDateTime(decoded)
			return milliseconds == null ? null : formatPlaybackTime(milliseconds)
		} catch (error) {
			uni.__f__('error','at pages/playBack/playBack.uvue:313','解析回放时间失败:', error)
			return null
		}
	}

	// 格式化日期显示
	function formatTimeForDisplay(dateStr : string) : string {
		const milliseconds = parseLocalDateTime(dateStr)
		return milliseconds == null ? dateStr : formatPlaybackTime(milliseconds)
	}

	function formatDateForDisplay(dateStr : string) : string {
		return normalizeDateTime(dateStr)
	}

	// 计算两点之间的方向角
	function calculateBearing(lat1 : number, lng1 : number, lat2 : number, lng2 : number) : number {
		const degToRad = (d : number) => d * Math.PI / 180
		const radToDeg = (r : number) => r * 180 / Math.PI

		const φ1 = degToRad(lat1)
		const φ2 = degToRad(lat2)
		const Δλ = degToRad(lng2 - lng1)

		const y = Math.sin(Δλ) * Math.cos(φ2)
		const x = Math.cos(φ1) * Math.sin(φ2) - Math.sin(φ1) * Math.cos(φ2) * Math.cos(Δλ)
		const θ = Math.atan2(y, x)

		return (radToDeg(θ) + 360) % 360
	}

	// 计算两点间距离（米）
	function getDistance(lat1 : number, lng1 : number, lat2 : number, lng2 : number) {
		const rad = (d : number) => d * Math.PI / 180.0
		const radLat1 = rad(lat1)
		const radLat2 = rad(lat2)
		const a = radLat1 - radLat2
		const b = rad(lng1) - rad(lng2)
		const s = 2 * Math.asin(Math.sqrt(Math.pow(Math.sin(a / 2), 2) +
			Math.cos(radLat1) * Math.cos(radLat2) * Math.pow(Math.sin(b / 2), 2)))
		return s * 6378.137 * 1000
	}

	// 计算轨迹边界
	function calculateTrackBounds() : TrackBounds | null {
		if (trackPoints.value.length == 0) return null

		let minLat = trackPoints.value[0].latitude
		let maxLat = trackPoints.value[0].latitude
		let minLng = trackPoints.value[0].longitude
		let maxLng = trackPoints.value[0].longitude

		trackPoints.value.forEach((point : TrackPoint) : void => {
			minLat = Math.min(minLat, point.latitude)
			maxLat = Math.max(maxLat, point.latitude)
			minLng = Math.min(minLng, point.longitude)
			maxLng = Math.max(maxLng, point.longitude)
		})

		return {
			minLat: minLat,
			maxLat: maxLat,
			minLng: minLng,
			maxLng: maxLng
		}
	}

	// ===== 视野控制 =====
	// 需求：查询出轨迹时整条路线要完整落在可视区内；只有开始播放后，才把车标定位到地图中心。
	// 因此这里按轨迹包围盒反算所需缩放级别（而不是拍几个固定档位），并在播放前保持全览视角。
	const MIN_TRACK_FIT_SCALE = 5.0      // 全览轨迹时的最小缩放级别
	const MAX_TRACK_FIT_SCALE = 17.0     // 全览轨迹时的最大缩放级别（避免短轨迹放得过近）
	const TRACK_FIT_MARGIN = 0.85        // 轨迹占可视区的比例，留边距防止端点贴屏
	const METERS_PER_DEGREE_LAT = 110540.0
	const METERS_PER_DEGREE_LNG = 111320.0
	const EARTH_RESOLUTION_BASE = 156543.03392  // zoom 为 0 时赤道上的地面分辨率（米/像素）

	// 地图容器的实际显示尺寸（px），用于把轨迹跨度换算成所需缩放级别
	let mapViewWidth = 0.0
	let mapViewHeight = 0.0
	let mapViewSizeMeasured = false

	// 测量地图容器尺寸；测不到就保留估算值，保证后续计算始终可用
	function measureMapViewportSize(callback : () => void) {
		try {
			const query = uni.createSelectorQuery()
			query.select('#track-map-container').boundingClientRect((rect : any) => {
				if (rect != null) {
					const nodeInfo = rect as NodeInfo
					const width = nodeInfo.width ?? 0
					const height = nodeInfo.height ?? 0
					if (width > 0 && height > 0) {
						mapViewWidth = width
						mapViewHeight = height
						mapViewSizeMeasured = true
					}
				}
				callback()
			}).exec()
		} catch (error) {
			uni.__f__('warn','at pages/playBack/playBack.uvue:413','测量地图容器尺寸失败:', error)
			callback()
		}
	}

	// 用系统信息估算可视区尺寸，避免测量完成前没有尺寸可用
	function ensureMapViewportEstimate() {
		if (mapViewWidth > 0 && mapViewHeight > 0) return
		try {
			const info = uni.getSystemInfoSync()
			mapViewWidth = info.windowWidth
			// 地图区位于顶部导航栏与底部控制面板之间，按约一半屏高估算
			mapViewHeight = info.windowHeight * 0.5
		} catch (error) {
			mapViewWidth = 375.0
			mapViewHeight = 300.0
		}
	}

	// 调整地图以完整显示整条轨迹：中心取包围盒中心，缩放按包围盒跨度反算
	function adjustMapToFitTrack() {
		const nullableBounds = calculateTrackBounds()
		if (nullableBounds == null) return
		const bounds = nullableBounds

		const midLat = (bounds.minLat + bounds.maxLat) / 2
		const midLng = (bounds.minLng + bounds.maxLng) / 2
		center.latitude = midLat
		center.longitude = midLng

		ensureMapViewportEstimate()
		const usableWidth = mapViewWidth * TRACK_FIT_MARGIN
		const usableHeight = mapViewHeight * TRACK_FIT_MARGIN
		if (usableWidth <= 0 || usableHeight <= 0) return

		let cosLat = Math.cos(midLat * Math.PI / 180.0)
		if (cosLat < 0.01) cosLat = 0.01

		// 包围盒在南北、东西方向的实际跨度（米）
		const spanLatMeters = (bounds.maxLat - bounds.minLat) * METERS_PER_DEGREE_LAT
		const spanLngMeters = (bounds.maxLng - bounds.minLng) * METERS_PER_DEGREE_LNG * cosLat

		// 需要的地面分辨率（米/像素）：取两个方向中更严格的一侧
		const neededResolution = Math.max(spanLatMeters / usableHeight, spanLngMeters / usableWidth)

		// Web Mercator：地面分辨率 = EARTH_RESOLUTION_BASE × cos(lat) / 2^zoom
		let zoom = MAX_TRACK_FIT_SCALE
		if (neededResolution > 0.0001) {
			const baseResolution = EARTH_RESOLUTION_BASE * cosLat
			zoom = Math.log(baseResolution / neededResolution) / Math.log(2.0)
		}
		// 向下取整，确保整条轨迹确实放得下
		let finalZoom = Math.floor(zoom)
		if (finalZoom > MAX_TRACK_FIT_SCALE) finalZoom = MAX_TRACK_FIT_SCALE
		if (finalZoom < MIN_TRACK_FIT_SCALE) finalZoom = MIN_TRACK_FIT_SCALE
		mapScale.value = finalZoom
	}

	// 适配视野：先用当前尺寸算一次，测到地图容器精确尺寸后再校正一次
	function applyTrackViewportFit() {
		adjustMapToFitTrack()
		if (mapViewSizeMeasured) return
		measureMapViewportSize(() => {
			adjustMapToFitTrack()
		})
	}

	// 播放阶段把车标置于地图中心（查询出轨迹时不做这件事，保持整条路线全览）
	function focusMapOnVehicle() {
		if (trackPoints.value.length == 0) return
		center.latitude = renderedPoint.latitude
		center.longitude = renderedPoint.longitude
	}

	// 计算轨迹总距离
	function calculateTrackDistance() {
		totalDistance.value = 0
		for (let i = 1; i < trackPoints.value.length; i++) {
			totalDistance.value += getDistance(
				trackPoints.value[i - 1].latitude,
				trackPoints.value[i - 1].longitude,
				trackPoints.value[i].latitude,
				trackPoints.value[i].longitude
			)
		}
	}

	// 初始化时间
	function initDateTime() {
		const now = new Date()
		setPlaybackTimeRange(
			formatPlaybackTime(now.getTime() - 3600000 * 6),
			formatPlaybackTime(now.getTime())
		)
	}

	// 起点 / 终点标记。必须持有引用而不能是 initCarMarker 的局部变量：
	// 微信小程序播放期间车标改由 .car-overlay 覆盖物承担（原生 markers 里只剩起终点），
	// 暂停或播放结束时由 applyFullMarkers 重新组装完整数组。
	let startMarker : MapMarker | null = null
	let endMarker : MapMarker | null = null

	// 初始化小车标记
	function initCarMarker() {
		if (trackPoints.value.length == 0) return

		const firstPoint = trackPoints.value[0]
		const deviceIcon = getDeviceIcon(carStatus.value ?? '', carType.value ?? '')
		const marker : MapMarker = {
			id: 999,
			latitude: firstPoint.latitude,
			longitude: firstPoint.longitude,
			iconPath: deviceIcon,
			width: 25,
			height: 25,
			rotate: firstPoint.rotation,
			anchor: { x: 0.5, y: 0.5 }
		}
		carMarker.value = marker
		lastCarMarkerRotation = firstPoint.rotation

		// 覆盖层车标复用同一张车辆图标，起播时直接可用
		carOverlayIcon.value = deviceIcon
		carOverlayRotation.value = firstPoint.rotation


		const start : MapMarker = {
			id: 1000,
			latitude: firstPoint.latitude,
			longitude: firstPoint.longitude,
			iconPath: '/static/start.png',
			width: 24,
			height: 24,
			anchor: { x: 0.5, y: 0.5 },
			callout: { content: '起点', borderRadius: 5, padding: 5, display: 'BYCLICK' }
		}
		const lastPoint = trackPoints.value[trackPoints.value.length - 1]
		const end : MapMarker = {
			id: 1001,
			latitude: lastPoint.latitude,
			longitude: lastPoint.longitude,
			iconPath: '/static/end.png',
			width: 24,
			height: 24,
			anchor: { x: 0.5, y: 0.5 },
			callout: { content: '终点', borderRadius: 5, padding: 5, display: 'BYCLICK' }
		}
		startMarker = start
		endMarker = end
		markers.value = [marker, start, end]
	}

	// 把车标与起终点标记组装成完整的 markers 数组（暂停、结束、换轨迹时调用）
	function applyFullMarkers() {
		const car = carMarker.value
		if (car == null) return
		const list : Array<MapMarker> = [car]
		if (startMarker != null) list.push(startMarker)
		if (endMarker != null) list.push(endMarker)
		markers.value = list
	}






























































	function toMpPoints(points : Array<TrackPoint>) : Array<MapPolylinePoint> {
		return points.map((point : TrackPoint) : MapPolylinePoint => ({
			latitude: point.latitude,
			longitude: point.longitude
		}))
	}



	// 单次 setData 下发给地图的折线点数上限。长轨迹动辄上千个点，全量传输会把
	// JS↔原生桥打满，安卓机上直接表现为覆盖物反复重建、车标闪动。
	// 手机屏幕只有几百像素宽，抽稀到 400 点形状上完全看不出差别。
	const MAX_POLYLINE_POINTS = 400

	// 等距抽稀后转换为小程序折线点。关键在于"先抽稀、再转换"：若先转换再抽稀，
	// 会为每个原始点都创建一个对象再把大部分丢掉，长轨迹下这是纯粹的 CPU 浪费，
	// 而这段代码正跑在动画帧的关键路径上，会挤占车标下发的时机。
	function toThinnedMpPoints(points : Array<TrackPoint>) : Array<MapPolylinePoint> {
		const total = points.length
		if (total <= MAX_POLYLINE_POINTS || MAX_POLYLINE_POINTS < 2) return toMpPoints(points)
		const step = (total - 1) / (MAX_POLYLINE_POINTS - 1)
		const thinned : Array<MapPolylinePoint> = []
		let lastIndex = -1
		for (let i = 0; i < MAX_POLYLINE_POINTS; i++) {
			// 保证首尾两点（车标所在端）不被丢掉
			const index = Math.round(step * i)
			if (index == lastIndex) continue
			lastIndex = index
			const point = points[index]
			thinned.push({ latitude: point.latitude, longitude: point.longitude })
		}
		return thinned
	}

	function updatePolyline() {
		if (trackPoints.value.length < 2) {
			polyline.value = []
			return
		}

		const isAnimatingSegment = activeSegmentTargetIndex.value > currentIndex.value
		const playedPoints = trackPoints.value.slice(0, currentIndex.value + 1)
		if (isAnimatingSegment) {
			playedPoints.push(copyTrackPoint(renderedPoint))
		}
		const unplayedStartIndex = isAnimatingSegment ? activeSegmentTargetIndex.value : currentIndex.value
		const lines : Array<MpPolylineData> = []
		const unplayedPoints = trackPoints.value.slice(unplayedStartIndex)
		if (isAnimatingSegment) {
			unplayedPoints.unshift(copyTrackPoint(renderedPoint))
		}
		// 与 Flutter 端（car_flutter/lib/views/vehicle/playback）保持一致：
		// 未播放 = 灰色虚线，已播放 = 蓝色实线，两条线宽相同，蓝色画在灰色之上正好盖住已走过的部分。
		// 绘制顺序即数组顺序，灰色在前、蓝色在后。
		if (unplayedPoints.length >= 2) {
			lines.push({
				points: toThinnedMpPoints(unplayedPoints),
				color: '#999999',
				width: 3,
				dottedLine: true,
				arrowLine: false,
				borderColor: '#FFFFFF',
				borderWidth: 0
			})
		}
		if (playedPoints.length >= 2) {
			lines.push({
				points: toThinnedMpPoints(playedPoints),
				color: '#1890FF',
				width: 3,
				dottedLine: false,
				arrowLine: false,
				borderColor: '#FFFFFF',
				borderWidth: 0
			})
		}
		polyline.value = lines
	}

	function initPolyline() {
		updatePolyline()
	}



















































	// 当前缩放级别下 1 个屏幕像素对应的地面距离（米）
	function getMetersPerPixelOfScale(latitude : number) : number {
		let cosLat = Math.cos(latitude * Math.PI / 180.0)
		if (cosLat < 0.01) cosLat = 0.01
		const resolution = EARTH_RESOLUTION_BASE * cosLat / Math.pow(2.0, mapScale.value)
		return resolution > 0.0001 ? resolution : 1.0
	}


	// 更新小车位置。force = true 时跳过节流强制下发一帧，用于"位置必须立即对齐"的场合：
	// 起播、重置、以及每段动画结束（否则车标会停在最后一次推送处，播放结束时与终点差一小段）。
	function updateCarPosition(force : boolean) {
		const marker = carMarker.value
		if (marker != null && trackPoints.value.length > 0 && currentIndex.value < trackPoints.value.length) {
			// 地图中心每帧都跟随车标：center 编译后只是 latitude/longitude 两个数字的
			// 独立顶层绑定，下发成本极轻，不会触发安卓端的覆盖物重建，因此可以放心逐帧更新。
			// 只有播放中才跟随——未播放时地图保持整条轨迹全览。
			// 这一段必须放在下面的 markers 死区判断之前：早先把两者绑在同一个门控上，
			// 导致低缩放下每秒才下发一次，镜头和车标一起"顿"一下，观感就是"一顿一顿"。
			if (isPlaying.value) {
				center.latitude = renderedPoint.latitude
				center.longitude = renderedPoint.longitude
			}


			// 播放期间：车标由 .car-overlay 这个普通 view 承担，它恒定钉在屏幕中心，
			// 地图中心又已经精确跟到车标经上，因此覆盖层车标不需要再移动，只需要更新朝向。
			// 这里是全文件最重要的分支：它让播放过程彻底不再触碰 markers，
			// 从而彻底避开安卓端"每次 markers 赋值 → 销毁重建整个覆盖物层 → 车标闪一下"的开销。
			if (isPlaying.value) {
				const overlayDiff = shortestAngleDiff(renderedPoint.rotation, carOverlayRotation.value)
				if (force || Math.abs(overlayDiff) >= MARKER_ROTATION_UPDATE_THRESHOLD) {
					carOverlayRotation.value = renderedPoint.rotation
				}
				// 播放中不更新原生车标 marker，直接返回。
				// 地图中心已在上面更新完毕，覆盖层车标角度也已刷新，二者已完全同频。
				return
			}


			// 角度变化小于阈值时沿用上一次下发的角度：地图端每收到一个不同的 rotate 都要
			// 重建车标视图，小程序（尤其安卓）上会表现为车标闪动，而 2° 以内看不出来
			const rotationDiff = shortestAngleDiff(renderedPoint.rotation, lastCarMarkerRotation)
			const markerRotation = Math.abs(rotationDiff) >= MARKER_ROTATION_UPDATE_THRESHOLD
				? renderedPoint.rotation
				: lastCarMarkerRotation
			lastCarMarkerRotation = markerRotation

			const updatedMarker : MapMarker = {
				id: marker.id,
				latitude: renderedPoint.latitude,
				longitude: renderedPoint.longitude,
				iconPath: marker.iconPath,
				width: marker.width,
				height: marker.height,
				rotate: markerRotation,
				anchor: marker.anchor,
				callout: marker.callout,
				label: marker.label
			}
			carMarker.value = updatedMarker
			markers.value = [updatedMarker, ...markers.value.slice(1)]
		}
	}

	// 显示日期时间选择器
	function showPicker(type : string) {
		currentPickerType.value = type
		pickerTitle.value = type == 'start' ? '选择开始时间' : '选择结束时间'
		showDateTimePicker.value = true
	}

	// 显示当前位置
	function showCurrentPosition(message : string = '这段时间没有数据') {
		isTrackPlayable.value = false
		const originalLatText = lat.value ?? ''
		const originalLngText = lng.value ?? ''
		const originalLat = parseFloat(originalLatText)
		const originalLng = parseFloat(originalLngText)
		if (isNaN(originalLat) || isNaN(originalLng) || originalLat == 0 || originalLng == 0) {
			showAppToast({
				title: message,
				icon: 'none',
				duration: 2000
			})
			// 设备无有效位置，回退展示用户当前位置
			showUserLocationFallback()
			return
		}

		showAppToast({
			title: message,
			icon: 'none',
			duration: 2000
		})
		// 转换坐标到腾讯地图坐标系
		const convertedCoord = CoordTransform.wgs84ToTencent(originalLat, originalLng)

		// 设置地图中心点
		center.latitude = convertedCoord.lat
		center.longitude = convertedCoord.lng
		mapScale.value = 15

		// 创建当前位置标记
		const currentPoint : TrackPoint = {
			latitude: convertedCoord.lat,
			longitude: convertedCoord.lng,
			rotation: 0,
			deviceTime: new Date().toLocaleString(),
			speed: 0
		}

		// 初始化小车标记
		const marker : MapMarker = {
			id: 999,
			latitude: currentPoint.latitude,
			longitude: currentPoint.longitude,
			iconPath: getDeviceIcon(carStatus.value ?? '', carType.value ?? ''),
			width: 25,
			height: 25,
			rotate: 0,
			anchor: { x: 0.5, y: 0.5 }
		}
		carMarker.value = marker
		resetRenderedPoint(currentPoint)

		// 设置标记点
		markers.value = [marker]
		isMapReady.value = true
	}


	// 设备无有效位置（无轨迹 / 无车辆位置）时，回退到用户当前位置并展示「当前位置」标记
const showUserLocationFallback = async () => {
	const userLoc = await getUserCurrentLocation()
	if (userLoc == null) return
	center.latitude = userLoc.latitude
	center.longitude = userLoc.longitude
	mapScale.value = 12
	const userMarker = {
		id: 10004,
		latitude: userLoc.latitude,
		longitude: userLoc.longitude,
		width: 25,
		height: 25,
		iconPath: '/static/current-location.png',
		callout: {
			content: '当前位置',
			color: carStatus.value == 'online' ? '#ffffff' : '#999999',
			borderRadius: 10,
			bgColor: carStatus.value == 'online' ? '#1296db' : '#CCCCCC',
			padding: 5,
			display: 'ALWAYS'
		}
	} as Marker
	markers.value = [userMarker]
	isMapReady.value = true
}

function clearTrackDisplay() : void {
		isMapReady.value = false
		trackPoints.value = []
		isTrackPlayable.value = false
		currentIndex.value = 0
		activeSegmentTargetIndex.value = -1
		renderedPoint.latitude = 0
		renderedPoint.longitude = 0
		renderedPoint.rotation = 0
		renderedPoint.deviceTime = ''
		renderedPoint.speed = 0
		currentSpeed.value = 0
		currentTime.value = ''
		totalDistance.value = 0
		carMarker.value = null
		markers.value = []
		lastCarMarkerRotation = 0
		lastPolylineRenderAt = 0






		polyline.value = []

		}

		function clearPlaybackTimer() : void {
		const timer = playbackTimer
		if (timer != null) {
			clearTimeout(timer)
			playbackTimer = null
		}
	}

	function pausePlayback() : void {
		isPlaying.value = false
		clearPlaybackTimer()

		// 收尾：隐藏覆盖层车标，交还给原生 markers 车标。
		// 两者切换发生在同一帧，地图中心本就停在车标经纬度上，因此视觉上是同一个位置无缝接力，
		// 不会看到车标跳动或消失。
		showCarOverlay.value = false

		// 暂停 / 播放结束时的收尾对齐：强制下发一帧车标。
		// 覆盖层车标只是显示层的一层薄纱，真实位置由原生 markers 车标承载，
		// 因此必须让它精确落在最后一个渲染点上，否则暂停后会看到车标与覆盖层错位一小段。
		if (carMarker.value != null && trackPoints.value.length > 0) {
			updateCarPosition(true)
			applyFullMarkers()
		}
	}

	function renderPlaybackIndex() : void {
		if (trackPoints.value.length == 0) return
		if (activeSegmentTargetIndex.value <= currentIndex.value) {
			resetRenderedPoint(trackPoints.value[currentIndex.value])
		}
		// 强制下发一帧：这里的位置是"跳变后的确定值"（段末、重置、载入完成），必须精确对齐。
		// 微信端播放中该调用只更新覆盖层车标朝向、不碰 markers（见 updateCarPosition）；
		// 非播放时则用它把原生车标 marker 落到准确位置。
		updateCarPosition(true)
		updatePolyline()
		// 这里已经完整重画过一次折线，重置节流时间戳，避免紧接着的动画帧马上再重画一次
		lastPolylineRenderAt = Date.now()
		// 非播放状态下组装完整的 markers（车标 + 起点 + 终点）。
		// 播放中必须跳过：此时原生 markers 里只有静止的起终点，
		// 一旦在这里把车标补回，播放过程就会重新开始下发 markers，闪动立刻回来。
		if (!isPlaying.value) {
			applyFullMarkers()
		}
		const point = trackPoints.value[currentIndex.value]
		currentSpeed.value = point.speed
		currentTime.value = point.deviceTime
	}


	// 处理轨迹数据
	function processTrackData(positions : Array<UTSJSONObject>) : void {
		const processedPoints : Array<TrackPoint> = []
		let lastRetainedLat : number | null = null
		let lastRetainedLng : number | null = null

		for (let i = 0; i < positions.length; i++) {
			const point = positions[i]
			const deviceTimeStr = point.getString('deviceTime', '')
			const originalLat = point.getNumber('latitude', 0)
			const originalLng = point.getNumber('longitude', 0)

			if (originalLat == 0 || originalLng == 0 ||
				!isFinite(originalLat) || !isFinite(originalLng) ||
				deviceTimeStr == '' || safeParseDate(deviceTimeStr) == 0) {
				continue
			}

			if (lastRetainedLat != null && lastRetainedLng != null &&
				originalLat == lastRetainedLat && originalLng == lastRetainedLng) {
				continue
			}

			const convertedCoord = CoordTransform.wgs84ToTencent(originalLat, originalLng)
			if (!isFinite(convertedCoord.lat) || !isFinite(convertedCoord.lng)) {
				continue
			}

			lastRetainedLat = originalLat
			lastRetainedLng = originalLng
			processedPoints.push({
				latitude: convertedCoord.lat,
				longitude: convertedCoord.lng,
				rotation: 0,
				deviceTime: formatDateForDisplay(deviceTimeStr),
				speed: point.getNumber('speed', 0)
			})
		}

		for (let i = 1; i < processedPoints.length; i++) {
			const previousPoint = processedPoints[i - 1]
			const currentPoint = processedPoints[i]
			currentPoint.rotation = calculateBearing(
				previousPoint.latitude, previousPoint.longitude,
				currentPoint.latitude, currentPoint.longitude
			)
		}

		if (processedPoints.length > 1) {
			processedPoints[processedPoints.length - 1].rotation =
				processedPoints[processedPoints.length - 2].rotation
		}

		trackPoints.value = processedPoints
		isTrackPlayable.value = processedPoints.length > 1
		currentIndex.value = 0
		activeSegmentTargetIndex.value = -1
		lastPolylineRenderAt = 0
		if (processedPoints.length == 0) return
		resetRenderedPoint(processedPoints[0])
		calculateTrackDistance()
		initCarMarker()
		initPolyline()
		// 查出轨迹后先完整展示整条路线；此处不再把中心改成轨迹起点，
		// 播放时改由 focusMapOnVehicle() 与逐帧跟随把车标定位到地图中心。
		applyTrackViewportFit()
		renderPlaybackIndex()
		// 未开始播放时车辆处于静止状态，速度显示 0；播放中由渲染帧更新为对应点的速度
		currentSpeed.value = 0
		isMapReady.value = true
	}
	const loadTrackPos = async () => {
		pausePlayback()
		const requestId = ++replaySessionId
		clearTrackDisplay()
		uni.showLoading({ title: '加载中...' })
		const data = {
			deviceNo: deviceNo.value,
			startTime: startTime.value.replace(/\//g, '-'),
			endTime: endTime.value.replace(/\//g, '-'),
			minParkTime: 2,
			withStop: false,
			withPos: true,
			withTrip: false,
		}

		try {
			const res = await getTrackPos(data)
			if (requestId != replaySessionId) return

			if (!isBusinessSuccessCode(res.code)) {
				showCurrentPosition(res.msg || '轨迹加载失败')
				return
			}

			uni.__f__('log','at pages/playBack/playBack.uvue:1101','加载轨迹成功:', res)

			const trackData = res.data
			if (trackData == null) {
				showCurrentPosition()
				return
			}
			const positions = trackData.getArray<UTSJSONObject>('positions')
			if (positions != null && positions.length > 0) {
				processTrackData(positions)
				if (trackPoints.value.length == 0) {
					showCurrentPosition()
				}
			} else {
				showCurrentPosition()
			}
		} catch (error) {
			if (requestId != replaySessionId) return
			uni.__f__('error','at pages/playBack/playBack.uvue:1119','加载轨迹失败:', error)
			showAppToast({ title: '轨迹加载失败', icon: 'none' })
			if (!isNaN(parseFloat(lat.value ?? '')) && !isNaN(parseFloat(lng.value ?? ''))) {
				showCurrentPosition()
			}
		} finally {
			if (requestId == replaySessionId) {
				uni.hideLoading()
			}
		}
	}

	function resetPlayback() {
		pausePlayback()
		currentIndex.value = 0
		activeSegmentTargetIndex.value = -1
		renderPlaybackIndex()
		// 回到未播放状态，视野同步恢复为整条轨迹全览
		applyTrackViewportFit()
	}

	function getShortestRotationDifference(from : number, to : number) : number {
		let difference = to - from
		if (difference > 180) difference -= 360
		else if (difference < -180) difference += 360
		return difference
	}

	function getSegmentDuration(start : TrackPoint, end : TrackPoint) : number {
		const distance = getDistance(start.latitude, start.longitude, end.latitude, end.longitude)
		const recordedSpeed = start.speed > 0 && isFinite(start.speed) ? start.speed : end.speed
		const speed = recordedSpeed > 0 && isFinite(recordedSpeed) ? recordedSpeed : FALLBACK_SPEED_KMH
		const duration = distance / (speed / 3.6) * 1000 / playbackSpeed.value
		return Math.min(MAX_SEGMENT_DURATION_MS, Math.max(MIN_SEGMENT_DURATION_MS, duration))
	}

	function finishPlayback() : void {
		pausePlayback()
		activeSegmentTargetIndex.value = -1
		// 播放结束后车辆为停止状态，速度显示 0
		currentSpeed.value = 0
		showAppToast({
			title: '轨迹回放完成',
			icon: 'none',
			duration: 1500
		})
	}

	function animateNextSegment(sessionId : number) : void {
		if (!isPlaying.value || sessionId != replaySessionId) return
		if (currentIndex.value >= trackPoints.value.length - 1) {
			finishPlayback()
			return
		}

		const startPoint : TrackPoint = {
			latitude: renderedPoint.latitude,
			longitude: renderedPoint.longitude,
			rotation: renderedPoint.rotation,
			deviceTime: renderedPoint.deviceTime,
			speed: renderedPoint.speed
		}
		const targetIndex = currentIndex.value + 1
		const targetPoint = trackPoints.value[targetIndex]
		const rotationDifference = getShortestRotationDifference(startPoint.rotation, targetPoint.rotation)
		const duration = getSegmentDuration(startPoint, targetPoint)
		const startedAt = Date.now()
		activeSegmentTargetIndex.value = targetIndex

		let renderFrame : (() => void) | null = null
		renderFrame = () : void => {
			if (!isPlaying.value || sessionId != replaySessionId) return
			const progress = Math.min((Date.now() - startedAt) / duration, 1)
			renderedPoint.latitude = startPoint.latitude + (targetPoint.latitude - startPoint.latitude) * progress
			renderedPoint.longitude = startPoint.longitude + (targetPoint.longitude - startPoint.longitude) * progress
			renderedPoint.rotation = (startPoint.rotation + rotationDifference * progress + 360) % 360
			renderedPoint.deviceTime = targetPoint.deviceTime
			renderedPoint.speed = targetPoint.speed
			// 播放过程中同步展示当前对应点的速度与时间
			currentSpeed.value = renderedPoint.speed
			currentTime.value = renderedPoint.deviceTime
			// 动画帧内按节流下发
			updateCarPosition(false)

			// 折线重绘是O(n) 的计算（切片 + 坐标转换 + 抽稀），长轨迹下足以占用几十毫秒。
			// 它与车标共用同一条跨线程通道，若在帧内同步执行，会推迟本帧车标的 setData，
			// 表现为车标周期性地"顿"一下。所以先算好下一帧的调度时刻（纯整数运算，开销可忽略），
			// 让车标与镜头先完成下发，再把折线重绘排到它后面的独立任务里执行。
			const frameNow = Date.now()
			const polylineDue = frameNow - lastPolylineRenderAt >= POLYLINE_RENDER_INTERVAL_MS
			if (polylineDue) {
				lastPolylineRenderAt = frameNow
			}

			if (progress >= 1) {
				currentIndex.value = targetIndex
				activeSegmentTargetIndex.value = -1
				resetRenderedPoint(targetPoint)
				renderPlaybackIndex()
				animateNextSegment(sessionId)
				return
			}
			if (renderFrame != null) {
				// 自校正调度：setTimeout 递归调用会逐帧累积漂移（安卓上尤甚），实际帧率
				// 会明显低于设定值，表现为"一顿一顿"。这里始终以本段起点为基准计算下一帧的
				// 目标时刻，若已落后于该时刻则立即补帧，从而把帧率稳定在设定值上。
				const nextFrameAt = startedAt + (Math.floor((frameNow - startedAt) / PLAYBACK_FRAME_INTERVAL_MS) + 1) * PLAYBACK_FRAME_INTERVAL_MS
				const delay = nextFrameAt - frameNow
				playbackTimer = setTimeout(() => { renderFrame?.() }, delay > 0 ? delay : 0)
			}
			// 折线重绘放在下一帧的调度之后：此时车标与镜头的 setData 已经被收集并发出，
			// 这段计算不会再抢在它们前面。若播放状态已变化则直接跳过，避免多余开销。
			if (polylineDue) {
				const polylineSessionId = sessionId
				setTimeout(() => {
					if (!isPlaying.value || polylineSessionId != replaySessionId) return
					updatePolyline()
				}, 0)
			}
		}

		renderFrame?.()
	}

	function startPlayback() {
		if (!isTrackPlayable.value) {
			showAppToast({ title: '没有轨迹数据', icon: 'none' })
			return
		}

		if (currentIndex.value >= trackPoints.value.length - 1) {
			resetPlayback()
		}

		activeSegmentTargetIndex.value = -1
		isPlaying.value = true

		// 起播这一刻完成车标交接：显示覆盖层车标，同时把原生 markers 里的车标剔除，
		// 只留下静止的起点 / 终点标记。
		// 从这一帧起，整段播放过程 markers 数组再也不会被赋值——
		// 安卓端不再有覆盖物层的销毁重建，车标闪动被彻底消除。
		showCarOverlay.value = true
		carOverlayRotation.value = renderedPoint.rotation
		markers.value = markers.value.slice(1)

		// 开始播放：此刻才把车标定为地图中心（查询阶段保持整条轨迹全览）
		focusMapOnVehicle()
		lastPolylineRenderAt = 0
		const sessionId = ++replaySessionId
		animateNextSegment(sessionId)
	}
	// 播放控制
	function togglePlayback() {
		if (isPlaying.value) {
			pausePlayback()
		} else {
			startPlayback()
		}
	}

	// 确认选择时间
	function onConfirm(value : string) {
		const formattedValue = normalizeDateTime(value)

		if (currentPickerType.value == 'start') {
			setPlaybackTimeRange(formattedValue, endTime.value ?? '')
		} else {
			setPlaybackTimeRange(startTime.value ?? '', formattedValue)
		}
		resetPlayback()
		void loadTrackPos()
		showDateTimePicker.value = false
	}
	// 取消选择时间
	function onCancel() {
		showDateTimePicker.value = false
	}

	// 重置回放

	function applyPlaybackSpeed(value : number) : void {
		if (!isFinite(value)) return
		playbackSpeed.value = Math.min(30, Math.max(1, value))
		if (!isPlaying.value) return

		clearPlaybackTimer()
		const sessionId = ++replaySessionId
		animateNextSegment(sessionId)
	}

	// i-slider 对外发送数值，原生 slider 发送事件对象
	function setPlaybackSpeedFromValue(value : number) : void {
		applyPlaybackSpeed(value)
	}

	function setPlaybackSpeed(event : UniSliderChangeEvent) : void {
		applyPlaybackSpeed(event.detail.value)
	}

	const normalizeRouteValue = (value: any | null): string => {
		if (value == null) return ''
		const text = value.toString().trim()
		if (text == '' || text == 'null' || text == 'undefined') return ''
		try {
			const decoded = decodeURIComponent(text)
			return decoded == null ? text : decoded.trim()
		} catch (error) {
			return text
		}
	}

	onLoad((option) => {
		deviceNo.value = option.deviceNo ?? null
		carStatus.value = option.connectionStatus ?? ''
		const displayCarName = normalizeRouteValue(option.plateNo ?? '')
		plateNo.value = displayCarName != '' ? displayCarName : (deviceNo.value ?? '未命名设备')
		carType.value = normalizeRouteValue(option.carType ?? '')
		lat.value = option.lat ?? null
		lng.value = option.lng ?? null
		startTime.value = option.startTime ?? ''
		endTime.value = option.endTime ?? ''
		uni.__f__('log','at pages/playBack/playBack.uvue:1340','plateNo:', plateNo.value)
		const routeStartTime = resolveRouteDateTime(startTime.value)
		const routeEndTime = resolveRouteDateTime(endTime.value)
		if (routeStartTime != null && routeEndTime != null) {
			setPlaybackTimeRange(routeStartTime, routeEndTime)
			loadTrackPos()
		} else {
			initDateTime()
			loadTrackPos()
		}

	})

	onReady(() => {
		// 页面渲染完成后用实测的地图容器尺寸再校正一次全览视野，
		// 避免只依赖系统信息的估算值导致整条轨迹没有完全落在可视区内
		measureMapViewportSize(() => {
			if (trackPoints.value.length > 0 && !isPlaying.value) adjustMapToFitTrack()
		})
	})

	onHide(() => {
		pausePlayback()
		++replaySessionId
	})

	onUnload(() => {
		pausePlayback()
		++replaySessionId
	})



</script>

