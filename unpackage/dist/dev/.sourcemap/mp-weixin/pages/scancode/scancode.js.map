<template>
	<view class="container">
		<view class="scancode-box">
			<camera
				v-if="cameraVisible"
				device-position="back"
				mode="scanCode"
				flash="auto"
				class="scan-code"
				resolution="high"
				@initdone="handleCameraInitDone"
				@scancode="handleScan"
				@stop="handleCameraStop"
				@error="handleCameraError">
			</camera>
		</view>
		<view class="tip">请将设备二维码或条形码放入框内，自动扫描</view>
		<app-toast></app-toast>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { showAppToast } from '../../utils/toast.uts'

	const scanFunctionIsUseable = ref(true)
	const cameraVisible = ref(true)
	const hasFinished = ref(false)
	const pendingBack = ref(false)
	let backTimer : number | null = null

	const clearBackTimer = () => {
		const timer = backTimer
		if (timer != null) {
			clearTimeout(timer)
			backTimer = null
		}
	}

	const releaseCamera = () => {
		cameraVisible.value = false
	}

	const completeBack = () => {
		if (!pendingBack.value) return
		pendingBack.value = false
		clearBackTimer()
		uni.__f__('log','at pages/scancode/scancode.uvue:48','扫码页已释放相机，返回添加设备页')
		uni.navigateBack({ delta: 1 })
	}

	const requestBack = () => {
		if (pendingBack.value) return
		pendingBack.value = true
		releaseCamera()
		backTimer = setTimeout(() => {
			completeBack()
		}, 1200)
	}

	const handleCameraInitDone = () => {
		uni.__f__('log','at pages/scancode/scancode.uvue:62','扫码摄像头初始化完成')
	}

	const handleScan = (e : UniCameraScanCodeEvent) => {
		if (hasFinished.value || !scanFunctionIsUseable.value) return
		const scanResult = e.detail.result
		if (scanResult == null) return
		const result = scanResult!!
		if (result.length == 0) return

		hasFinished.value = true
		scanFunctionIsUseable.value = false
		uni.vibrateLong({})
		uni.__f__('log','at pages/scancode/scancode.uvue:75','扫码结果:', result)
		uni.setStorageSync('scanCodeResult', result)
		showAppToast({
			title: '扫码成功',
			icon: 'success',
			duration: 500
		})
		requestBack()
	}

	const handleCameraStop = () => {
		uni.__f__('warn','at pages/scancode/scancode.uvue:86','扫码摄像头已停止')
		if (pendingBack.value) {
			uni.__f__('log','at pages/scancode/scancode.uvue:88','等待相机资源释放完成后返回添加设备页')
			return
		}
		uni.__f__('warn','at pages/scancode/scancode.uvue:91','摄像头停止但扫码页仍保持打开，等待用户返回或重试')
	}

	const handleCameraError = (e : UniCameraErrorEvent) => {
		if (hasFinished.value) return
		hasFinished.value = true
		uni.__f__('error','at pages/scancode/scancode.uvue:97','摄像头初始化失败:', e.detail)
		showAppToast({
			title: '摄像头初始化失败，请检查相机权限',
			icon: 'none',
			duration: 500
		})
		requestBack()
	}

	onHide(() => {
		uni.__f__('log','at pages/scancode/scancode.uvue:107','扫码页隐藏')
		releaseCamera()
	})

	onUnload(() => {
		uni.__f__('log','at pages/scancode/scancode.uvue:112','扫码页卸载')
		clearBackTimer()
		releaseCamera()
	})
</script>

<style lang="scss">
	.container {
		height: 100%;
		display: flex;
		flex-direction: column;
		background-color: #000;
	}
	.scancode-box {
		flex: 1;
		min-height: 0;
		padding: 0;
	}
	.scan-code {
		width: 100%;
		height: 100%;
	}
	.tip {
		position: fixed;
		bottom: 100rpx;
		left: 0;
		right: 0;
		text-align: center;
		color: #fff;
		font-size: 28rpx;
		background-color: rgba(0, 0, 0, 0.5);
		padding: 20rpx;
	}
</style>
