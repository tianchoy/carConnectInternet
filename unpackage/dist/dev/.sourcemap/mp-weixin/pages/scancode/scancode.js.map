<template>
	<!-- ===== 微信小程序：先请求 scope.camera，再渲染 camera 扫码 ===== -->

	<view class="container">
		<custom-navBar title="扫码添加ID" :show-back="true" backgroundColor="#fff" textColor="#333" :showCapsule="false">
		</custom-navBar>
		<view class="scancode-box">
			<camera device-position="back" mode="scanCode" flash="off" @scancode="handleScan" @error="error"
				class="scan-code"></camera>
		</view>
		<view class="tip">请将IMEI码放入框内,自动扫描</view>
	</view>


	<!-- ===== App：保留原有 camera 组件扫码实现 ===== -->




















</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { showAppToast } from '../../utils/toast.uts'
	import { showAppModal } from '../../utils/modal.uts'

	// ===== 微信小程序：先检查权限，未授权时主动请求后再显示 camera =====

	
	const scanFunctionIsUseable = ref(true)

	const handleScan = (e: any) => {
		if (!scanFunctionIsUseable.value || e.detail.result == null) return
		const scanResult = e.detail.result.toString()
		if (scanResult.length == 0) return

		uni.vibrateLong()
		scanFunctionIsUseable.value = false
		uni.__f__('log','at pages/scancode/scancode.uvue:55','扫码结果:', scanResult)
		uni.setStorageSync('scanCodeResult', scanResult)

		uni.showToast({
			title: '扫码成功',
			icon: 'success',
			duration: 1000
		})

		// 延迟返回上一页
		setTimeout(() => {
			uni.navigateBack({
				delta: 1
			})
		}, 1000)
	}

	const error = (e: any) => {
		uni.__f__('log','at pages/scancode/scancode.uvue:73','摄像头错误:', e)
		uni.showToast({
			title: '摄像头初始化失败',
			icon: 'none'
		})
	}

	const requestCameraPermission = () => {
		uni.getSetting({
			success: (res) => {
				if (res.authSetting['scope.camera']) {
					uni.__f__('log','at pages/scancode/scancode.uvue:84','已有摄像头权限')
					return
				}
				
				uni.authorize({
					scope: 'scope.camera',
					success: () => {
						uni.__f__('log','at pages/scancode/scancode.uvue:91','摄像头权限授权成功')
					},
					fail: () => {
						uni.showModal({
							title: '权限提示',
							content: '需要摄像头权限才能扫码，是否去设置开启？',
							success: (modalRes) => {
								if (modalRes.confirm) {
									uni.openSetting()
								} else {
									uni.navigateBack()
								}
							}
						})
					}
				})
			}
		})
	}

	onLoad(() => {
		requestCameraPermission()
	})


	// ===== App：保留原有 camera 组件事件和资源释放逻辑 =====




























































































</script>

<style lang="scss">
	/* 微信小程序与 App 均使用 camera 扫码预览，权限与行为在脚本条件编译中隔离。 */
	.container {
		height: 100%;
		display: flex;
		flex-direction: column;
		background-color: #000;
	}
	.scancode-box {
		flex: 1;
		min-height: 0;
		padding: 0;
	}
	.scan-code {
		width: 100%;
		height: 100%;
	}
	.tip {
		position: fixed;
		bottom: 100rpx;
		left: 0;
		right: 0;
		text-align: center;
		color: #fff;
		font-size: 28rpx;
		background-color: rgba(0, 0, 0, 0.5);
		padding: 20rpx;
	}
</style>
