<template>
	<view class="container">
		<view class="scancode-box">
			<camera
				v-if="cameraVisible"
				:key="cameraInstanceKey"
				device-position="back"
				mode="scanCode"
				flash="auto"
				class="scan-code"
				@initdone="handleCameraInitDone"
				@scancode="handleScan"
				@stop="handleCameraStop"
				@error="handleCameraError">
			</camera>
		</view>
		<view class="tip">请将设备二维码或条形码放入框内，自动扫描</view>
		<app-toast></app-toast>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { showAppToast } from '../../utils/toast.uts'
	import { ensureCameraPermission } from '../../utils/cameraPermission.uts'

	const scanFunctionIsUseable = ref(true)
	const cameraVisible = ref(false)
	const cameraInstanceKey = ref(0)
	const hasFinished = ref(false)
	const pendingBack = ref(false)
	const pageVisible = ref(false)
	let backTimer: number | null = null
	let restartTimer: number | null = null
	let restartCount = 0

	const clearTimers = () => {
		if (backTimer != null) {
			clearTimeout(backTimer)
			backTimer = null
		}
		if (restartTimer != null) {
			clearTimeout(restartTimer)
			restartTimer = null
		}
	}

	const releaseCamera = () => {
		cameraVisible.value = false
	}

	const completeBack = () => {
		if (!pendingBack.value) return
		pendingBack.value = false
		if (backTimer != null) {
			clearTimeout(backTimer)
			backTimer = null
		}
		uni.__f__('log','at pages/scancode/scancode.uvue:59','扫码页已释放相机，返回添加设备页')
		uni.navigateBack({ delta: 1 })
	}

	const requestBack = () => {
		if (pendingBack.value) return
		pendingBack.value = true
		releaseCamera()
		// 部分 Android 机型不会回调 stop，使用短超时保证页面不会卡住。
		backTimer = setTimeout(() => completeBack(), 500)
	}

	const mountCamera = () => {
		if (!pageVisible.value || hasFinished.value || pendingBack.value) return
		cameraInstanceKey.value += 1
		cameraVisible.value = true
	}

	const startCamera = () => {
		ensureCameraPermission((status) => {
			if (!pageVisible.value || hasFinished.value || pendingBack.value) return
			if (status == 'granted') {
				mountCamera()
				return
			}
			uni.__f__('warn','at pages/scancode/scancode.uvue:84','扫码页未获得相机权限:', status)
			showAppToast({ title: '未获得相机权限，无法扫码', icon: 'none' })
		})
	}

	const restartCameraOnce = () => {
		if (!pageVisible.value || hasFinished.value || pendingBack.value) return
		if (restartCount >= 1) {
			showAppToast({ title: '摄像头启动失败，请返回后重试', icon: 'none' })
			return
		}
		restartCount += 1
		releaseCamera()
		restartTimer = setTimeout(() => {
			restartTimer = null
			startCamera()
		}, 300)
	}

	const handleCameraInitDone = () => {
		uni.__f__('log','at pages/scancode/scancode.uvue:104','扫码摄像头初始化完成')
	}

	const handleScan = (e: UniCameraScanCodeEvent) => {
		if (hasFinished.value || !scanFunctionIsUseable.value) return
		const scanResult = e.detail.result
		if (scanResult == null) return
		const result = scanResult!!
		if (result.length == 0) return

		hasFinished.value = true
		scanFunctionIsUseable.value = false
		uni.vibrateLong({})
		uni.__f__('log','at pages/scancode/scancode.uvue:117','扫码结果:', result)
		uni.setStorageSync('scanCodeResult', result)
		showAppToast({ title: '扫码成功', icon: 'success', duration: 500 })
		requestBack()
	}

	const handleCameraStop = () => {
		uni.__f__('warn','at pages/scancode/scancode.uvue:124','扫码摄像头已停止')
		if (pendingBack.value) {
			completeBack()
			return
		}
		restartCameraOnce()
	}

	const handleCameraError = (e: UniCameraErrorEvent) => {
		if (hasFinished.value || pendingBack.value) return
		uni.__f__('error','at pages/scancode/scancode.uvue:134','摄像头初始化失败:', e.detail)
		restartCameraOnce()
	}

	onShow(() => {
		pageVisible.value = true
		hasFinished.value = false
		scanFunctionIsUseable.value = true
		startCamera()
	})

	onHide(() => {
		uni.__f__('log','at pages/scancode/scancode.uvue:146','扫码页隐藏')
		pageVisible.value = false
		if (!pendingBack.value) clearTimers()
		releaseCamera()
	})

	onUnload(() => {
		uni.__f__('log','at pages/scancode/scancode.uvue:153','扫码页卸载')
		pageVisible.value = false
		clearTimers()
		releaseCamera()
	})
</script>

<style lang="scss">
	.container {
		height: 100%;
		display: flex;
		flex-direction: column;
		background-color: #000;
	}
	.scancode-box {
		flex: 1;
		min-height: 0;
		padding: 0;
	}
	.scan-code {
		width: 100%;
		height: 100%;
	}
	.tip {
		position: fixed;
		bottom: 100rpx;
		left: 0;
		right: 0;
		text-align: center;
		color: #fff;
		font-size: 28rpx;
		background-color: rgba(0, 0, 0, 0.5);
		padding: 20rpx;
	}
</style>
