<template>
	<view class="container">
		<custom-navBar title="全部设备" :show-back="true" backgroundColor="#f1f1f1" textColor="#333" :showCapsule="true"
			:isIcon="true" @capsuleClick="showWhat" Icon="/static/allDevice.png" :iconColor="iconColor">
		</custom-navBar>
		<view class="map-container" v-if="showMap">
			<map id="myMap" :scale="mapScale" style="width:100%;height:100%"
				@markertap="handleTap" :latitude="userLocation.latitude" :longitude="userLocation.longitude" :markers="mapMarkers" :enable-traffic="true" >
			</map>
            <view class="right-bar" v-if="showMap">
				<i-tag type="primary" @click="changeState('全部')" :text="`全部 ${totalCount}`"></i-tag>
			<i-tag type="success" @click="changeState('在线')" :text="`在线 ${onlineCount}`"></i-tag>
			<i-tag type="danger" @click="changeState('离线')" :text="`离线 ${offlineCount}`"></i-tag>
            </view>
		</view>
		<view v-else>
			<indexListMode :lists="deviceListItems" @unbindDevice="unbindDevice" />
		</view>
	</view>
	<app-toast></app-toast>
</template>

<script setup lang="uts">
import { isBusinessSuccessCode } from '../../api/response.uts'
import { showAppToast } from '../../utils/toast.uts'
	import { ref, computed, watchEffect, getCurrentInstance } from 'vue'
	import { getUserDeviceList,delDevice} from '../../api/request.uts'
	import CoordTransform from '../../utils/coordTransform.uts'
	import { getDeviceIcon } from '../../utils/cars'
	import { DeviceItem } from '../../utils/device.uts'

	const mapScale = ref(4)
	const showMap = ref(true)
	const markers = ref<Array<Marker>>([])
	const iconColor = ref('#1296db')
	const userLocation = ref({
		latitude: 0,
		longitude: 0
	})

	// ===== 车标点聚合 =====
	// 仅微信小程序端提供原生点聚合（MapContext.initMarkerCluster）
	// 注意：参与聚合的车标必须通过 MapContext.addMarkers 添加，组件的 markers 属性不会进入聚合器
	// App 端 uni-app x 的 map 组件未暴露聚合能力，保持普通标记点渲染

	type ClusterLabel = {
		content : string
		fontSize : number
		width : number
		height : number
		color : string
		bgColor : string
		borderRadius : number
		textAlign : string
		anchorX : number
		anchorY : number
	}

	type ClusterMarker = {
		clusterId : number
		latitude : number
		longitude : number
		iconPath : string
		width : number
		height : number
		label : ClusterLabel
	}

	let clusterContext : any = null
	let clusterReady = false

	// 微信原生 API 内部使用结构化克隆传参；Vue 响应式对象与 UTSJSONObject 都是 Proxy，
	// 直接传入会报 "An object could not be cloned"，这里统一深拷贝成纯 JS 对象
	const toPlainObject = (value : any) : any => {
		const parsed = JSON.parse(JSON.stringify(value))
		return parsed != null ? parsed : value
	}

	// 把车标交给聚合器管理
	const syncClusterMarkers = () => {
		const context = clusterContext
		if (!clusterReady || context == null) return
		try {
			context.addMarkers(toPlainObject({ markers: markers.value, clear: true }))
		} catch (error) {
			uni.__f__('warn','at pages/deviceList/deviceList.uvue:86','车标同步到聚合器失败:', error)
		}
	}

	const setupMarkerCluster = () => {
		const context = clusterContext
		if (clusterReady || context == null) return
		try {
			// 关闭默认样式，聚合簇样式由 markerClusterCreate 回调自定义
			context.initMarkerCluster(toPlainObject({
				enableDefaultStyle: false,
				zoomOnClick: true,
				gridSize: 60
			}))
			context.on('markerClusterCreate', (res : any) => {
				const clusterList = res != null ? (res['clusters'] as Array<any> | null) : null
				if (clusterList == null) return
				const clusterMarkers : Array<ClusterMarker> = []
				clusterList.forEach((cluster : any) => {
					const center = cluster['center']
					if (center == null) return
					const markerIds = cluster['markerIds'] as Array<any> | null
					const count = markerIds != null ? markerIds.length : 0
					clusterMarkers.push({
						clusterId: cluster['clusterId'] as number,
						latitude: center['latitude'] as number,
						longitude: center['longitude'] as number,
						// 用透明图标占位，否则微信会给没有 iconPath 的标记渲染默认红色定位针
						iconPath: '/static/transparent.png',
						width: 1,
						height: 1,
						// 聚合簇用 label 显示数量
						label: {
							content: count.toString(),
							fontSize: 14,
							width: 40,
							height: 40,
							color: '#ffffff',
							bgColor: '#1296db',
							borderRadius: 20,
							textAlign: 'center',
							anchorX: 0,
							anchorY: -20
						}
					} as ClusterMarker)
				})
				// 携带 clusterId 即更新对应聚合簇；此处不能用 clear，否则会把参与聚合的车标一起清掉
				context.addMarkers(toPlainObject({ markers: clusterMarkers }))
			})
			clusterReady = true
			syncClusterMarkers()
		} catch (error) {
			uni.__f__('warn','at pages/deviceList/deviceList.uvue:138','点聚合初始化失败，回退为普通标记点:', error)
		}
	}


	// 小程序端车标由 MapContext.addMarkers 交给聚合器管理，组件的 markers 属性置空
	// 用固定引用，避免数据更新时触发 markers 属性 setData 把聚合器里的车标清掉
	const EMPTY_MARKERS : Array<Marker> = []
	const mapMarkers = computed<Array<Marker>>(() => {
		let result : Array<Marker> = markers.value

		result = EMPTY_MARKERS

		return result
	})

	const pickerStateTitle = ref('全部状态')

	// 切换显示模式
	const showWhat = () => {
		showMap.value = !showMap.value

		if (showMap.value) {
			// 地图按 v-if 重建后上下文会失效，需重新创建并重新初始化聚合
			clusterReady = false
			setTimeout(() => {
				clusterContext = uni.createMapContext('myMap', getCurrentInstance()?.proxy ?? null)
				setupMarkerCluster()
			}, 100)
		}

	}

	// 原始设备列表
	const originalDeviceList = ref<Array<UTSJSONObject>>([])

	const deviceListItems = computed((): Array<DeviceItem> => {
		return originalDeviceList.value.map((item: UTSJSONObject): DeviceItem => {
			const deviceNo = item.getString('deviceNo', '')
			const rawDeviceName = item.getString('deviceName', '')
			return {
				plateNo: item.getString('plateNo', ''),
				deviceNo: deviceNo,
				status: item.getNumber('status', 0),
				companyId: item.getString('companyId', ''),
				deviceName: rawDeviceName != '' ? rawDeviceName : deviceNo,
				deviceId: item.getString('deviceId', ''),
				iccid: item.getString('iccid', ''),
				simMerchant: item.getString('simMerchant', ''),
				connectionStatus: item.getString('connectionStatus', '')
			}
		})
	})

	// 计算属性 筛选逻辑
	const filteredDevices = computed(() => {
		if (!Array.isArray(originalDeviceList.value)) return []

		let result = [...originalDeviceList.value]

		// 状态筛选
		if (pickerStateTitle.value == '在线') {
			result = result.filter((device: UTSJSONObject) => device['connectionStatus'] == 'online')
		} else if (pickerStateTitle.value === '离线') {
			result = result.filter((device: UTSJSONObject) => device['connectionStatus'] == 'offline')
		}

		return result
	})

	// 计算设备数量统计
	const totalCount = computed(() => originalDeviceList.value.length)
	const onlineCount = computed(() => originalDeviceList.value.filter((d: UTSJSONObject) => d['connectionStatus'] == 'online').length)
	const offlineCount = computed(() => totalCount.value - onlineCount.value)





	const updateMarkers = (devices: Array<UTSJSONObject>): void => {
		const nextMarkers: Array<Marker> = []
		for (let index = 0; index < devices.length; index++) {
			const device = devices[index]
			const latitude = device['latitude'] as string | number | null
			const longitude = device['longitude'] as string | number | null
			if (latitude == null || longitude == null) continue
			const lat = parseFloat(latitude.toString())
			const lng = parseFloat(longitude.toString())
			if (isNaN(lat) || isNaN(lng)) continue
			const connectionStatus = (device['connectionStatus'] as string | null) ?? ''
			const carType = (device['carType'] as string | null) ?? ''
			const idValue = device['deviceId'] as string | number | null
			const parsedId = idValue != null ? parseInt(idValue.toString()) : NaN
			const markerId = isNaN(parsedId) ? index + 1 : parsedId
			const deviceName = (device['deviceName'] as string | null) ?? (device['plateNo'] as string | null) ?? '设备'
			nextMarkers.push({
				id: markerId,
				latitude: lat,
				longitude: lng,
				iconPath: getDeviceIcon(connectionStatus, carType),
				width: 30,
				height: 30,

				// 声明参与微信小程序原生点聚合
				joinCluster: true,

				callout: {
					content: deviceName,
					display: 'ALWAYS',
					padding: 8,
					borderRadius: 8,
					bgColor: '#ffffff'
				},
				anchor: { x: 0.5, y: 0.5 }
			} as Marker)
		}
		markers.value = nextMarkers

		// 数据可能早于 onReady 到达，这里兜底初始化聚合（内部幂等），并把车标同步给聚合器
		setupMarkerCluster()
		syncClusterMarkers()

		if (nextMarkers.length > 0 && userLocation.value.latitude == 0 && userLocation.value.longitude == 0) {
			const firstMarker = nextMarkers[0]
			userLocation.value.latitude = firstMarker.latitude
			userLocation.value.longitude = firstMarker.longitude
		}
	}
	watchEffect(() => {
		if (showMap.value) {
			updateMarkers(filteredDevices.value)
		}
	})

	const loadUserDeviceList = async (data: Array<UTSJSONObject>, from: boolean): Promise<void> => {
		try {
			let deviceList: Array<UTSJSONObject> = data
			if (from) {
				const params: UTSJSONObject = { pageSize: 1000 } as UTSJSONObject
				const res = await getUserDeviceList(params)
				const list = (isBusinessSuccessCode(res.code) && res.data != null ? res.data.list : null) as Array<UTSJSONObject> | null
				if (list == null || !Array.isArray(list)) {
					uni.__f__('warn','at pages/deviceList/deviceList.uvue:280','获取设备列表返回异常:', res)
					originalDeviceList.value = []
					markers.value = []
					return
				}
				deviceList = list ?? []
			}
			if (!Array.isArray(deviceList)) deviceList = []
			originalDeviceList.value = CoordTransform.batchConvertCoordinates(deviceList, 'tencent')
			updateMarkers(originalDeviceList.value)
		} catch (err) {
			uni.__f__('error','at pages/deviceList/deviceList.uvue:291','获取设备列表失败:', err)
			originalDeviceList.value = []
			markers.value = []
			showAppToast({ title: '获取设备列表失败', icon: 'none' })
		}
	}
		// 解绑设备
	const unbindDevice = async (deviceId : string) => {
		const res = await delDevice(deviceId)
		if (isBusinessSuccessCode(res.code)) {
			showAppToast({
				title: res.msg || '解绑成功',
				icon: 'success'
			})
			uni.setStorageSync('needRefreshHome', true)
		} else {
			showAppToast({
				title: res.msg || '解绑失败',
				icon: 'error'
			})
		}
		// 解绑成功后刷新设备列表
		await loadUserDeviceList([],true)
	}

	// 设备告警订阅已由硬件设备长期订阅能力承接，入口在首页「车辆告警通知」行
	// 实现见 utils/deviceSubscribe.uts（wx.requestSubscribeDeviceMessage，按设备 sn 授权）

	// 切换筛选状态
	const changeState= (type : string) => {
		pickerStateTitle.value = type
	}

	// 点击地图标记
	const handleTap = (event: any) => {
		const detail = event as UTSJSONObject
		const markerId = detail != null ? detail['markerId'] : null
		const selectedDevice = originalDeviceList.value.find((device: UTSJSONObject) => device['deviceId'] == markerId)
		if (selectedDevice == null) {
			uni.__f__('warn','at pages/deviceList/deviceList.uvue:330','未找到对应的设备信息', markerId)
			return
		}
		const deviceNoValue = (selectedDevice['deviceNo'] as string | null) ?? ''
		const companyId = (selectedDevice['companyId'] as string | number | null) ?? ''
		const deviceId = (selectedDevice['deviceId'] as string | number | null) ?? ''
		uni.navigateTo({
			url: '/pages/carInfoDetail/carInfoDetail?deviceNo=' + deviceNoValue + '&deptId=' + companyId.toString() + '&deviceId=' + deviceId.toString()
		})
	}

	onReady(() => {

		clusterContext = uni.createMapContext('myMap', getCurrentInstance()?.proxy ?? null)
		setupMarkerCluster()

	})

	onLoad((options) => {
		loadUserDeviceList([], true)
	})
</script>

<style lang="scss">
	.container {
		position: relative;
		width: 100%;
		height: 100%;

		min-height: 100%;

		display: flex;
		flex-direction: column;
		background-color: #f5f7fa;

		.map-container {
			flex: 1;
			width: 100%;
			position: relative;
		}

		.tool-nav {
			position: absolute;
			top: 200rpx;
			right: 20rpx;
			z-index: 100;
			display: flex;
			flex-direction: row;
			justify-content: center;
			align-items: center;
			font-size: 35rpx;

			.btn-map-list {
				padding: 10rpx;
				background-color: #1296db;
				color: #fff;
				border-radius: 10rpx;
			}
		}

		.right-bar {
			position: absolute;
			top: 25rpx;
			left: 20rpx;
			z-index: 100;
			display: flex;
			flex-direction: row;
			justify-content: center;
			align-items: center;

            .status-spacing { margin-left: 20rpx; }

            .allCar {
				background-color: #1296db;
			}

			.onlineCar {
				background-color: #0da117;
			}

			.offlineCar {
				background-color: #d81e06;
			}
		}
	}
</style>