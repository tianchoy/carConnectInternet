<template>
	<view class="container">
		<custom-navBar title="添加设备" :show-back="true" backgroundColor="#fff" textColor="#333" :showCapsule="false">
		</custom-navBar>
		<view class="content">
			<i-form
				labelPosition="left"
				:modelValue="carInfo"
				:rules="rules"
				labelDirection="horizontal"
				watchValidStatus
				@update:modelValid="handleModelValid"
			>
				<i-form-item label="设备名称" name="deviceName"  labelDirection="horizontal">
					<i-input border="none" v-model="carInfo.deviceName" placeholder="请输入设备名称">
					</i-input>
				</i-form-item>

				<i-form-item label="设备编号" name="deviceNo" required  labelDirection="horizontal">
					<i-input border="none" v-model="carInfo.deviceNo" placeholder="请输入设备编号(必填)">
						<template v-slot:suffix>
							<i-icon name="/static/sancode.png" fontSize="24" @click="scanCode"></i-icon>
						</template>
					</i-input>
				</i-form-item>

				<i-form-item label="车标" name="deviceType" required labelDirection="horizontal">
					<view class="car-type-selector" @click="deviceTypeSelectFun">
						<text class="clickable" :class="{ 'placeholder': !carInfo.deviceTypeValue }">
							{{ carInfo.deviceTypeValue || '请选择设备图标(必选)' }}
						</text>
					</view>
				</i-form-item>
				<i-form-item label="车牌号" name="plateNo"  labelDirection="horizontal">
					<i-input border="none" v-model="carInfo.plateNo" placeholder="请输入车牌号">
					</i-input>
				</i-form-item>
				<carIcons :show="carIconSelectorVisible" @update:show="updateCarIconSelectorVisible" @select="selectIcon"></carIcons>
			</i-form>
		</view>
		<view class="btn">
			<i-button  type="primary" @click="submit" :loading="loading">提交</i-button>
		</view>

	</view>
	<app-toast></app-toast>
</template>

<script setup lang="ts">
import { isBusinessSuccessCode } from '../../api/response.uts'
import { showAppToast } from '../../utils/toast.uts'
	import { ref } from 'vue'
	import { addDevice, getCarType } from '../../api/request'
	import carIcons from '../../components/car-icons/car-icons.uvue'

	type CarFormData = {
		deviceName: string
		deviceNo: string
		deviceType: string
		deviceTypeValue: string
		plateNo: string
		carType: string
	}

	type ScanResultData = {
		result: string
	}

	type CarIconItem = UTSJSONObject

	type AddDeviceResponse = {
		code: number
		msg: string
		data: CarFormData
	}

	const isNavigatingToScanner = ref<boolean>(false)
	const carIconSelectorVisible = ref<boolean>(false)
	const loading = ref<boolean>(false)
	const formValid = ref<boolean>(false)

	const carInfo = ref<CarFormData>({
		deviceName: '',
		deviceNo: '',
		deviceType: '',
		deviceTypeValue: '',
		plateNo: '',
		carType: ''
	})

	const actions = ref<any[]>([])

	// ===== 表单验证规则 =====
	// i-form 的 rules 元素必须是 UTSJSONObject 实例（内部会调用 item.getString）。
	// 对象字面量加 as UTSJSONObject 在部分编译场景下不会被转换，运行时会报 getString is not a function。
	const createFormRule = (name: string, message: string): UTSJSONObject => {
		const rule = new UTSJSONObject()
		rule.set('name', name)
		rule.set('required', true)
		rule.set('message', message)
		return rule
	}

	const rules: Array<UTSJSONObject> = [
		createFormRule('deviceNo', '请输入设备编号'),
		createFormRule('deviceType', '请选择设备图标')
	]

	// ===== 处理表单验证状态更新 =====
	const handleModelValid = (value: any) => {
		// 使用双重否定或比较运算符来转换为布尔值，避免使用 Boolean()
		formValid.value = !!value
	}

	// ===== 核心功能函数 =====

	// 扫码功能
	const openScanPage = () => {
		if (isNavigatingToScanner.value) return
		isNavigatingToScanner.value = true
		uni.__f__('log','at pages/addCar/addCar.uvue:121','打开扫码页')
		uni.navigateTo({
			url: '/pages/scancode/scancode?source=addCar',
			fail: (error) => {
				uni.__f__('error','at pages/addCar/addCar.uvue:125','打开扫码页失败:', error)
				showAppToast({ title: '无法打开扫码页，请重试', icon: 'none' })
			},
			complete: () => {
				isNavigatingToScanner.value = false
			}
		})
	}

	const scanCode = () => {
		if (isNavigatingToScanner.value) return
		// 扫码页 onLoad 统一查询并请求 scope.camera，确保首次进入时弹出授权框。
		openScanPage()
	}

	// ===== 设备编号处理 =====
	// 设备标签二维码（型号 4G17L-D）编码的是 11 位 ID，但带有 GS1 应用标识符括号，如 (94)94082357294。
	// 先剥离半角/全角括号再校验，其余非法字符仍按无效处理。
	const normalizeDeviceNo = (value: string): string => {
		const deviceNo = value.trim().replace(/[()（）]/g, '')
		if (deviceNo == '' || !new RegExp('^[0-9]+$').test(deviceNo)) return ''
		if (deviceNo.length == 15) return '0' + deviceNo.slice(4, 15)
		if (deviceNo.length == 11) return '0' + deviceNo
		return deviceNo
	}

	// 扫码结果事件处理
	const handleScanResult = (data: ScanResultData) => {
		uni.__f__('log','at pages/addCar/addCar.uvue:153','接收到扫码结果:', data.result)
		const normalizedDeviceNo = normalizeDeviceNo(data.result)
		if (normalizedDeviceNo == '') {
			showAppToast({
				title: '设备编号只能输入数字，请确认后提交',
				icon: 'none'
			})
			return
		}
		carInfo.value.deviceNo = normalizedDeviceNo
	}

	const updateCarIconSelectorVisible = (visible: boolean) => {
		carIconSelectorVisible.value = visible
	}

	// 选择车标
	const selectIcon = (item: CarIconItem) => {
		const name = item.getString('name', '')
		const text = item.getString('text', '')
		uni.__f__('log','at pages/addCar/addCar.uvue:173',name)
		carInfo.value.deviceType = name
		carInfo.value.deviceTypeValue = text
		carIconSelectorVisible.value = false
	}

	// 打开车标选择器
	const deviceTypeSelectFun = () => {
		carIconSelectorVisible.value = true
	}

	// 刷新首页设备列表的方法
	const refreshDeviceList = () => {
		uni.$emit('refreshDeviceList')
	}

	// ===== 表单验证 =====
	const validateForm = (): boolean => {
		if (carInfo.value.deviceNo.length == 0) {
			showAppToast({
				title: '请输入设备编号',
				icon: 'none'
			})
			return false
		}
		if (carInfo.value.deviceType.length == 0) {
			showAppToast({
				title: '请选择设备图标',
				icon: 'none'
			})
			return false
		}
		return true
	}

	// ===== 提交表单 =====
	const submit = async () => {
		uni.__f__('log','at pages/addCar/addCar.uvue:210','=== 开始提交设备 ===')

		try {
			// 表单验证
			if (!validateForm()) return
			uni.__f__('log','at pages/addCar/addCar.uvue:215','✅ 表单验证通过')

			const normalizedDeviceNo = normalizeDeviceNo(carInfo.value.deviceNo)
			if (normalizedDeviceNo == '') {
				showAppToast({
					title: '设备编号只能输入数字，请确认后提交',
					icon: 'none'
				})
				return
			}
			carInfo.value.deviceNo = normalizedDeviceNo

			loading.value = true
			uni.showLoading({
				title: '添加中...',
				mask: true
			})

			const submitData = {
				deviceName: carInfo.value.deviceName,
				deviceNo: normalizedDeviceNo,
				carType: carInfo.value.deviceType,
				plateNo: carInfo.value.plateNo
			}

			uni.__f__('log','at pages/addCar/addCar.uvue:240','📤 提交数据:', submitData)

			const res = await addDevice(submitData)
			uni.__f__('log','at pages/addCar/addCar.uvue:243','✅ 添加设备返回:', res)

			uni.hideLoading()
			loading.value = false

			if (isBusinessSuccessCode(res.code)) {
				showAppToast({
					title: res.msg || '添加成功',
					icon: 'success'
				})

				uni.setStorageSync('needRefreshHome', true)

				// 添加成功后触发首页刷新
				refreshDeviceList()

				setTimeout(() => {
					uni.navigateBack()
				}, 1500)
			} else {
				showAppToast({
					title: res.msg || '添加失败',
					icon: 'none',
					duration: 2000
				})
			}
		} catch (error: any) {
			uni.__f__('error','at pages/addCar/addCar.uvue:270','❌ 添加设备失败:', error)
			uni.hideLoading()
			loading.value = false
			showAppToast({
				title: '添加设备失败',
				icon: 'none'
			})
		}
	}

	// ===== 生命周期 =====
	onLoad(() => {
		// loadCarTypeData()
	})

	onShow(() => {
		isNavigatingToScanner.value = false
		const rawResult = uni.getStorageSync('scanCodeResult')
		uni.__f__('log','at pages/addCar/addCar.uvue:288','onShow:', rawResult)
		const scanCodeResultListener = uni.$on('scanCodeResult', handleScanResult)
		uni.__f__('log','at pages/addCar/addCar.uvue:290','scanCodeResultListener:', scanCodeResultListener)
			const result = rawResult != null ? rawResult.toString() : ''
		if (result.length > 0) {
			uni.removeStorageSync('scanCodeResult')
			handleScanResult({ result: result })
		}
	})

	onUnload(() => {
		// 页面卸载时无需额外移除扫码结果监听
	})

	// ===== 加载车辆类型（注释掉，如需使用请取消注释） =====
	// const loadCarTypeData = async () => {
	// 	try {
	// 		const res = await getCarType()
	// 		if (res.msg == 'success') {
	// 			actions.value = res.data.map(item => ({
	// 				name: item.typeName,
	// 				value: item.id.toString()
	// 			}))
	// 		} else {
	// 			showAppToast({
	// 				title: '获取车辆品牌失败',
	// 				icon: 'none'
	// 			})
	// 		}
	// 	} catch (error) {
	// 		showAppToast({
	// 			title: '请求失败，请重试',
	// 			icon: 'none'
	// 		})
	// 	}
	// }
</script>

<style lang="scss" scoped>
	.container {
		width: 100%;
		height: 100%;
		background-color: #f5f5f5;

		.content {
			margin: 20rpx;
			padding: 20rpx 40rpx;
			background-color: #fff;
			border-radius: 20rpx;
		}


		.clickable{
			margin-top: 10px;
			color:#999;
			font-size: 28rpx;
		}

		.btn {
			margin: 50rpx 20rpx 0 20rpx;
		}

		.plate-input {
			width: 100%;

			:deep(.input-wrapper) {
				padding: 0;
				border: none;
			}
		}

		// 车牌输入组件样式
		:deep(.car-input-container) {
			display: flex;
			flex-direction: row;
		}

		:deep(.car-number-input) {
			width: 60%;
			text-align: right;
		}

		:deep(.car-number-container .plate-close) {
			height: 40px;
			display: flex;
			text-align: right;
			background-color: #FFF;
			flex-direction: row;
			justify-content: flex-end;
			align-items: center;
		}

		:deep(.car-input-container .car-input-box .car-input-item) {
			position: relative;
			border: 1px solid #E2E2E2;
			height: 40px;
			line-height: 40px;
			text-align: center;
			font-size: 17px;
		}

		:deep(.car-input-container .car-input-box .car-input-item .new-item-img) {
			position: absolute;
			top: -2px;
			left: 50%;
			margin-left: -15px;
			height: 13px;
			width: 30px;
			z-index: 9;
		}

		:deep(.i-form-item){
			padding:5rpx 10rpx;
			border-radius: 0;
			border-bottom: 1px solid #99999924;
		}
	}
</style>