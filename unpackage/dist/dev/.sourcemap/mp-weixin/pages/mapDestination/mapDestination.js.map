<template>
	<view class="container">
		<custom-navBar title="位置详情" :show-back="true" backgroundColor="#ffffff" textColor="#333333" :showCapsule="false">
		</custom-navBar>
		<view v-if="isLocationValid" class="map-content">
			<map id="destinationMap" :latitude="center.latitude" :longitude="center.longitude" :markers="markers"
				:scale="16" style="width:100%;height:100%" :show-location="false" :enable-traffic="true"
				:enable-overlooking="true" :enable-building="true" :enable-3D="true">
			</map>
			<view class="location-name">
				<text>{{locationName}}</text>
			</view>
		</view>
		<view v-else class="invalid-location">
			<text>暂无有效位置信息</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, reactive } from 'vue'
import CoordTransform from '../../utils/coordTransform.uts'

type MapCenter = {
	latitude: number
	longitude: number
}

const center = reactive<MapCenter>({
	latitude: 0,
	longitude: 0
})
const locationName = ref('目标位置')
const isLocationValid = ref(false)
const markers = ref<Array<Marker>>([])

function isValidCoordinate(latitude: number, longitude: number): boolean {
	return !isNaN(latitude) && !isNaN(longitude) &&
		latitude >= -90 && latitude <= 90 &&
		longitude >= -180 && longitude <= 180 &&
		!(latitude == 0 && longitude == 0)
}

onLoad((options) => {
	const latitude = parseFloat(options.latitude ?? '')
	const longitude = parseFloat(options.longitude ?? '')
	if (!isValidCoordinate(latitude, longitude)) return

	let mapLatitude = latitude
	let mapLongitude = longitude
	if (options.coordType == 'wgs84') {
		const converted = CoordTransform.wgs84ToTencent(latitude, longitude)
		mapLatitude = converted.lat
		mapLongitude = converted.lng
	}

	center.latitude = mapLatitude
	center.longitude = mapLongitude
	const locationParam = (options as UTSJSONObject).getString('name', '目标位置')
	locationName.value = locationParam
	markers.value = [{
		id: 1,
		latitude: mapLatitude,
		longitude: mapLongitude,
		iconPath: '/static/pos.png',
		width: 30,
		height: 30,
		anchor: { x: 0.5, y: 0.5 },
		callout: {
			content: locationName.value,
			color: '#ffffff',
			borderRadius: 6,
			bgColor: '#07C160',
			padding: 4,
			fontSize: 12,
			display: 'ALWAYS'
		}
	} as Marker]
	isLocationValid.value = true
})
</script>

<style lang="scss">
.container {
	height: 100%;
	display: flex;
	flex-direction: column;
	background-color: #f5f7fa;
}

.map-content {
	flex: 1;
	position: relative;
	min-height: 0;
}

.location-name {
	position: absolute;
	left: 30rpx;
	right: 30rpx;
	bottom: 30rpx;
	padding: 24rpx 30rpx;
	background-color: #ffffff;
	border-radius: 16rpx;
	box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.location-name text {
	font-size: 28rpx;
	color: #333333;
}

.invalid-location {
	flex: 1;
	display: flex;
	align-items: center;
	justify-content: center;
}

.invalid-location text {
	font-size: 28rpx;
	color: #999999;
}
</style>
