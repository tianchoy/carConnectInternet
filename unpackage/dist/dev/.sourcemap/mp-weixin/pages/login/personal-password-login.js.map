		align-items: center;
		margin-top: 40rpx;
	}

	.action-link {
		font-size: 26rpx;
		color: #8b8c8d;
	}

	.action-divider {
		margin: 0 28rpx;
		color: #d9d9d9;
	}

	:deep(.i-form-item) {
		padding: 12px 0;
	}
</style>
