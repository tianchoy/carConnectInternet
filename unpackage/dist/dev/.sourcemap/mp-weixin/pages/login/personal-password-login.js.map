		background-color: #fff;
	}

	.banner {
		display: flex;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		height: 260rpx;
		background-color: #fff;
	}

	.banner-image {
		width: 180rpx;
		height: 180rpx;
	}

	.title {
		font-size: 40rpx;
		font-weight: bold;
		color: #333;
