<template>
	<view class="container">
		<custom-navBar title="个人账号登录" :show-back="true" backgroundColor="#fff" textColor="#333" :showCapsule="false">
		</custom-navBar>
		<view class="banner">
			<image src="/static/car_location.png" class="banner-image" mode="aspectFill"></image>
			<text class="title">车联网</text>
		</view>

		<view class="content">
			<i-form :modelValue="form" :rules="rules" labelDirection="horizontal" watchValidStatus>
				<i-form-item name="username" label="" required labelDirection="horizontal" labelWidth="0">
					<i-input v-model="form.username" placeholder="请输入账号" clearable />
				</i-form-item>
				<i-form-item name="password" label="" required labelDirection="horizontal" labelWidth="0">
					<i-input v-model="form.password" placeholder="请输入密码" type="password" :password="true" />
				</i-form-item>
				<i-button type="primary" @click="submitLogin" :loading="submitting" :disabled="!isLoginReady || submitting">登录</i-button>
			</i-form>

			<view class="documents">
				<i-checkbox :checked="agreementAccepted" @change="toggleAgreement"></i-checkbox>
				<view class="doc-info-box">
					<text class="doc-text">已阅读并同意</text><text class="doc-link" @click="gotoAgreement">《用户协议》</text><text class="doc-text">和</text><text class="doc-link" @click="gotoPrivacy">《隐私政策》</text>
				</view>
			</view>
		</view>

		<view class="page-actions">
			<text class="action-link" @click="goRegister">立即注册</text>
			<text class="action-divider">|</text>
			<text class="action-link" @click="backToLogin">返回其他登录方式</text>
		</view>
	</view>
	<app-toast></app-toast>
	<app-modal></app-modal>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { showAppToast } from '../../utils/toast.uts'
	import { showAppModal } from '../../utils/modal.uts'
	import { personalPasswordLogin } from '../../api/request.uts'
	import { resetTokenExpiredState } from '../../api/http.uts'
	import { schedulePostLoginInitialization } from '../../services/app-startup.uts'
	import { userAgreement, privacyPolicy } from '../../utils/legal.uts'

	type PersonalLoginForm = {
		username: string
		password: string
	}

	const form = ref<PersonalLoginForm>({
		username: '',
		password: ''
	})
	const agreementAccepted = ref(false)
	const submitting = ref(false)

	const isLoginReady = computed<boolean>(() => {
		return form.value.username != '' && form.value.password != ''
	})

	const rules = [
		{ name: 'username', required: true, message: '请输入账号' } as UTSJSONObject,
		{ name: 'password', required: true, message: '请输入密码' } as UTSJSONObject
	] as Array<UTSJSONObject>

	const toggleAgreement = (): void => {
		agreementAccepted.value = !agreementAccepted.value
	}

	const validateForm = (): boolean => {
		if (form.value.username.length == 0) {
			showAppToast({ title: '请输入账号', icon: 'none' })
			return false
		}
		if (form.value.password.length == 0) {
			showAppToast({ title: '请输入密码', icon: 'none' })
			return false
		}
		if (!agreementAccepted.value) {
			showAppToast({ title: '请先阅读并同意用户协议', icon: 'none' })
			return false
		}
		return true
	}

	const completeLogin = (token: string): void => {
		uni.setStorageSync('token', token)
		resetTokenExpiredState()
		showAppToast({ title: '登录成功', icon: 'success' })
		setTimeout(() => {
			uni.reLaunch({
				url: '/pages/index/index',
				success: () => {
					schedulePostLoginInitialization()
				}
			})
		}, 500)
	}

	const submitLogin = async (): Promise<void> => {
		if (submitting.value || !validateForm()) return
		try {
			submitting.value = true
			const response = await personalPasswordLogin({
				username: form.value.username,
				password: form.value.password
			})
			const token = response.data != null ? response.data.getString('access_token', '') : ''
			if (response.code == 200 && token != '') {
				completeLogin(token)
				return
			}
			showAppToast({ title: response.msg || '登录失败，请检查账号和密码', icon: 'none' })
		} catch (error) {
			showAppToast({ title: '登录失败，请检查网络后重试', icon: 'none' })
		} finally {
			submitting.value = false
		}
	}

	const goRegister = (): void => {
		uni.navigateTo({ url: '/pages/login/register' })
	}

	const backToLogin = (): void => {
		uni.navigateBack({
			fail: () => {
				uni.reLaunch({ url: '/pages/login/login' })
			}
		})
	}

	const gotoAgreement = (): void => {
		showAppModal({ title: '用户协议', content: userAgreement, showCancel: false })
	}

	const gotoPrivacy = (): void => {
		showAppModal({ title: '隐私政策', content: privacyPolicy, showCancel: false })
	}
</script>

