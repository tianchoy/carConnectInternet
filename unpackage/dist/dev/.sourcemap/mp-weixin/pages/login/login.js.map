	}

	.password-input {
		margin-bottom: 34rpx;
	}

	.documents {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-top: 25rpx;
	}

	.doc-info-box {
		display: flex;
		flex-direction: row;
		align-items: center;
		white-space: nowrap;
	}

	.doc-text,
	.doc-link {
		font-size: 30rpx;
		line-height: 44rpx;
	}

	.doc-text {
		color: #8195ac;
	}

	.doc-link {
		color: #2e83df;
	}

	.wechat-login {
		margin-top: 48rpx;
		padding: 0 38rpx;
	}

	.wechat-login-button {
		width: 100%;
		border-color: #3485df;
		border-radius: 52rpx;
		color: #3485df;
		font-size: 34rpx;
	}

	:deep(.i-input) {
		box-sizing: border-box;
	}

	:deep(.i-input__field) {
		padding-top: 0;
		padding-bottom: 0;
	}

	:deep(.i-checkbox) {
		min-height: 44rpx;
	}

	:deep(.i-button__text) {
		font-size: 38rpx;
		font-weight: 600;
	}

		/* Login page visual refinement: scoped so other authentication pages are unaffected. */
		.login-submit {
			margin-top: 42rpx;
		}

		.wechat-login {
			margin-top: 42rpx;
			padding: 0 38rpx;
		}

		.wechat-login-button {
			border-color: #2f83df;
			color: #2f83df;
			font-size: 32rpx;
		}

		:deep(.i-input) {
			padding: 0 34rpx;
			border-width: 2rpx !important;
		}

		:deep(.i-input--focus) {
			border-color: #3485df !important;
			background-color: #ffffff;
		}

		:deep(.i-input__eye) {
			margin-left: 14rpx;
			opacity: 0.78;
		}

		:deep(.i-checkbox__box) {
			border-width: 2rpx;
			border-radius: 12rpx;
		}

		:deep(.i-button__text) {
