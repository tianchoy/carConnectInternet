import { isBusinessSuccessCode } from '../api/response.uts'
import { getDeviceSubscribeTicket, getDeviceSubscribeStatus, reportDeviceSubscribe, type DeviceSubscribeReportRequest } from '../api/request.uts'

/**
 * 硬件设备长期订阅（订阅设备消息）
 *
 * 前端流程：
 * 1. 向后端换取订阅参数：sn（设备序列号）、modelId（注册设备型号）、snTicket（5 分钟有效，服务端调 /wxa/getsnticket 实时获取，不可缓存）
 * 2. 调用 wx.requestSubscribeDeviceMessage 弹出授权框（需基础库 2.20.0+，单次最多 3 个 tmplId）
 * 3. 将授权结果上报后端落库（openid × sn × templateId 的订阅关系由后端维护）
 *
 * 服务端下发（后端职责）：
 * POST https://api.weixin.qq.com/cgi-bin/message/device/subscribe/send
 * { template_id, sn, modelId, page, to_openid_list: [openid], lang, data }
 */

// TODO: 模版 ID 必须与小程序后台「订阅消息 - 我的模板」中完全一致（0/O、l/I、b/p 等字符易混淆），上线前请从后台复制核对
const TMPL_ID_VEHICLE_ALARM = 'T35__Egmgn0Rqib_xeGw-qzLN7G-vlG4RDnD1xQdFo'

export type DeviceSubscribeResult = 'accept' | 'reject' | 'ban' | 'filter' | 'acceptWithAudio' | 'unknown'

export type DeviceSubscribeOutcome = {
    requested: boolean
    errMsg: string
    errCode: number
    result: DeviceSubscribeResult
}

export function isDeviceSubscribeSupported() : boolean {
    // #ifdef MP-WEIXIN
    return true
    // #endif
    return false
}

function parseSubscribeResult(value : string) : DeviceSubscribeResult {
    if (value == 'accept' || value == 'reject' || value == 'ban' || value == 'filter' || value == 'acceptWithAudio') {
        return value as DeviceSubscribeResult
    }
    return 'unknown'
}

/**
 * 请求订阅指定设备：内部先向后端换取 sn/snTicket/modelId，再弹出授权框，最后上报结果
 * @returns requested=false 表示未走到授权弹窗（参数缺失/环境不支持等），看 errMsg
 */
export async function requestDeviceSubscribe(deviceId : string) : Promise<DeviceSubscribeOutcome> {
    const outcome : DeviceSubscribeOutcome = { requested: false, errMsg: '', errCode: 0, result: 'unknown' }
    if (!isDeviceSubscribeSupported()) {
        outcome.errMsg = '当前环境不支持设备订阅'
        return outcome
    }
    try {
        const ticketRes = await getDeviceSubscribeTicket(deviceId)
        if (!isBusinessSuccessCode(ticketRes.code) || ticketRes.data == null) {
            outcome.errMsg = ticketRes.msg != '' ? ticketRes.msg : '获取设备票据失败'
            console.warn('[DeviceSubscribe] 获取订阅参数失败:', ticketRes.msg)
            return outcome
        }
        const sn = ticketRes.data.getString('sn', '')
        const modelId = ticketRes.data.getString('modelId', '')
        const snTicket = ticketRes.data.getString('snTicket', '')
        if (sn == '' || modelId == '' || snTicket == '') {
            outcome.errMsg = '设备订阅参数不完整'
            console.warn('[DeviceSubscribe] 订阅参数不完整:', ticketRes.data)
            return outcome
        }
        return await callWxSubscribe(deviceId, sn, modelId, snTicket)
    } catch (error) {
        outcome.errMsg = '订阅请求异常，请稍后重试'
        console.error('[DeviceSubscribe] 订阅流程异常:', error)
        return outcome
    }
}

function callWxSubscribe(deviceId : string, sn : string, modelId : string, snTicket : string) : Promise<DeviceSubscribeOutcome> {
    return new Promise((resolve) => {
        const outcome : DeviceSubscribeOutcome = { requested: false, errMsg: '', errCode: 0, result: 'unknown' }
        // #ifdef MP-WEIXIN
        wx.requestSubscribeDeviceMessage({
            tmplIds: [TMPL_ID_VEHICLE_ALARM],
            sn: sn,
            snTicket: snTicket,
            modelId: modelId,
            success: (res : any) => {
                outcome.requested = true
                const resObj = res as UTSJSONObject | null
                outcome.result = parseSubscribeResult(resObj != null ? resObj.getString(TMPL_ID_VEHICLE_ALARM, '') : '')
                reportSubscribeOutcome(deviceId, sn, outcome)
                resolve(outcome)
            },
            fail: (err : any) => {
                outcome.requested = true
                const errObj = err as UTSJSONObject | null
                if (errObj != null) {
                    outcome.errMsg = errObj.getString('errMsg', '')
                    outcome.errCode = errObj.getNumber('errCode', 0)
                }
                reportSubscribeOutcome(deviceId, sn, outcome)
                resolve(outcome)
            }
        })
        // #endif
        // #ifndef MP-WEIXIN
        resolve(outcome)
        // #endif
    })
}

async function reportSubscribeOutcome(deviceId : string, sn : string, outcome : DeviceSubscribeOutcome) : Promise<void> {
    try {
        const data : DeviceSubscribeReportRequest = {
            deviceId: deviceId,
            sn: sn,
            templateId: TMPL_ID_VEHICLE_ALARM,
            result: outcome.requested ? outcome.result : 'fail',
            errMsg: outcome.errMsg,
            errCode: outcome.errCode
        }
        const res = await reportDeviceSubscribe(data)
        if (!isBusinessSuccessCode(res.code)) {
            console.warn('[DeviceSubscribe] 订阅结果上报失败:', res.msg)
        }
    } catch (error) {
        console.warn('[DeviceSubscribe] 订阅结果上报异常:', error)
    }
}

/**
 * 查询指定设备是否已订阅（以后端落库为准；本地只做展示，不做持久化）
 */
export async function queryDeviceSubscribeStatus(deviceId : string) : Promise<boolean> {
    if (!isDeviceSubscribeSupported() || deviceId == '') return false
    try {
        const res = await getDeviceSubscribeStatus(deviceId)
        if (!isBusinessSuccessCode(res.code) || res.data == null) return false
        return res.data.getBoolean('subscribed', false)
    } catch (error) {
        console.warn('[DeviceSubscribe] 查询订阅状态失败:', error)
        return false
    }
}
