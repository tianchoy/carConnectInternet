<template>
  <view class="i-picker">
    <view v-if="showInput" class="i-picker__trigger" @click="openByTrigger">
      <slot name="trigger">
        <slot>
          <view class="i-picker__input">
            <text :class="displayTextClass">{{ displayText }}</text>
            <text class="i-picker__arrow">›</text>
          </view>
        </slot>
      </slot>
    </view>

    <view v-if="opened" class="i-picker__mask" @click="handleOverlayClick">
      <view class="i-picker__panel" :style="panelStyle" @click.stop="">
        <view v-if="showToolbar" class="i-picker__toolbar">
          <text
            class="i-picker__cancel"
            :style="'color:' + cancelColor + ';'"
            @click="cancel"
          >
            {{ cancelText }}
          </text>
          <text class="i-picker__title">{{ title }}</text>
          <text
            class="i-picker__confirm"
            :style="'color:' + confirmColor + ';'"
            @click="confirm"
          >
            {{ confirmText }}
          </text>
        </view>

        <view v-if="loading" class="i-picker__loading">
          <text class="i-picker__loading-text">加载中...</text>
        </view>

        <picker-view
          class="i-picker__columns"
          :style="columnsStyle"
          :value="currentIndexs"
          :indicator-style="indicatorStyle"
          @change="handlePickerChange"
        >
          <picker-view-column v-if="columnCount > 0" class="i-picker__column">
            <view
              v-for="(item, itemIndex) in column0"
              :key="item.value"
              :class="itemClass(item, 0, itemIndex)"
              :style="itemStyle"
            >
              <text
                :class="itemTextClass(item, 0, itemIndex)"
                :style="itemTextStyle(item, 0, itemIndex)"
              >
                {{ item.text }}
              </text>
            </view>
          </picker-view-column>

          <picker-view-column v-if="columnCount > 1" class="i-picker__column">
            <view
              v-for="(item, itemIndex) in column1"
              :key="item.value"
              :class="itemClass(item, 1, itemIndex)"
              :style="itemStyle"
            >
              <text
                :class="itemTextClass(item, 1, itemIndex)"
                :style="itemTextStyle(item, 1, itemIndex)"
              >
                {{ item.text }}
              </text>
            </view>
          </picker-view-column>

          <picker-view-column v-if="columnCount > 2" class="i-picker__column">
            <view
              v-for="(item, itemIndex) in column2"
              :key="item.value"
              :class="itemClass(item, 2, itemIndex)"
              :style="itemStyle"
            >
              <text
                :class="itemTextClass(item, 2, itemIndex)"
                :style="itemTextStyle(item, 2, itemIndex)"
              >
                {{ item.text }}
              </text>
            </view>
          </picker-view-column>

          <picker-view-column v-if="columnCount > 3" class="i-picker__column">
            <view
              v-for="(item, itemIndex) in column3"
              :key="item.value"
              :class="itemClass(item, 3, itemIndex)"
              :style="itemStyle"
            >
              <text
                :class="itemTextClass(item, 3, itemIndex)"
                :style="itemTextStyle(item, 3, itemIndex)"
              >
                {{ item.text }}
              </text>
            </view>
          </picker-view-column>

          <picker-view-column v-if="columnCount > 4" class="i-picker__column">
            <view
              v-for="(item, itemIndex) in column4"
              :key="item.value"
              :class="itemClass(item, 4, itemIndex)"
              :style="itemStyle"
            >
              <text
                :class="itemTextClass(item, 4, itemIndex)"
                :style="itemTextStyle(item, 4, itemIndex)"
              >
                {{ item.text }}
              </text>
            </view>
          </picker-view-column>

          <picker-view-column v-if="columnCount > 5" class="i-picker__column">
            <view
              v-for="(item, itemIndex) in column5"
              :key="item.value"
              :class="itemClass(item, 5, itemIndex)"
              :style="itemStyle"
            >
              <text
                :class="itemTextClass(item, 5, itemIndex)"
                :style="itemTextStyle(item, 5, itemIndex)"
              >
                {{ item.text }}
              </text>
            </view>
          </picker-view-column>
        </picker-view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref, watch } from 'vue'

defineOptions({ name: 'i-picker' })

/**
 * Props 说明：依据 DCloud uni-app x 官方规范 Picker，并保留旧版 options/value 写法。
 * - modelValue: 当前选中项的 value；多列时为 value 数组，支持 v-model 默认值。
 * - show: 是否展示 picker 弹层。
 * - showToolbar: 是否显示顶部取消/标题/确认操作栏。
 * - title: 顶部标题。
 * - columns: 选择器数据；单列为一维数组，多列为二维数组，选项结构为 { text, value, disabled }。
 * - loading: 是否显示加载中状态。
 * - itemHeight: 每个滚轮选项行高度，会同步给 picker-view 选中框。
 * - cancelText/confirmText: 取消和确认按钮文字。
 * - cancelColor/confirmColor: 取消和确认按钮颜色。
 * - visibleItemCount: 每列可见选项数量，用于计算滚轮内容高度。
 * - closeOnMask: 点击遮罩是否关闭。
 * - defaultIndex: 默认选中索引；单列为数字，多列为数字数组。
 * - immediateChange: 选择选项时是否立即同步 modelValue；关闭时仅 confirm 同步。
 * - round: 弹层顶部圆角。
 * - showInput: 是否显示输入框触发器；组件也支持 trigger/default 插槽自定义触发器。
 * - showDefaultValue: 没有 modelValue 时是否按 defaultIndex 展示默认值。
 * - options/value: 旧版参数兼容。
 * - disabled: 是否禁用触发和选择。
 */
const props = defineProps({
  modelValue: {
    type: [String, Number, Array],
    default: '',
  },
  show: {
    type: Boolean,
    default: false,
  },
  showToolbar: {
    type: Boolean,
    default: true,
  },
  title: {
    type: String,
    default: '',
  },
  columns: {
    type: Array,
    default: () => [],
  },
  loading: {
    type: Boolean,
    default: false,
  },
  itemHeight: {
    type: [String, Number],
    default: 44,
  },
  cancelText: {
    type: String,
    default: '取消',
  },
  confirmText: {
    type: String,
    default: '确认',
  },
  cancelColor: {
    type: String,
    default: '#909193',
  },
  confirmColor: {
    type: String,
    default: '#3c9cff',
  },
  visibleItemCount: {
    type: [String, Number],
    default: 5,
  },
  closeOnMask: { type: Boolean, default: true },
  defaultIndex: {
    type: [Number, Array],
    default: 0,
  },
  immediateChange: {
    type: Boolean,
    default: false,
  },
  round: {
    type: [String, Number],
    default: 16,
  },
  showInput: {
    type: Boolean,
    default: true,
  },
  showDefaultValue: {
    type: Boolean,
    default: true,
  },
  options: {
    type: Array,
    default: () => ['Apple', 'Orange', 'Banana'],
  },
  value: {
    type: [String, Number],
    default: '',
  },
  disabled: {
    type: Boolean,
    default: false,
  },
})

/**
 * Emits 说明：组件向外派发弹层状态、选择变化和确认结果。
 * - open: 弹层打开时触发。
 * - close: 弹层关闭时触发。
 * - cancel: 点击取消时触发，参数为当前选择事件对象。
 * - change: 选择项变化时触发，参数包含 index、indexs、columnIndex、value、values。
 * - confirm: 点击确认时触发，参数包含 indexs、value、values。
 * - clear: 兼容旧版清空事件。
 * - update:value: 兼容旧版 value 同步。
 * - update:modelValue: 同步 v-model。
 * - update:show: 同步 show 弹层状态。
 */
const emit = defineEmits([
  'open',
  'close',
  'cancel',
  'change',
  'confirm',
  'clear',
  'update:value',
  'update:modelValue',
  'update:show',
])

type IPickerItem = {
  text : string,
  value : any | null,
  disabled : boolean,
}

function isArray(value : any | null) : boolean {
  return value != null && Array.isArray(value)
}

function normalizeItem(item : any | null) : IPickerItem {
  if (item != null && typeof item == 'object') {
    const object = item as UTSJSONObject
    const rawText = object['text']
    const rawValue = object['value']
    const text = rawText != null ? rawText.toString() : (rawValue == null ? '' : rawValue.toString())
    const value = rawValue != null ? rawValue : text
    return { text, value, disabled: object['disabled'] == true }
  }
  return {
    text: item == null ? '' : item.toString(),
    value: item,
    disabled: false,
  }
}

function normalizeColumn(list : any | null) : Array<IPickerItem> {
  const result : Array<IPickerItem> = []
  if (list == null || !Array.isArray(list)) return result
  const values = list as Array<any | null>
  for (let i = 0; i < values.length; i++) result.push(normalizeItem(values[i]))
  return result
}


const opened = ref(props.show)
const currentIndexs = ref<Array<number>>([])

const normalizedColumns = computed(() : Array<Array<IPickerItem>> => {
  const columns = props.columns
  const options = props.options
  const source : Array<any | null> = columns != null && columns.length > 0
    ? columns
    : (options == null ? [] : options)
  if (source.length == 0) return []

  const first = source[0]
  if (isArray(first)) {
    const result : Array<Array<IPickerItem>> = []
    for (let i = 0; i < source.length; i++) result.push(normalizeColumn(source[i]))
    return result
  }

  return [normalizeColumn(source)]
})

function selectedIndexAt(columnIndex : number) : number {
  if (currentIndexs.value.length <= columnIndex) return 0
  return currentIndexs.value[columnIndex]
}

function selectedItems() : Array<IPickerItem> {
  const result : Array<IPickerItem> = []
  const columns = normalizedColumns.value
  for (let i = 0; i < columns.length; i++) {
    const column = columns[i]
    const index = selectedIndexAt(i)
    if (index >= 0 && index < column.length) result.push(column[index])
  }
  return result
}

function columnAt(index : number) : Array<IPickerItem> {
  if (index < 0 || index >= normalizedColumns.value.length) return []
  return normalizedColumns.value[index]
}

function visibleCountNumber() : number {
  const count = parseFloat(props.visibleItemCount.toString())
  if (isNaN(count) || count <= 0) return 5
  return count
}

function itemHeightNumber() : number {
  const height = parseFloat(props.itemHeight.toString())
  if (isNaN(height) || height <= 0) return 44
  return height
}

function formatSize(value : any) : string {
  const text = value.toString()
  if (text.indexOf('px') >= 0 || text.indexOf('rpx') >= 0 || text.indexOf('%') >= 0) {
    return text
  }
  return text + 'px'
}

const displayText = computed(() : string => {
  const items = selectedItems()
  if (items.length == 0) return '请选择'

  const texts : Array<string> = []
  for (let i = 0; i < items.length; i++) texts.push(items[i].text)
  return texts.join(' / ')
})

const displayTextClass = computed(() : string => {
  return selectedItems().length == 0
    ? 'i-picker__input-text i-picker__input-text--placeholder'
    : 'i-picker__input-text'
})

const columnCount = computed(() : number => {
  return normalizedColumns.value.length
})

const column0 = computed(() : Array<IPickerItem> => columnAt(0))
const column1 = computed(() : Array<IPickerItem> => columnAt(1))
const column2 = computed(() : Array<IPickerItem> => columnAt(2))
const column3 = computed(() : Array<IPickerItem> => columnAt(3))
const column4 = computed(() : Array<IPickerItem> => columnAt(4))
const column5 = computed(() : Array<IPickerItem> => columnAt(5))

const columnsStyle = computed(() => {
  const height = itemHeightNumber() * visibleCountNumber()
  return 'width:100%;height:' + (height).toString() + 'px;'
})

const indicatorStyle = computed(() => {
  return (
    'height:' +
    formatSize(props.itemHeight) +
    ';background-color:transparent;border-top:1px solid #eef0f4;border-bottom:1px solid #eef0f4;'
  )
})

const itemStyle = computed(() => {
  return 'height:' + formatSize(props.itemHeight) + ';'
})

const panelStyle = computed(() => {
  const radius = formatSize(props.round)
  return 'border-radius:' + radius + ' ' + radius + ' 0 0;'
})

function hasModelValue() : boolean {
  const value = props.modelValue
  if (isArray(value)) return (value as Array<any | null>).length > 0
  return value.toString().length > 0
}

function activeModelValue() : any | null {
  if (hasModelValue()) return props.modelValue
  if (props.value.toString().length > 0) return props.value
  return null
}

function columnTargetValue(value : any | null, columnIndex : number) : any | null {
  if (value == null) return null
  if (isArray(value)) {
    const values = value as Array<any | null>
    return values.length > columnIndex ? values[columnIndex] : null
  }
  return columnIndex == 0 ? value : null
}

function defaultIndexAt(columnIndex : number) : number {
  const value = props.defaultIndex
  if (isArray(value)) {
    const values = value as Array<any | null>
    if (values.length > columnIndex) {
      const item = values[columnIndex]
      return item == null ? 0 : parseFloat(item.toString())
    }
    return 0
  }
  return columnIndex == 0 ? parseFloat(value.toString()) : 0
}

function findValueIndex(column : Array<IPickerItem>, value : any) : number {
  const valueText = value.toString()
  for (let i = 0; i < column.length; i++) {
    const itemValue = column[i].value
    if (itemValue != null && itemValue.toString() == valueText) return i
  }
  return -1
}

function selectedValue() : any {
  const items = selectedItems()
  if (items.length == 0) return ''
  if (items.length == 1) {
    const value = items[0].value
    return value == null ? '' : value
  }

  const values : Array<any | null> = []
  for (let i = 0; i < items.length; i++) values.push(items[i].value)
  return values
}

function pickerValuePayload() : any {
  const items = selectedItems()
  if (items.length == 1) return items[0]
  return items
}

function buildChangeEvent(columnIndex : number, index : number) : UTSJSONObject {
  return {
    index,
    indexs: currentIndexs.value,
    columnIndex,
    value: pickerValuePayload(),
    values: selectedItems(),
  }
}

function buildConfirmEvent() : UTSJSONObject {
  return {
    indexs: currentIndexs.value,
    value: pickerValuePayload(),
    values: selectedItems(),
  }
}

function emitSelectedValue() : void {
  const value = selectedValue()
  emit('update:modelValue', value)
  emit('update:value', isArray(value) ? '' : value)
}

function syncIndexs() : void {
  const columns = normalizedColumns.value
  const result : Array<number> = []
  const value = activeModelValue()
  for (let i = 0; i < columns.length; i++) {
    const column = columns[i]
    const targetValue = columnTargetValue(value, i)
    let index = -1
    if (targetValue != null && targetValue.toString().length > 0) {
      index = findValueIndex(column, targetValue)
    }
    if (index < 0 && (props.showDefaultValue || !hasModelValue())) index = defaultIndexAt(i)
    if (index < 0) index = 0
    if (index >= column.length) index = column.length - 1
    result.push(index)
  }
  currentIndexs.value = result
}

function close() : void {
  if (!opened.value) return
  opened.value = false
  emit('close')
  emit('update:show', false)
}

function open() : void {
  if (opened.value) return
  syncIndexs()
  opened.value = true
  emit('open')
  emit('update:show', true)
}

function openByTrigger() : void {
  if (!props.disabled) open()
}

function cancel() : void {
  emit('cancel', buildChangeEvent(0, selectedIndexAt(0)))
  close()
}

function confirm() : void {
  emit('confirm', buildConfirmEvent())
  emitSelectedValue()
  close()
}

function clear() : void {
  currentIndexs.value = []
  emit('clear')
  emit('change', buildChangeEvent(0, -1))
  emit('update:value', '')
  emit('update:modelValue', '')
}

function handleOverlayClick() : void {
  if (props.closeOnMask) close()
}

function handlePickerChange(event : any) : void {
  if (props.disabled || props.loading || event == null || typeof event != 'object') return
  const detail = (event as UTSJSONObject)['detail']
  if (detail == null || typeof detail != 'object') return
  const rawValues = (detail as UTSJSONObject)['value']
  if (rawValues == null || !Array.isArray(rawValues)) return
  const values = rawValues as Array<any | null>
  const nextIndexs : Array<number> = []
  let changedColumnIndex = 0
  for (let i = 0; i < normalizedColumns.value.length; i++) {
    const column = normalizedColumns.value[i]
    const oldIndex = selectedIndexAt(i)
    let nextIndex = 0
    if (values.length > i) {
      const rawIndex = values[i]
      if (rawIndex != null) nextIndex = parseFloat(rawIndex.toString())
    }
    if (nextIndex < 0) nextIndex = 0
    if (nextIndex >= column.length) nextIndex = column.length - 1
    if (column.length > 0 && column[nextIndex].disabled) nextIndex = oldIndex
    if (oldIndex != nextIndex) changedColumnIndex = i
    nextIndexs.push(nextIndex)
  }
  currentIndexs.value = nextIndexs
  emit('change', buildChangeEvent(changedColumnIndex, selectedIndexAt(changedColumnIndex)))
  if (props.immediateChange) emitSelectedValue()
}

function itemClass(item : IPickerItem, columnIndex : number, itemIndex : number) : string {
  const classes = ['i-picker__item']
  if (selectedIndexAt(columnIndex) == itemIndex) classes.push('i-picker__item--active')
  if (item.disabled) classes.push('i-picker__item--disabled')
  return classes.join(' ')
}

function itemTextClass(item : IPickerItem, columnIndex : number, itemIndex : number) : string {
  return selectedIndexAt(columnIndex) == itemIndex
    ? 'i-picker__item-text i-picker__item-text--active'
    : 'i-picker__item-text'
}

function itemTextStyle(item : IPickerItem, columnIndex : number, itemIndex : number) : string {
  let style = 'line-height:' + formatSize(props.itemHeight) + ';color:#606266;'
  if (selectedIndexAt(columnIndex) == itemIndex) {
    style = style + 'color:#111827;'
  }
  return style
}

function getIndexs() : Array<number> {
  return currentIndexs.value
}

function getValues() : any {
  return selectedItems()
}

function getColumns() : any {
  return normalizedColumns.value
}

function getColumnValues(columnIndex : number) : Array<IPickerItem> {
  if (columnIndex < 0 || columnIndex >= normalizedColumns.value.length) return [] as Array<IPickerItem>
  return normalizedColumns.value[columnIndex]
}

function setColumnValues(columnIndex : number, values : Array<any | null>) : void {
  // columns 是外部受控数据，组件只提供兼容方法入口，不直接修改 props。
  emit('change', {
    index: selectedIndexAt(columnIndex),
    indexs: currentIndexs.value,
    columnIndex,
    value: values,
    values,
  })
}

watch(
  () : boolean => props.show,
  (nextValue : boolean) : void => {
    if (opened.value == nextValue) return
    opened.value = nextValue
    if (nextValue) {
      syncIndexs()
      emit('open')
    } else {
      emit('close')
    }
  },
)

watch(
  () : any => props.modelValue,
  () : void => { syncIndexs() },
)

watch(
  () : any => props.value,
  () : void => { syncIndexs() },
)

watch(
  () : Array<any | null> | null => props.columns,
  () : void => { syncIndexs() },
)

watch(
  () : any => props.defaultIndex,
  () : void => { syncIndexs() },
)

syncIndexs()

defineExpose({
  open,
  close,
  clear,
  getIndexs,
  getValues,
  getColumns,
  getColumnValues,
  setColumnValues,
})
</script>

<style>
.i-picker {
  width: 100%;
}

.i-picker__trigger {
  width: 100%;
}

.i-picker__input {
  height: 44px;
  padding: 0 12px;
  border-radius: 8px;
  background-color: #ffffff;
  flex-direction: row;
  align-items: center;
}

.i-picker__input-text {
  flex: 1;
  color: #303133;
  font-size: 14px;
  line-height: 22px;
}

.i-picker__input-text--placeholder {
  color: #909193;
}

.i-picker__arrow {
  width: 20px;
  color: #909193;
  font-size: 20px;
  line-height: 24px;
  text-align: right;
  transform: rotate(90deg);
}

.i-picker__mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 150;
  background-color: rgba(0, 0, 0, 0.42);
  justify-content: flex-end;
}

.i-picker__panel {
  overflow: hidden;
  background-color: #ffffff;
}

.i-picker__toolbar {
  height: 48px;
  padding: 0 16px;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #eef0f4;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.i-picker__cancel,
.i-picker__confirm {
  width: 64px;
  font-size: 14px;
  line-height: 22px;
}

.i-picker__confirm {
  text-align: right;
}

.i-picker__title {
  flex: 1;
  color: #111827;
  font-size: 16px;
  font-weight: 700;
  line-height: 24px;
  text-align: center;
}

.i-picker__loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 48px;
  bottom: 0;
  z-index: 2;
  background-color: rgba(255, 255, 255, 0.78);
  align-items: center;
  justify-content: center;
}

.i-picker__loading-text {
  color: #606266;
  font-size: 14px;
  line-height: 22px;
}

.i-picker__columns {
  width: 100%;
}

.i-picker__column {
  flex: 1;
  height: 100%;
}

.i-picker__item {
  width: 100%;
  padding: 0 8px;
  align-items: center;
  justify-content: center;
}

.i-picker__item--active {
  background-color: transparent;
}

.i-picker__item--disabled {
  opacity: 0.42;
}

.i-picker__item-text {
  color: #303133;
  font-size: 15px;
  line-height: 22px;
  text-align: center;
}

.i-picker__item-text--active {
  color: #111827;
  font-weight: 700;
}
</style>
