/**
 * 获取推送是否被停止的状态（iOS 6.0.0+）
 * @param callback (code, isStopped) code 为 0 表示成功，isStopped 为 true 表示推送已停止。code 为0 时，isStopped的值才有效。
 */
export function getPushStatus(callback : (code : number, isStopped : boolean) => void) : void {
	log("getPushStatus")
	const completion = (iResCode : Int, isStopped : Boolean) => {
		callback(iResCode as number, isStopped as boolean)
	}
	JPUSHService.getPushStatus(completion)
}

/**
 * 获取 RegistrationID。JPush 网络注册完成前，同步接口可能返回空值；
 * 此回调会在 SDK 完成注册或明确返回错误后执行。
 */
export function getRegistrationIdAsync(callback : (result : RegistrationIdResult) => void) : void {
	log("getRegistrationIdAsync")
	JPUSHService.registrationIDCompletionHandler((resCode : Int, registrationId : String | null) => {
		const result : RegistrationIdResult = {
			code: Number(resCode),
			registrationId: registrationId === null ? "" : registrationId!
		}
		log(registrationId === null || registrationId == "" ? "JPush RegistrationID callback returned empty ID" : "JPush RegistrationID callback completed")
		if (resCode != 0) log("JPush RegistrationID callback error code", Number(resCode))
		callback(result)
	})
}

/**
 * 获取RegistrationID
 */
export function getRegistrationId() : string {
	log("getRegistrationId")
	return JPUSHService.registrationID()
}

/**
 * 设置标签
 */
export function setTags(sequence : Int, tags : string[]) : void {
	log("setTags", sequence, tags)
	// 单独定义回调函数，并明确指定其类型
	const callback  = (iResCode : Int, iTags : Swift.Set<AnyHashable>  | null, seq : Int) => {
		const result = {
			code: iResCode,
			tags: iTags,
			sequence: seq
		}
		log("setTags completion", result)
		eventCallbackManager.triggerEvent("onTagOperatorResult", JSON.stringify(result)!)
	}
	const setTags:Swift.Set<String> = new Swift.Set<String>(tags)
	JPUSHService.setTags(setTags, completion = callback, seq = sequence)
}


