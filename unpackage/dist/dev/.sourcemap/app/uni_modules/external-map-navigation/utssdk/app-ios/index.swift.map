import { URL } from 'Foundation'
import { UIApplication } from 'UIKit'
import { ExternalMapNavigationParams, ExternalMapNavigationResult, IOSMapProvider } from '../interface.uts'

function result(code: string): ExternalMapNavigationResult {
	return { code: code }
}

function createURL(value: string): URL | null {
	try {
		return new URL((string = value))
	} catch (error) {
		__f__('error','at uni_modules/external-map-navigation/utssdk/app-ios/index.uts:13','创建地图链接失败:', error)
		return null
	}
}

function canOpen(value: string): boolean {
	const url = createURL(value)
	if (url == null) return false
	return UIApplication.shared.canOpenURL(url!)
}

export function getIOSMapProviders(): Array<IOSMapProvider> {
	const providers: Array<IOSMapProvider> = [{ id: 'apple', name: 'Apple 地图' }]
	if (canOpen('iosamap://')) providers.push({ id: 'amap', name: '高德地图' })
	if (canOpen('qqmap://')) providers.push({ id: 'tencent', name: '腾讯地图' })
	if (canOpen('baidumap://')) providers.push({ id: 'baidu', name: '百度地图' })
	if (canOpen('comgooglemaps://')) providers.push({ id: 'google', name: 'Google 地图' })
	return providers
}

export function openIOSMap(providerId: string, params: ExternalMapNavigationParams): ExternalMapNavigationResult {
	let name = '车辆位置'
	if (params.name != null && params.name != '') {
		name = params.name!
	}
	const encodedName = encodeURIComponent(name)
	const gcjLatitude = params.latitude.toString()
	const gcjLongitude = params.longitude.toString()
	let urlText = ''

	if (providerId == 'amap') {
		urlText = 'iosamap://navi?sourceApplication=车载GPS&poiname=' + encodedName +
			'&lat=' + gcjLatitude + '&lon=' + gcjLongitude + '&dev=0&style=0'
	} else if (providerId == 'tencent') {
		urlText = 'qqmap://map/routeplan?type=drive&from=我的位置&fromcoord=CurrentLocation&to=' + encodedName +
			'&tocoord=' + gcjLatitude + ',' + gcjLongitude +
			'&referer=FUTBZ-I7V3W-Y7TR2-YK62F-IFTZK-73FKD'
	} else if (providerId == 'baidu') {
		urlText = 'baidumap://map/direction?origin=我的位置&destination=name:' + encodedName +
			'|latlng:' + gcjLatitude + ',' + gcjLongitude + '&mode=driving&coord_type=gcj02'
	} else {
		const wgsLatitude = (params.wgs84Latitude ?? params.latitude).toString()
		const wgsLongitude = (params.wgs84Longitude ?? params.longitude).toString()
		if (providerId == 'google') {
			urlText = 'comgooglemaps://?daddr=' + wgsLatitude + ',' + wgsLongitude + '&directionsmode=driving'
		} else {
			urlText = 'https://maps.apple.com/?daddr=' + wgsLatitude + ',' + wgsLongitude + '&dirflg=d'
		}
	}

	const url = createURL(urlText)
	if (url == null) {
		return result('launch_failed')
	}
	if (!UIApplication.shared.canOpenURL(url!)) {
		return result('launch_failed')
	}

	try {
		const opened = UIApplication.shared.openURL(url!)
		return opened ? result('opened') : result('launch_failed')
	} catch (error) {
		__f__('error','at uni_modules/external-map-navigation/utssdk/app-ios/index.uts:75','打开 iOS 地图失败:', error)
		return result('launch_failed')
	}
}
