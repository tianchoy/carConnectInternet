		font-weight: 700;
		line-height: 76rpx;
	}

	.page-subtitle {
		display: flex;
		margin-top: 28rpx;
		color: #7f96ae;
		font-size: 30rpx;
		line-height: 44rpx;
	}

	.password-input {
		width: 100%;
		margin-top: 62rpx;
	}

	.confirm-password-input {
		margin-top: 30rpx;
	}

	.password-hint {
		display: flex;
		margin: 22rpx 6rpx 0;
		color: #7f96ae;
		font-size: 26rpx;
		line-height: 40rpx;
	}

	.submit-button {
		margin-top: 70rpx;
	}

	:deep(.i-input) {
		box-sizing: border-box;
	}

	:deep(.i-input__field) {
		padding-top: 0;
		padding-bottom: 0;
	}

	:deep(.i-button__text) {
		font-size: 38rpx;
		font-weight: 600;
	}
</style>
