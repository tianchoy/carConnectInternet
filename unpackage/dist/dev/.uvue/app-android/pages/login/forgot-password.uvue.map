<template>
	<view class="container">
		<custom-navBar title="找回密码" :show-back="true" backgroundColor="#fbfcfe" textColor="#333333" :showCapsule="false">
		</custom-navBar>

		<view class="content">
			<view class="forgot-password-steps">
				<view class="forgot-password-steps__indicators">
					<view class="forgot-password-steps__dot forgot-password-steps__dot--active">
						<text class="forgot-password-steps__index">1</text>
					</view>
					<view
						class="forgot-password-steps__line"
						:class="{ 'forgot-password-steps__line--active': currentStep > 1 }"
					></view>
					<view
						class="forgot-password-steps__dot"
						:class="{ 'forgot-password-steps__dot--active': currentStep > 1 }"
					>
						<text class="forgot-password-steps__index">2</text>
					</view>
					<view
						class="forgot-password-steps__line"
						:class="{ 'forgot-password-steps__line--active': currentStep > 2 }"
					></view>
					<view
						class="forgot-password-steps__dot"
						:class="{ 'forgot-password-steps__dot--active': currentStep > 2 }"
					>
						<text class="forgot-password-steps__index">3</text>
					</view>
				</view>
				<view class="forgot-password-steps__titles">
					<text
						v-for="(item, index) in stepItems"
						:key="item"
						class="forgot-password-steps__title"
						:class="[
							'forgot-password-steps__title--' + index,
							{ 'forgot-password-steps__title--active': index < currentStep }
						]"
					>{{ item }}</text>
				</view>
			</view>

			<view v-if="currentStep == 1" class="form-section verify-section">
				<i-input
					v-model="form.mobile"
					class="form-input"
					placeholder="请输入绑定的手机号"
					type="number"
					:maxlength="11"
					clearable
					height="110rpx"
					round="25rpx"
					borderColor="#d7e3ef"
					placeholderStyle="color:#a8b8ca;font-size:28rpx;"
					fontSize="28rpx"
					color="#333333"
				>
					<template v-slot:prefix>
						<text class="country-code">+86</text>
					</template>
				</i-input>

				<i-input
					v-model="form.smsCode"
					class="form-input sms-code-input"
					placeholder="请输入6位验证码"
					type="number"
					:maxlength="6"
					clearable
					height="110rpx"
					round="25rpx"
					borderColor="#d7e3ef"
					placeholderStyle="color:#a8b8ca;font-size:28rpx;"
					fontSize="28rpx"
					color="#333333"
				>
					<template v-slot:suffix>
						<view
							class="sms-send-button"
							:class="{ 'sms-send-button-disabled': smsCooldown > 0 || smsSending }"
							@click="requestSmsCode"
						>
							<text class="sms-send-button-text">{{ smsCooldown > 0 ? smsCooldown + '秒后重试' : '获取验证码' }}</text>
						</view>
					</template>
				</i-input>

				<i-button class="submit-button" type="primary" block round="25rpx" color="#3485df" customStyle="height:104rpx;" :disabled="!isIdentityVerificationReady" @click="goToPasswordStep">
					下一步
				</i-button>
			</view>

			<view v-else-if="currentStep == 2" class="form-section password-section">
				<i-input
					v-model="form.password"
					class="form-input"
					placeholder="请输入新密码"
					:password="true"
					height="110rpx"
					round="25rpx"
					borderColor="#d7e3ef"
					placeholderStyle="color:#a8b8ca;font-size:28rpx;"
					fontSize="28rpx"
					color="#333333"
				/>
				<text class="password-hint">8–16 位，且必须包含数字、字母、特殊字符中的至少两种</text>

				<i-input
					v-model="form.confirmPassword"
					class="form-input confirm-password-input"
					placeholder="请再次输入新密码"
					:password="true"
					height="110rpx"
					round="25rpx"
					borderColor="#d7e3ef"
					placeholderStyle="color:#a8b8ca;font-size:28rpx;"
					fontSize="28rpx"
					color="#333333"
				/>

				<i-button class="submit-button password-submit-button" type="primary" block  round="25rpx" color="#3485df" customStyle="height:104rpx;" :loading="resetSubmitting" :disabled="!isPasswordResetReady" @click="completePasswordReset">
					确认重置
				</i-button>
			</view>

			<view v-else class="success-section">
				<view class="success-icon"><text class="success-check">✓</text></view>
				<text class="success-title">密码重置成功</text>
				<text class="success-description">请使用新密码重新登录。为保护账户安全，当前及其他设备的登录状态均已失效。</text>
				<i-button class="submit-button success-button" type="primary" block  round="25rpx" color="#3485df" customStyle="height:104rpx;" @click="returnToLogin">
					返回登录
				</i-button>
			</view>
		</view>
	</view>
	<app-toast></app-toast>
</template>

<script setup lang="uts">
	import { ref, computed, onUnmounted } from 'vue'
	import { resetForgotPassword, sendSmsForgotPasswordCode } from '../../api/request.uts'
	import { showAppToast } from '../../utils/toast.uts'

	type ForgotPasswordForm = {
		mobile: string
		smsCode: string
		password: string
		confirmPassword: string
	}

	const currentStep = ref(1)
	const stepItems = ['验证身份', '设置密码', '完成']
	const form = ref<ForgotPasswordForm>({
		mobile: '',
		smsCode: '',
		password: '',
		confirmPassword: ''
	})
	const smsCooldown = ref(0)
	const smsSending = ref(false)
	const resetSubmitting = ref(false)
	let smsCooldownTimer: number | null = null

	const isIdentityVerificationReady = computed<boolean>(() => {
		return /^1[3-9]\d{9}$/.test(form.value.mobile) && /^\d{6}$/.test(form.value.smsCode)
	})

	const isPasswordResetReady = computed<boolean>(() => {
		const password = form.value.password
		let categoryCount = 0
		if (/[0-9]/.test(password)) categoryCount += 1
		if (/[A-Za-z]/.test(password)) categoryCount += 1
		if (/[^A-Za-z0-9]/.test(password)) categoryCount += 1

		return password.length >= 8
			&& password.length <= 16
			&& categoryCount >= 2
			&& form.value.confirmPassword != ''
			&& password == form.value.confirmPassword
			&& !resetSubmitting.value
	})

	const isValidMobile = (): boolean => {
		if (!/^1[3-9]\d{9}$/.test(form.value.mobile)) {
			showAppToast({ title: '请输入正确的手机号', icon: 'none' })
			return false
		}
		return true
	}

	const isValidSmsCode = (): boolean => {
		if (!/^\d{6}$/.test(form.value.smsCode)) {
			showAppToast({ title: '请输入6位短信验证码', icon: 'none' })
			return false
		}
		return true
	}

	const isValidPassword = (): boolean => {
		const password = form.value.password
		if (password.length < 8 || password.length > 16) {
			showAppToast({ title: '密码长度应为8至16位', icon: 'none' })
			return false
		}
		let categoryCount = 0
		if (/[0-9]/.test(password)) categoryCount += 1
		if (/[A-Za-z]/.test(password)) categoryCount += 1
		if (/[^A-Za-z0-9]/.test(password)) categoryCount += 1
		if (categoryCount < 2) {
			showAppToast({ title: '密码需包含至少两种字符类型', icon: 'none' })
			return false
		}
		return true
	}

	const stopSmsCooldown = (): void => {
		const timer = smsCooldownTimer
		if (timer != null) {
			clearInterval(timer)
			smsCooldownTimer = null
		}
	}

	const startSmsCooldown = (): void => {
		stopSmsCooldown()
		smsCooldown.value = 60
		smsCooldownTimer = setInterval(() => {
			smsCooldown.value -= 1
			if (smsCooldown.value <= 0) {
				smsCooldown.value = 0
				stopSmsCooldown()
			}
		}, 1000) as number
	}

	const requestSmsCode = async (): Promise<void> => {
		if (smsCooldown.value > 0 || smsSending.value || !isValidMobile()) return
		try {
			smsSending.value = true
			const response = await sendSmsForgotPasswordCode({ phonenumber: form.value.mobile })
			if (response.code != 200) {
				showAppToast({ title: response.msg || '验证码发送失败', icon: 'none' })
				return
			}
			startSmsCooldown()
			showAppToast({ title: '验证码已发送', icon: 'success' })
		} catch (error) {
			showAppToast({ title: '验证码发送失败，请检查网络', icon: 'none' })
		} finally {
			smsSending.value = false
		}
	}

	const goToPasswordStep = (): void => {
		if (!isValidMobile() || !isValidSmsCode()) return
		currentStep.value = 2
	}

	const completePasswordReset = async (): Promise<void> => {
		if (resetSubmitting.value) return
		if (form.value.password == '') {
			showAppToast({ title: '请输入新密码', icon: 'none' })
			return
		}
		if (!isValidPassword()) return
		if (form.value.confirmPassword == '') {
			showAppToast({ title: '请再次输入新密码', icon: 'none' })
			return
		}
		if (form.value.password != form.value.confirmPassword) {
			showAppToast({ title: '两次输入的密码不一致', icon: 'none' })
			return
		}
		try {
			resetSubmitting.value = true
			const response = await resetForgotPassword({
				phonenumber: form.value.mobile,
				smsCode: form.value.smsCode,
				newPassword: form.value.password,
				confirmPassword: form.value.confirmPassword
			})
			if (response.code != 200) {
				showAppToast({ title: response.msg || '密码重置失败，请稍后重试', icon: 'none' })
				return
			}
			currentStep.value = 3
		} catch (error) {
			showAppToast({ title: '密码重置失败，请检查网络后重试', icon: 'none' })
		} finally {
			resetSubmitting.value = false
		}
	}

	const returnToLogin = (): void => {
		stopSmsCooldown()
		form.value = { mobile: '', smsCode: '', password: '', confirmPassword: '' }
		uni.reLaunch({ url: '/pages/login/login' })
	}

	onUnmounted(() => {
		stopSmsCooldown()
	})
</script>

