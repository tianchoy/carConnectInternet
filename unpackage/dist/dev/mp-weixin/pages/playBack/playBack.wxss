.container[class] {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #f5f7fa;
}
.container .map-container[class] {
  flex: 1;
  width: 100%;
  position: relative;
}
.container .map-container .sub-nav-overlay[class] {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}
.container .tools-panel[class] {
  width: 100%;
  box-sizing: border-box;
  background-color: #fff;
  padding: 50rpx 20rpx;
  box-shadow: 0 -10rpx 20rpx rgba(0, 0, 0, 0.1);
}
.container .tools-panel .Datetime-box[class] {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}
.container .tools-panel .Datetime-box .date-box[class] {
  display: flex;
  box-sizing: border-box;
  flex-direction: row;
  align-items: center;
}
.container .tools-panel .Datetime-box .date-box .date-time-control[class] {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 5rpx;
  padding: 6rpx 4rpx;
}
.container .tools-panel .Datetime-box .date-box .date-part[class],
.container .tools-panel .Datetime-box .date-box .time-part[class] {
  font-size: 24rpx;
  line-height: 32rpx;
  white-space: nowrap;
}
.container .tools-panel .Datetime-box .date-box .date-arrow[class],
.container .tools-panel .Datetime-box .date-box .date-separator[class] {
  flex-shrink: 0;
}
.container .tools-panel .Datetime-box .date-box .date-separator[class] {
  margin: 0 20rpx;
  font-size: 26rpx;
}
.container .tools-panel .Datetime-box .playbackdetail[class] {
  font-size: 25rpx;
  color: #1890FF;
}
.container .tools-panel .tool-tag-item[class] {
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.container .tools-panel .tool-tag-item .speed-label[class] {
  border: 2rpx solid #1890FF;
  font-size: 25rpx;
  color: #1890FF;
  padding: 5rpx 15rpx;
  border-radius: 30rpx;
  margin-left: 20rpx;
}
.container .tools-panel .tool-tag-item .slider[class] {
  flex: 1;
  padding: 0 20rpx 0 30rpx;
  overflow: visible;
}
.container .tools-panel .tool-tag-item .play-btn[class] {
  font-size: 25rpx;
  color: #fff;
  padding: 10rpx 25rpx;
  border-radius: 10rpx;
  margin-left: 20rpx;
  background-color: #1890FF;
}
.container .tools-panel .play-back-info[class] {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  margin-top: 20rpx;
  background-color: #f9f9f9;
  border-radius: 15rpx;
}
.container .tools-panel .play-back-info .item-info[class] {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.container .tools-panel .play-back-info .info-label[class] {
  font-size: 24rpx;
  padding: 10rpx 0;
  color: #999;
}