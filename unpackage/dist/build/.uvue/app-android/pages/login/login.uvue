                smsCooldown.value -= 1;
                if (smsCooldown.value <= 0) {
                    smsCooldown.value = 0;
                    stopSmsCooldown();
                }
            }, 1000) as number;
        };
        const sendSmsCode = async (): Promise<void> => {
            if (smsCooldown.value > 0 || smsSending.value)
                return;
            if (!ensureAgreementAccepted() || !isValidMobile())
                return;
            try {
                smsSending.value = true;
                const response = await sendSmsLoginCode({ phonenumber: smsMobile.value } as SendSmsCodeRequest);
                if (response.code != 200) {
                    showAppToast({ title: response.msg != "" ? response.msg : '验证码发送失败', icon: 'none' } as ShowToastOptions);
                    return;
                }
                startSmsCooldown();
                showAppToast({ title: '验证码已发送', icon: 'success' } as ShowToastOptions);
            }
            catch (error: any) {
                showAppToast({ title: '验证码发送失败，请检查网络', icon: 'none' } as ShowToastOptions);
            }
            finally {
                smsSending.value = false;
            }
        };
