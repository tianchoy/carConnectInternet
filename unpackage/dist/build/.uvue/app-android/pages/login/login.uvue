                showAppToast({ title: '登录失败，请重试', icon: 'none' } as ShowToastOptions);
                return;
            }
            if (savePassword)
                saveAccountPassword();
            uni.setStorageSync('token', token);
            resetTokenExpiredState();
            showAppToast({ title: '登录成功', icon: 'success' } as ShowToastOptions);
